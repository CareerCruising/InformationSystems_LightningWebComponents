gs Booked)--\nq2 = load \"BDR_Opp_UserName\";\nq2 = filter q2 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq2 = filter q2 by 'User.Name' is not null;\nq2 = filter q2 by ('StageName' != \"Closed Quote\" || 'StageName' is null);\nq2 = filter q2 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq2 = filter q2 by 'User.IsActive' == \"true\"; \n--# of Calls This Week--\nq3 = load \"Call_Type_Activities\";\nq3 = filter q3 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq3 = filter q3 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq3 = filter q3 by 'User.IsActive' == \"true\";\n--# & $ of Opps that will be Accepted This Week--\nq4 = load \"BDR_Qual_Opp_Event\";\nq4 = filter q4 by date('Event.StartDateTime_Year', 'Event.StartDateTime_Month', 'Event.StartDateTime_Day') in [\"current year\"..\"current year\"];\nq4 = filter q4 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq4 = filter q4 by 'User.IsActive' == \"true\";\n--# of Prospects Contacted & Decesion Maker %--\nq5 = load \"Task_Events_Lead_Contact\";\nq5 = filter q5 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq5 = filter q5 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq5 = filter q5 by 'User.IsActive' == \"true\";\n--Cogrouping--\nq = cogroup q1 by ('User.Name') full, q2 by ('User.Name') full, q3 by ('User.Name') full, q4 by ('User.Name') full, q5 by ('User.Name');\n--Column Creation--\nq = foreach q generate coalesce(q1.'User.Name', q2.'User.Name', q3.'User.Name', q4.'User.Name', q5.'User.Name') as 'User.Name', sum(q1.Sales_Accepted_Amount__c)/avg(q1.No_of_Weeks_YTD) as 'BDR Accepted Opp $', count(q2)/avg(q2.No_of_Weeks_YTD) as 'Opps Created (Meetings Booked)', count(q3)/avg(q3.No_of_Weeks_YTD) as 'Calls Made', count(q4)/avg(q4.No_of_Weeks_YTD) as '# of Opps Commited', sum(q4.Amount)/avg(q4.No_of_Weeks_YTD) as ' $ of Opps Commited', count(q5)/avg(q5.No_of_Weeks_YTD) as 'Prospects Contacted', sum(q5.'Decision_Maker_Count')/count(q5) as 'DM % Contacted';\nq = order q by 'User.Name' asc;\nq = filter q by 'User.Name' != \"Lilianna Fodor\";\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{" $ of Opps Commited":{"parameters":{"alignment":"left"},"type":"text"},"Prospects Contacted":{"parameters":{"alignment":"left"},"type":"text"},"# of Opps Commited":{"parameters":{"alignment":"left"},"type":"text"},"Opps Created (Meetings Booked)":{"parameters":{"alignment":"left"},"type":"text"},"BDR Accepted Opp $":{"parameters":{"alignment":"left"},"type":"text"},"Calls Made":{"parameters":{"alignment":"left"},"type":"text"},"DM % Contacted":{"parameters":{"alignment":"left"},"type":"text"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"rgb(168, 183, 199)","mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_8_2":{"broadcastFacet":true,"groups":[],"label":"lens_8","numbers":[],"query":"--BDR Accepted Opps $ This Week--\nq1 = load \"Opps_BDR_Activity\";\nq1 = filter q1 by date('Sales_Accepted_Date__c_Year', 'Sales_Accepted_Date__c_Month', 'Sales_Accepted_Date__c_Day') in [\"current year\"..\"current year\"];\nq1 = filter q1 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq1 = filter q1 by 'User.IsActive' == \"true\";\n--# of Opps Created This Week ( # of Meetings Booked)--\nq2 = load \"BDR_Opp_UserName\";\nq2 = filter q2 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq2 = filter q2 by 'User.Name' is not null;\nq2 = filter q2 by ('StageName' != \"Closed Quote\" || 'StageName' is null);\nq2 = filter q2 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq2 = filter q2 by 'User.IsActive' == \"true\"; \n--# of Calls This Week--\nq3 = load \"Call_Type_Activities\";\nq3 = filter q3 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq3 = filter q3 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq3 = filter q3 by 'User.IsActive' == \"true\";\n--# & $ of Opps that will be Accepted This Week--\nq4 = load \"BDR_Qual_Opp_Event\";\nq4 = filter q4 by date('Event.StartDateTime_Year', 'Event.StartDateTime_Month', 'Event.StartDateTime_Day') in [\"current year\"..\"current year\"];\nq4 = filter q4 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq4 = filter q4 by 'User.IsActive' == \"true\";\n--# of Prospects Contacted & Decesion Maker %--\nq5 = load \"Task_Events_Lead_Contact\";\nq5 = filter q5 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq5 = filter q5 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq5 = filter q5 by 'User.IsActive' == \"true\";\n--Task Overdue--\nq6 = load \"Task_Events_Lead_Contact\";\nq6 = filter q6 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq6 = filter q6 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq6 = filter q6 by 'User.IsActive' == \"true\";\nq6 = filter q6 by 'IsOverdue' == \"Yes\";\n--Cogrouping--\nq = cogroup q1 by ('User.Name') full, q2 by ('User.Name') full, q3 by ('User.Name') full, q4 by ('User.Name') full, q5 by ('User.Name'), q6 by ('User.Name');\n--Column Creation--\nq = foreach q generate coalesce(q1.'User.Name', q2.'User.Name', q3.'User.Name', q4.'User.Name', q5.'User.Name') as 'User.Name', sum(q1.Sales_Accepted_Amount__c) as 'BDR Accepted Opp $', count(q2) as 'Opps Created (Meetings Booked)', count(q3) as 'Calls Made', count(q4) as '# of Opps Commited', sum(q4.Amount) as ' $ of Opps Commited', count(q5) as 'Prospects Contacted', sum(q5.'Decision_Maker_Count')/count(q5) as 'DM % Contacted', count(q6) as 'Overdue Tasks';\nq = order q by 'User.Name' asc;\nq = filter q by 'User.Name' != \"Lilianna Fodor\";\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{"Prospects Contacted":{"parameters":{"alignment":"left"},"type":"text"},"Opps Created (Meetings Booked)":{"parameters":{"alignment":"left"},"type":"text"},"BDR Accepted Opp $":{"parameters":{"alignment":"left"},"type":"text"},"Calls Made":{"parameters":{"alignment":"left"},"type":"text"},"Overdue Tasks":{"parameters":{"alignment":"left"},"type":"text"},"DM % Contacted":{"parameters":{"alignment":"left"},"type":"text"}},"columns":["User.Name","BDR Accepted Opp $","Opps Created (Meetings Booked)","Calls Made","Prospects Contacted","DM % Contacted","Overdue Tasks"],"customBulkActions":[],"fixedColumnWidth":100,"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","mode":"fixed","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_8_4":{"broadcastFacet":true,"groups":[],"label":"lens_8","numbers":[],"query":"--BDR Accepted Opps $ This Week--\nq1 = load \"Opps_BDR_Activity\";\n--q1 = filter q1 by date('Sales_Accepted_Date__c_Year', 'Sales_Accepted_Date__c_Month', 'Sales_Accepted_Date__c_Day') in [\"current year\"..\"current year\"];--\nq1 = filter q1 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq1 = filter q1 by 'User.IsActive' == \"true\";\n--# of Opps Created This Week ( # of Meetings Booked)--\nq2 = load \"BDR_Opp_UserName\";\n--q2 = filter q2 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];--\nq2 = filter q2 by 'User.Name' is not null;\nq2 = filter q2 by ('StageName' != \"Closed Quote\" || 'StageName' is null);\nq2 = filter q2 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"]; \nq2 = filter q2 by 'User.IsActive' == \"true\";\n--# of Calls This Week--\nq3 = load \"Call_Type_Activities\";\n--q3 = filter q3 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];--\nq3 = filter q3 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq3 = filter q3 by 'User.IsActive' == \"true\";\n--# & $ of Opps that will be Accepted This Week--\nq4 = load \"BDR_Qual_Opp_Event\";\n--q4 = filter q4 by date('Event.StartDateTime_Year', 'Event.StartDateTime_Month', 'Event.StartDateTime_Day') in [\"current year\"..\"current year\"];--\nq4 = filter q4 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq4 = filter q4 by 'User.IsActive' == \"true\";\n--# of Prospects Contacted & Decesion Maker %--\nq5 = load \"Task_Events_Lead_Contact\";\n--q5 = filter q5 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];--\nq5 = filter q5 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq5 = filter q5 by 'User.IsActive' == \"true\";\n--Task Overdue--\nq6 = load \"Task_Events_Lead_Contact\";\n--q6 = filter q6 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq6 = filter q6 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq6 = filter q6 by 'User.IsActive' == \"true\";\nq6 = filter q6 by 'IsOverdue' == \"Yes\";\n--Cogrouping--\nq = cogroup q1 by ('User.Name') full, q2 by ('User.Name') full, q3 by ('User.Name') full, q4 by ('User.Name') full, q5 by ('User.Name'),q6 by ('User.Name');\n--Column Creation--\nq = foreach q generate coalesce(q1.'User.Name', q2.'User.Name', q3.'User.Name', q4.'User.Name', q5.'User.Name') as 'User.Name', sum(q1.Sales_Accepted_Amount__c) as 'BDR Accepted Opp $', count(q2) as 'Opps Created (Meetings Booked)', count(q3) as 'Calls Made', count(q4) as '# of Opps Commited', sum(q4.Amount) as ' $ of Opps Commited', count(q5) as 'Prospects Contacted', sum(q5.'Decision_Maker_Count')/count(q5) as 'DM % Contacted',count(q6) as 'Overdue Tasks';\nq = order q by 'User.Name' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(168, 183, 199)","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{" $ of Opps Commited":{"parameters":{"alignment":"left"},"type":"text"},"Prospects Contacted":{"parameters":{"alignment":"left"},"type":"text"},"# of Opps Commited":{"parameters":{"alignment":"left"},"type":"text"},"Opps Created (Meetings Booked)":{"parameters":{"alignment":"left"},"type":"text"},"BDR Accepted Opp $":{"parameters":{"alignment":"left"},"type":"text"},"Calls Made":{"parameters":{"alignment":"left"},"type":"text"},"Overdue Tasks":{"parameters":{"alignment":"left"},"type":"text"},"DM % Contacted":{"parameters":{"alignment":"left"},"type":"text"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#335779","innerMinorBorderColor":"#335779","mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_1_2":{"broadcastFacet":true,"da