customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_7":{"broadcastFacet":true,"groups":[],"label":"lens_7","numbers":[],"query":"q1 = load \"MetricTargets_BDR\";\nq1 = filter q1 by 'Type' == \"BDR Accepted\";\nq1 = filter q1 by 'User.Name' != \"Signoree Scully\";\nq1 = filter q1 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current quarter\"..\"current quarter\"];\nq1 = filter q1 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\",\"00E41000001BUpREAW\"];\n\n\nq1 = filter q1 by 'User.IsActive' == \"true\";\n/*...*/\nq2 = load \"MetricResults_BDR\";\nq2 = filter q2 by 'Type' == \"BDR Accepted\";\nq2 = filter q2 by 'User.Name' != \"Signoree Scully\";\nq2 = filter q2 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current quarter\"..\"current quarter\"];\nq2 = filter q2 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\",\"00E41000001BUpREAW\"];\n\nq2 = filter q2 by 'User.IsActive' == \"true\";\n/*...*/\nq3 = load \"Task_Events_Lead_Contact\";\nq3 = filter q3 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current quarter\"..\"current quarter\"];\nq3 = filter q3 by 'User.Name' != \"Signoree\";\n\nq3 = filter q3 by 'IsOverdue' == \"Yes\";\nq3 = filter q3 by 'User.IsActive' == \"true\";\nq3 = filter q3 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\",\"00E41000001BUpREAW\"];\n/*...*/\nq4 = load \"BDR_Qual_Opp_Event\";\nq4 = filter q4 by date('Event.StartDateTime_Year', 'Event.StartDateTime_Month', 'Event.StartDateTime_Day') in [\"current quarter\"..\"current quarter\"];\nq4 = filter q4 by ('User.FirstName' != \"Lilianna\" || 'User.FirstName' != \"Signoree\" ||'User.FirstName' is null);\nq4 = filter q4 by 'User.IsActive' == \"true\";\nq4 = filter q4 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\",\"00E41000001BUpREAW\"];\n/*...*/\nq = cogroup q1 by ('OwnerName','ReportingPeriod_Quarter') full,q2 by ('OwnerName','ReportingPeriod_Quarter') ,q3 by ('User.Name','CreatedDate_Quarter') full,q4 by ('User.Name','Event.StartDateTime_Quarter');\n/*...*/\nq = foreach q generate coalesce(q1.'OwnerName', q2.'OwnerName',q4.'User.Name') as 'OwnerName', sum(q1.'Target') as 'Quota' , sum(q2.'Actual') as 'Actual',(sum(q1.'Target')-sum(q2.'Actual')) as 'Delta',sum(q4.'Amount') as 'Opps Commited $',count(q2) as 'Number of Deals',  (sum(q2.'Actual') / count(q2)) as 'Avg Deal Size',  ((sum(q1.'Target') - sum(q2.'Actual')) / (sum(q2.'Actual') / count(q2))) as 'Deals Needed', ((sum(q1.'Target')-(coalesce(sum(q2.'Actual'),0)))/avg(q1.'WeekstoQuarterEnd_formula')) as 'Weekly ARR Needed', count(q3) as 'Overdue Tasks';\n/*...*/\nq = order q by 'OwnerName' asc;\n\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"rgb(168, 183, 199)","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{"Weekly ARR Needed":{"parameters":{"alignment":"left"},"type":"text"},"Number of Deals":{"parameters":{"alignment":"left"},"type":"text"},"Quota":{"parameters":{"alignment":"left"},"type":"text"},"Delta":{"parameters":{"alignment":"left"},"type":"text"},"Avg Deal Size":{"parameters":{"alignment":"left"},"type":"text"},"Opps Commited $":{"parameters":{"alignment":"left"},"type":"text"},"Deals Needed":{"parameters":{"alignment":"left"},"type":"text"},"Actual":{"parameters":{"alignment":"left"},"type":"text"},"Overdue Tasks":{"parameters":{"alignment":"left"},"type":"text"}},"columns":["OwnerName","Quota","Actual","Delta","Opps Commited $","Number of Deals","Avg Deal Size","Deals Needed","Overdue Tasks"],"customBulkActions":[],"fixedColumnWidth":100,"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#335779","innerMinorBorderColor":"#335779","mode":"fixed","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_8":{"broadcastFacet":true,"groups":[],"label":"lens_8","numbers":[],"query":"--BDR Accepted Opps $ This Week--\nq1 = load \"Opps_BDR_Activity\";\nq1 = filter q1 by date('Sales_Accepted_Date__c_Year', 'Sales_Accepted_Date__c_Month', 'Sales_Accepted_Date__c_Day') in [\"current week\"..\"current week\"];\nq1 = filter q1 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\n--# of Opps Created This Week ( # of Meetings Booked)--\nq2 = load \"BDR_Opp_UserName\";\nq2 = filter q2 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current week\"..\"current week\"];\nq2 = filter q2 by 'User.Name' is not null;\nq2 = filter q2 by ('StageName' != \"Closed Quote\" || 'StageName' is null);\nq2 = filter q2 by 'User.UserRoleId' == \"00E41000001VBgsEAG\"; \n--# of Calls This Week--\nq3 = load \"Call_Type_Activities\";\nq3 = filter q3 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current week\"..\"current week\"];\nq3 = filter q3 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\n--# & $ of Opps that will be Accepted This Week--\nq4 = load \"BDR_Qual_Opp_Event\";\nq4 = filter q4 by date('Event.StartDateTime_Year', 'Event.StartDateTime_Month', 'Event.StartDateTime_Day') in [\"current week\"..\"current week\"];\nq4 = filter q4 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\n--# of Prospects Contacted & Decesion Maker %--\nq5 = load \"Task_Events_Lead_Contact\";\nq5 = filter q5 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current week\"..\"current week\"];\nq5 = filter q5 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\n--Cogrouping--\nq = cogroup q1 by ('User.Name') full, q2 by ('User.Name') full, q3 by ('User.Name') full, q4 by ('User.Name') full, q5 by ('User.Name');\n--Column Creation--\nq = foreach q generate coalesce(q1.'User.Name', q2.'User.Name', q3.'User.Name', q4.'User.Name', q5.'User.Name') as 'User.Name', sum(q1.Sales_Accepted_Amount__c) as 'BDR Accepted Opp $', count(q2) as 'Opps Created (Meetings Booked)', count(q3) as 'Calls Made', count(q4) as '# of Opps Commited', sum(q4.Amount) as ' $ of Opps Commited', count(q5) as 'Prospects Contacted', sum(q5.'Decision_Maker_Count')/count(q5) as 'DM % Contacted';\nq = order q by 'User.Name' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(168, 183, 199)","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":["BDR Accepted Opp $","Opps Created (Meetings Booked)","Calls Made","# of Opps Commited"," $ of Opps Commited","Prospects Contacted","DM % Contacted","User.Name"],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#335779","innerMinorBorderColor":"#335779","mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_5":{"broadcastFacet":true,"datasets":[{"name":"Task_Events_Lead_Contact"}],"isGlobal":false,"label":"lens_5","query":{"aggregateFilters":[],"limit":2000,"orders":[["Type_formula",{"ascending":true}]],"sourceFilters":{"Task_Events_Lead_Contact":{"filters":[["User.UserRoleId",["00E41000001VBgsEAG","00EI9000000HeOWMA0"],"in"],["User.IsActive",["true"],"in"],["User.Name",["Lilianna Fodor"],"not in"]]}},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["Type_formula"],"name":"Task_Events_Lead_Contact"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","centerText":"","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":true,"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"pie","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"inner":60,"columnMap":{"trellis":[],"dimension":["Type_formula"],"plots":["A"]},"showActionMenu":true,"centerValueType":"number","measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"percent","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_6":{"broadcastFacet":true,"datasets":[{"name":"Quota_Targets_Delta"}],"isGlobal":false,"label":"lens_6","query":{"aggregateFilters":[],"limit":100,"orders":[],"sourceFilters":{"Quota_Targets_Delta":{"filters":[["OwnerName",["Shanice Williams"],"in"],["ReportingPeriod",[["month",0],["month",0]],"between"]]}},"sources":[{"columns":[{"field":"OwnerName","name":"OwnerName"},{"field":"MetricResu.OwnerName","name":"MetricResu.OwnerName"},{"field":"OwnerId","name":"OwnerId"},{"field":"MetricResu.Type","name":"MetricResu.Type"},{"field":"OwnerProfileName","name":"OwnerProfileName"},{"field":"Target","name":"Target"},{"field":"MetricResu.MetricResultId","name":"MetricResu.MetricResultId"},{"field":"MetricTargetId","name":"MetricTargetId"},{"field":"MetricResu.Actual","name":"MetricResu.Actual"}],"filters":[],"groups":[],"name":"Quota_Targets_Delta"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":["OwnerName","MetricResu.OwnerName","OwnerId","MetricResu.Type","OwnerProfileName","Target","MetricResu.MetricResultId","MetricTargetId","MetricResu.Actual"],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_12":{"broadcastFacet":true,"groups":[],"label":"lens_12","numbers":[],"query":"q1 = load \"Call_Type_Activities\";\nq1 = filter q1 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq1 = filter q1 by 'User.IsActive' == \"true\";\n\nq2 = load \"Call_Type_Activities\";\nq2 = filter q2 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq2 = filter q2 by 'User.IsActive' == \"true\";\nq2 = filter q2 by 'Call_Disposition__c' in [\"Answered - Continue Conversation\", \"Answered - Gatekeeper - \\\"Email Only\\\"\", \"Answered - Interested - Not quite ready now - Keep in Touch\", \"Answered - Meeting Set\", \"Answered - No Longer with Company\", \"Answered - Not Interested\", \"Answered - Referral\", \"Answered - Wrong Contact\", \"Gatekeeper\"];\n\nq3 = load \"BDR_Opp_UserName\";\n--q3 = filter q3 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq3 = filter q3 by 'User.Name' is not null;\nq3 = filter q3 by ('StageName' != \"Closed Quote\" || 'StageName' is null);\nq3 = filter q3 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq3 = filter q3 by 'User.IsActive' == \"true\"; \n\nq4 = load \"Opps_BDR_Activity\";\n--q4 = filter q4 by date('Sales_Accepted_Date__c_Year', 'Sales_Accepted_Date__c_Month', 'Sales_Accepted_Date__c_Day') in [\"current year\"..\"current year\"];\nq4 = filter q4 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq4 = filter q4 by 'User.IsActive' == \"true\";\nq4 = filter q4 by 'StageName' != \"BDR Opp Rejected\";\n\nq = cogroup q1 by ('User.Name') full, q2 by ('User.Name') full, q3 by ('User.Name') full, q4 by ('User.Name');\n\nq = foreach q generate coalesce(q1.'User.Name', q2.'User.Name', q3.'User.Name', q4.'User.Name') as 'User.Name',\n1 as 'SortOrder',\n count(q1) as 'Calls Made', count(q2) as 'Calls Connected',count(q2) /count(q1) as 'Call Connection Rate %', count(q3) as 'Opps Created (Meetings Booked)', count(q4) as 'BDR Accepted Opps', count(q3)/count(q2) as 'Call Conversion Rate %', count(q4)/count(q3) as 'Meetings booked to BDR Accepted %';\n\n// Create total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'User.Name',\n    0 as 'SortOrder',\n    sum(q.'Calls Made') as 'Calls Made',\n    sum(q.'Calls Connected') as 'Calls Connected',\n    avg(q.'Call Connection Rate %') as 'Call Connection Rate %',\n    sum(q.'Opps Created (Meetings Booked)') as 'Opps Created (Meetings Booked)',\n    sum(q.'BDR Accepted Opps') as 'BDR Accepted Opps',\n    avg(q.'Call Conversion Rate %') as 'Call Conversion Rate %',\n    avg(q.'Meetings booked to BDR Accepted %') as 'Meetings booked to BDR Accepted %';\n\n// Combine total with the rest\nq = union totalRow, q;\n\n\nq = order q by 'SortOrder' asc;\nq = filter q by 'User.Name' != \"Lilianna Fodor\";\n\nq = foreach q generate \n    'User.Name',\n    'Calls Made',\n    'Calls Connected',\n    'Call Connection Rate %',\n    'Opps Created (Meetings Booked)',\n    'BDR Accepted Opps',\n    'Call Conversion Rate %',\n    'Meetings booked to BDR Accepted %';\n\n\nq = limit q 2000;\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_3":{"broadcastFacet":true,"groups":[],"label":"lens_3","numbers":[],"query":"q = load \"BDR_Qual_Opp_Event\";\nq = filter q by 'User.IsActive' == \"true\";\nq = filter q by ('User.FirstName' != \"Lilianna\" || 'User.FirstName' is null);\nq = filter q by 'User.UserRoleId' in [\"00E41000001BUpREAW\", \"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq = foreach q generate q.'User.Name' as 'User.Name', q.'Name' as 'Name', q.'StageName' as 'StageName', q.'Amount' as 'Amount', q.'Owner_Name__c' as 'Owner_Name__c', q.'Event.StartDateTime' as 'Event.StartDateTime', q.'Join2.Campaign.Name' as 'Join2.Campaign.Name';\nq = order q by 'User.Name' asc;\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{"Amount":{"parameters":{"alignment":"left"},"type":"text"}},"columns":[],"customBulkActions":[],"fixedColumnWidth":100,"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSi