74","borderEdges":["all"],"borderRadius":4,"borderWidth":2}},{"colspan":5,"column":39,"name":"filterpanel_5","row":2,"rowspan":4,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":["all"],"borderRadius":4,"borderWidth":2}},{"colspan":8,"column":31,"name":"text_5","row":2,"rowspan":4,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#C6D3E1","borderEdges":[],"borderRadius":4,"borderWidth":2}},{"colspan":9,"column":37,"name":"filterpanel_6","row":90,"rowspan":4,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":["all"],"borderRadius":4,"borderWidth":1}},{"colspan":28,"column":2,"name":"table_10","row":189,"rowspan":22,"widgetStyle":{"backgroundColor":"#16325C","borderEdges":[]}},{"colspan":26,"column":13,"name":"text_10","row":179,"rowspan":4,"widgetStyle":{"backgroundColor":"#E6ECF2","borderColor":"#747474","borderEdges":["all"],"borderRadius":4,"borderWidth":1}},{"colspan":11,"column":37,"name":"chart_1","row":184,"rowspan":27,"widgetStyle":{"backgroundColor":"#16325C","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":10,"column":22,"name":"text_6","row":141,"rowspan":4,"widgetStyle":{"backgroundColor":"#E6ECF2","borderColor":"#747474","borderEdges":["all"],"borderRadius":4,"borderWidth":1}},{"colspan":32,"column":11,"name":"table_11","row":147,"rowspan":30,"widgetStyle":{"backgroundColor":"#16325C","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#E6ECF2","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"lens_12_1":{"broadcastFacet":true,"groups":[],"label":"lens_12","numbers":[],"query":"q1 = load \"Call_Type_Activities\";\nq1 = filter q1 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq1 = filter q1 by 'User.IsActive' == \"true\";\n\nq2 = load \"Call_Type_Activities\";\nq2 = filter q2 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq2 = filter q2 by 'User.IsActive' == \"true\";\nq2 = filter q2 by 'Call_Disposition__c' in [\"Answered - Continue Conversation\", \"Answered - Gatekeeper - \\\"Email Only\\\"\", \"Answered - Interested - Not quite ready now - Keep in Touch\", \"Answered - Meeting Set\", \"Answered - No Longer with Company\", \"Answered - Not Interested\", \"Answered - Referral\", \"Answered - Wrong Contact\", \"Gatekeeper\"];\n\nq3 = load \"BDR_Opp_UserName\";\n--q3 = filter q3 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq3 = filter q3 by 'User.Name' is not null;\nq3 = filter q3 by ('StageName' != \"Closed Quote\" || 'StageName' is null);\nq3 = filter q3 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq3 = filter q3 by 'User.IsActive' == \"true\"; \n\nq4 = load \"Opps_BDR_Activity\";\n--q4 = filter q4 by date('Sales_Accepted_Date__c_Year', 'Sales_Accepted_Date__c_Month', 'Sales_Accepted_Date__c_Day') in [\"current year\"..\"current year\"];\nq4 = filter q4 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq4 = filter q4 by 'User.IsActive' == \"true\";\nq4 = filter q4 by 'StageName' != \"BDR Opp Rejected\";\n\nq = cogroup q1 by ('User.Name') full, q2 by ('User.Name') full, q3 by ('User.Name') full, q4 by ('User.Name');\n\nq = foreach q generate coalesce(q1.'User.Name', q2.'User.Name', q3.'User.Name', q4.'User.Name') as 'User.Name',\n1 as 'SortOrder',\n count(q1) as 'Calls Made', count(q2) as 'Calls Connected',count(q2) /count(q1) as 'Call Connection Rate %', count(q3) as 'Opps Created (Meetings Booked)', count(q4) as 'BDR Accepted Opps', count(q3)/count(q2) as 'Call Conversion Rate %', count(q4)/count(q3) as 'Meetings booked to BDR Accepted %';\n\n// Create total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'User.Name',\n    0 as 'SortOrder',\n    sum(q.'Calls Made') as 'Calls Made',\n    sum(q.'Calls Connected') as 'Calls Connected',\n    avg(q.'Call Connection Rate %') as 'Call Connection Rate %',\n    sum(q.'Opps Created (Meetings Booked)') as 'Opps Created (Meetings Booked)',\n    sum(q.'BDR Accepted Opps') as 'BDR Accepted Opps',\n    avg(q.'Call Conversion Rate %') as 'Call Conversion Rate %',\n    avg(q.'Meetings booked to BDR Accepted %') as 'Meetings booked to BDR Accepted %';\n\n// Combine total with the rest\nq = union totalRow, q;\n\n\nq = order q by 'SortOrder' asc;\nq = filter q by 'User.Name' != \"Lilianna Fodor\";\n\nq = foreach q generate \n    'User.Name',\n    'Calls Made',\n    'Calls Connected',\n    'Call Connection Rate %',\n    'Opps Created (Meetings Booked)',\n    'BDR Accepted Opps',\n    'Call Conversion Rate %',\n    'Meetings booked to BDR Accepted %';\n\n\nq = limit q 1;\n\n// Unpivot: convert columns into rows with consistent schema\nrow1 = foreach q generate \"Calls Made\" as 'Stage', 'Calls Made' as 'Value';\nrow2 = foreach q generate \"Calls Connected\" as 'Stage', 'Calls Connected' as 'Value';\nrow3 = foreach q generate \"Call Connection Rate %\" as 'Stage', 'Call Connection Rate %' as 'Value';\nrow4 = foreach q generate \"Opps Created (Meetings Booked)\" as 'Stage', 'Opps Created (Meetings Booked)' as 'Value';\nrow5 = foreach q generate \"BDR Accepted Opps\" as 'Stage', 'BDR Accepted Opps' as 'Value';\nrow6 = foreach q generate \"Call Conversion Rate %\" as 'Stage', 'Call Conversion Rate %' as 'Value';\nrow7 = foreach q generate \"Meetings booked to BDR Accepted %\" as 'Stage', 'Meetings booked to BDR Accepted %' as 'Value';\n// Union into single funnel dataset\nfunnel = union row1, row2, row4, row5;\nfunnel = limit funnel 10;\n\n\n\n\n\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":true,"tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"funnel","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"valueType":"compactNumber","showTotal":true,"theme":"wave","stemSegments":0,"applyConditionalFormatting":true},"type":"chart"}},"lens_7_2":{"broadcastFacet":true,"groups":[],"label":"lens_7","numbers":[],"query":"q1 = load \"MetricTargets_BDR\";\nq1 = filter q1 by 'Type' == \"BDR Accepted\";\nq1 = filter q1 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current quarter\"..\"current quarter\"];\nq1 = filter q1 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq1 = filter q1 by 'User.IsActive' == \"true\";\n/*...*/\nq2 = load \"MetricResults_BDR\";\nq2 = filter q2 by 'Type' == \"BDR Accepted\";\nq2 = filter q2 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current quarter\"..\"current quarter\"];\nq2 = filter q2 by 'User.UserRoleId' in [\"00E41000001VBgsEAG\",\"00EI9000000HeOWMA0\"];\nq2 = filter q2 by 'User.IsActive' == \"true\";\n/*...*/\nq = cogroup q1 by ('OwnerName','ReportingPeriod_Quarter') full, q2 by ('OwnerName','ReportingPeriod_Quarter');\n/*...*/\nq = foreach q generate coalesce(q1.'OwnerName', q2.'OwnerName') as 'OwnerName', sum(q1.'Target') as 'Quota' , sum(q2.'Actual') as 'Actual',(sum(q1.'Target')-sum(q2.'Actual')) as 'Delta',count(q2) as 'Number of Deals',  (sum(q2.'Actual') / count(q2)) as 'Avg Deal Size',  ((sum(q1.'Target') - sum(q2.'Actual')) / (sum(q2.'Actual') / count(q2))) as 'Deals Needed', ((sum(q1.'Target')-(coalesce(sum(q2.'Actual'),0)))/avg(q1.'WeekstoQuarterEnd_formula')) as 'Weekly ARR Needed';\n/*...*/\nq = order q by 'OwnerName' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(168, 183, 199)","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{"Weekly ARR Needed":{"parameters":{"alignment":"center"},"type":"text"},"OwnerName":{"parameters":{"alignment":"center"},"type":"text"}},"columns":["OwnerName","Weekly ARR Needed"],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#335779","innerMinorBorderColor":"#335779","mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_8_1":{"broadcastFacet":true,"groups":[],"label":"lens_8","numbers":[],"query":"--BDR Accepted Opps $ This Week--\nq1 = load \"Opps_BDR_Activity\";\nq1 = filter q1 by date('Sales_Accepted_Date__c_Year', 'Sales_Accepted_Date__c_Month', 'Sales_Accepted_Date__c_Day') in [\"current week\"..\"current week\"];\nq1 = filter q1 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\n--# of Opps Created This Week ( # of Meetings Booked)--\nq2 = load \"BDR_Opp_UserName\";\nq2 = filter q2 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current week\"..\"current week\"];\nq2 = filter q2 by 'User.Name' is not null;\nq2 = filter q2 by ('StageName' != \"Closed Quote\" || 'StageName' is null);\nq2 = filter q2 by 'User.UserRoleId' == \"00E41000001VBgsEAG\"; \n--# of Calls This Week--\nq3 = load \"Call_Type_Activities\";\nq3 = filter q3 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current week\"..\"current week\"];\nq3 = filter q3 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\n--# & $ of Opps that will be Accepted This Week--\nq4 = load \"BDR_Qual_Opp_Event\";\nq4 = filter q4 by date('Event.StartDateTime_Year', 'Event.StartDateTime_Month', 'Event.StartDateTime_Day') in [\"current week\"..\"current week\"];\nq4 = filter q4 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\n--# of Prospects Contacted & Decesion Maker %--\nq5 = load \"Task_Events_Lead_Contact\";\nq5 = filter q5 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current week\"..\"current week\"];\nq5 = filter q5 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\n--Cogrouping--\nq = cogroup q1 by ('User.Name') full, q2 by ('User.Name') full, q3 by ('User.Name') full, q4 by ('User.Name') full, q5 by ('User.Name');\n--Column Creation--\nq = foreach q generate coalesce(q1.'User.Name', q2.'User.Name', q3.'User.Name', q4.'User.Name', q5.'User.Name') as 'User.Name', sum(q1.Sales_Accepted_Amount__c) as 'BDR Accepted Opp $', count(q2) as 'Opps Created (Meetings Booked)', count(q3) as 'Calls Made', count(q4) as '# of Opps Commited', sum(q4.Amount) as ' $ of Opps Commited', count(q5) as 'Prospects Contacted', sum(q5.'Decision_Maker_Count')/count(q5) as 'DM % Contacted';\nq = order q by 'User.Name' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_7_1":{"broadcastFacet":true,"groups":[],"label":"lens_7","numbers":[],"query":"q1 = load \"MetricTargets_BDR\";\nq1 = filter q1 by 'Type' == \"BDR Accepted\";\nq1 = filter q1 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current fiscal_quarter\"..\"current fiscal_quarter\"];\nq1 = filter q1 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq1 = filter q1 by 'User.IsActive' == \"true\";\n/*...*/\nq2 = load \"MetricResults_BDR\";\nq2 = filter q2 by 'Type' == \"BDR Accepted\";\nq2 = filter q2 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current fiscal_quarter\"..\"current fiscal_quarter\"];\nq2 = filter q2 by 'User.UserRoleId' == \"00E41000001VBgsEAG\";\nq2 = filter q2 by 'User.IsActive' == \"true\";\n/*...*/\nq = cogroup q1 by ('OwnerName','ReportingPeriod_Quarter') full, q2 by ('OwnerName','ReportingPeriod_Quarter');\n/*...*/\nq = foreach q generate coalesce(q1.'OwnerName', q2.'OwnerName') as 'OwnerName', sum(q1.'Target') as 'Quota' , sum(q2.'Actual') as 'Actual',(sum(q1.'Target')-sum(q2.'Actual')) as 'Delta',count(q2) as 'Number of Deals',  (sum(q2.'Actual') / count(q2)) as 'Avg Deal Size',  ((sum(q1.'Target') - sum(q2.'Actual')) / (sum(q2.'Actual') / count(q2))) as 'Deals Needed', ((sum(q1.'Target')-sum(q2.'Actual'))/avg(q1.'WeekstoQuarterEnd_formula')) as 'Weekly ARR Needed';\n/*...*/\nq = order q by 'OwnerName' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"rgb(168, 183, 199)","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":["OwnerName","Weekly ARR Needed"],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#335779","innerMinorBorderColor":"#335779","mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_6_2":{"broadcastFacet":true,"datasets":[{"name":"Quota_Targets_Delta"}],"isGlobal":false,"label":"lens_6","query":{"aggregateFilters":[],"limit":100,"orders":