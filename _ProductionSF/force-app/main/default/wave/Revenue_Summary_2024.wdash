_total', sum('ProbableAmount') * {{cell(qryExchange.selection, 0, \"Rate\").asString()}} as 'ProbableAmount_total';\nq = foreach q generate 'OppName' as 'OppName', 'OwnerName' as 'OwnerName', 'Amount' as 'Amount', 'ProbableAmount' as 'ProbableAmount', 'ReportingPeriod' as 'ReportingPeriod', 'StageName' as 'StageName', 'Territory' as 'Territory', 'Type' as 'Type', 'ForecastCategoryName' as 'ForecastCategoryName';\nq = order q by 'StageName' asc;\nq = limit q 100;\nq = union q, s;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"qrySandbox_1":{"broadcastFacet":true,"groups":[],"label":"qrySandbox","numbers":[],"query":"--Load all datasets\nMetricTargets2024 = load \"MetricTargets2024\";\nMetricResults2024 = load \"MetricResults2024\";\nMetricOpenPipe2024 = load \"MetricOpenPipe2024\";\n\n--Create a range of dates using the targets\ndtRange = group MetricTargets2024 by ('ActualMonth');\ndtRange = foreach dtRange generate dtRange.'ActualMonth' as 'ActualMonth';\ndtRange = order dtRange by ('ActualMonth' asc);\ndtRange = limit dtRange 50;\n\n--this will include all data even if out of \"range\"\nAllData = cogroup MetricTargets2024 by 'ActualMonth' full, MetricResults2024 by 'ActualMonth' full, MetricOpenPipe2024 by 'ActualMonth';\nAllData = foreach AllData generate \n\tcoalesce(MetricTargets2024.'ActualMonth', MetricResults2024.'ActualMonth', MetricOpenPipe2024.'ActualMonth') as 'ActualMonth'\n\t, sum(MetricTargets2024.'Target') as 'sumQuota'\n\t, sum(MetricResults2024.'Actual') as 'sumActual'\n\t, sum(MetricOpenPipe2024.'Amount') as 'sumOpenPipe'\n\t, sum(MetricOpenPipe2024.'ProbableAmount') as 'sumForecast';\nAllData = order AllData by 'ActualMonth' asc;\nAllData = limit AllData 2000;\n\n--this will limit to values in \"range\"\nq = cogroup dtRange by 'ActualMonth' left, AllData by 'ActualMonth';\nq = foreach q generate \n\tcoalesce(dtRange.'ActualMonth', AllData.'ActualMonth') as 'ActualMonth'\n\t, sum(AllData.'sumOpenPipe') as 'OpenPipe'\n\t, sum(AllData.'sumQuota') as 'Quota'\n\t, sum(AllData.'sumActual') as 'Actual'\n\t, sum(AllData.'sumForecast') as 'Forecast';\nq = order q by 'ActualMonth' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconP