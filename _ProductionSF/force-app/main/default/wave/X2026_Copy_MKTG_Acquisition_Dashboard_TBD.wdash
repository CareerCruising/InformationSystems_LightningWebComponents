tivity"}],"isGlobal":false,"label":"lens_9","query":{"aggregateFilters":[],"limit":2000,"orders":[["CreatedDate_Month",{"ascending":true}]],"sourceFilters":{},"sources":[{"columns":[{"field":["count","*"],"name":"C"}],"filters":[["CreatedDate",[["year",-1],["year",-1]],"between"]],"groups":["CreatedDate_Month"],"name":"Campaigns_Members_Activity"},{"columns":[{"field":["count","*"],"name":"D"}],"filters":[["CreatedDate",[["year",0],["year",0]],"between"]],"groups":["CreatedDate_Month"],"name":"Campaigns_Members_Activity"},{"columns":[{"field":["count","*"],"name":"A"}],"filters":[["CreatedDate",[1577836800000,1609372800000],"between"]],"groups":["CreatedDate_Month"],"name":"Campaigns_Members_Activity"},{"columns":[{"field":["count","*"],"name":"B"}],"filters":[["CreatedDate",[1609459200000,1640908800000],"between"]],"groups":["CreatedDate_Month"],"name":"Campaigns_Members_Activity"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"stack":false,"showValues":true,"showPoints":true,"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"time-combo","missingValue":"connect","showValuesOnLine":false,"timeAxis":{"showTitle":false,"showAxis":true,"title":""},"title":{"fontSize":20,"subtitleFontSize":11,"label":"YoY Lead Performance monthly","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"plots":{"A":{"mark":"line"},"B":{"mark":"line"},"C":{"mark":"line"},"D":{"mark":"bar"}},"columnMap":{"timeAxis":["CreatedDate_Month"],"trellis":[],"plots":["C","B","A","D"]},"showActionMenu":false,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","applyConditionalFormatting":true},"type":"chart"}},"lens_37":{"broadcastFacet":true,"groups":[],"label":"lens_37","numbers":[],"query":"q1 = load \"All_MKTG_Campaigns\";\nq2 = load \"Campaigns_Members_Activity\";\nq3 = load \"Oppties_by_Activity_May_18th_2023\";\nq4 = load \"Closed_won_lost_opps\";\nq4 = filter q4 by 'Opportunit.StageName' == \"Closed Won\";\nq = cogroup q1 by 'Name' full,q2 by 'Campaign.Name' full, q3 by 'Campaign.Name'full, q4 by 'Campaign.Name';\nq = foreach q generate coalesce(q1.'Name',q2.'Campaign.Name',q3.'Campaign.Name',q4.'Campaign.Name') as 'Campaign Name',max(q1.'CreatedDate') as 'Campaign Created Date' ,max(q1.'BudgetedCost') as 'Budgeted Cost CAD', max(q1.'ActualCost') as 'Actual Cost CAD', count(q2) as 'Member #',sum(q2.'Is_MKTG_Lead') as 'MKTG - Working #',sum(q2.'Is_MQL_Lead') as 'MQL #',sum(q2.'Is_SAL_Lead') as 'SAL #',sum(q2.'Is_SQL_Lead') as 'SQL #',count(q3) as 'Opportunity #', count(q4) as 'Closed Won Opp #', sum(q4.'Id_formula') as 'Revenue Share CAD' , ((sum(q4.'Id_formula')-max(q1.'ActualCost'))/max(q1.'ActualCost')) as 'ROI', min(q1.'Aggregate0.COUNT_Rows') as 'Calls Made';\nq = order q by 'Campaign Created Date' desc;\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"