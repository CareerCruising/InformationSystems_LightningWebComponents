Opportunit.CloseDate_Month', 'Opportunit.CloseDate_Day') in [\"current year\"..\"current year\"];\nq_B = filter q by date('Opportunit.CloseDate_Year', 'Opportunit.CloseDate_Month', 'Opportunit.CloseDate_Day') in [\"1 year ago\"..\"1 year ago\"];\nq_C = filter q by date('Opportunit.CloseDate_Year', 'Opportunit.CloseDate_Month', 'Opportunit.CloseDate_Day') in [dateRange([2023,1,1], [2023,12,31])];\nq = cogroup q_D by ('Opportunit.CloseDate_Month', 'Campaign.Tactic__c_bucket') full, q_A by ('Opportunit.CloseDate_Month', 'Campaign.Tactic__c_bucket') full, q_B by ('Opportunit.CloseDate_Month', 'Campaign.Tactic__c_bucket') full, q_C by ('Opportunit.CloseDate_Month', 'Campaign.Tactic__c_bucket');\nq = foreach q generate coalesce(q_D.'Opportunit.CloseDate_Month', q_A.'Opportunit.CloseDate_Month', q_B.'Opportunit.CloseDate_Month', q_C.'Opportunit.CloseDate_Month') as 'Opportunit.CloseDate_Month', coalesce(q_C.'Campaign.Tactic__c_bucket', q_D.'Campaign.Tactic__c_bucket', q_A.'Campaign.Tactic__c_bucket', q_B.'Campaign.Tactic__c_bucket') as 'Tactic_Bucket', sum(q_D.'Id_formula') as 'D', sum(q_A.'Id_formula') as 'A', sum(q_B.'Id_formula') as 'B', sum(q_C.'Id_formula') as 'C';\nq = order q by 'Opportunit.CloseDate_Month' asc;\nq = limit q 2000;\n\nq1 = load \"MKTG_Dash_2023_24_quotas\";\nq1 = foreach q1 generate  'Date_Month' ,'Tactic_Bucket', sum('Revenue_Quota') as 'Revenue_Quota';\n\ng = cogroup q1 by ('Date_Month','Tactic_Bucket') full, q by ('Opportunit.CloseDate_Month','Tactic_Bucket') ;\ng = foreach g generate coalesce(q1.'Date_Month',q.'Opportunit.CloseDate_Month')  as 'Date_Month', coalesce (q.'Tactic_Bucket', q.'Tactic_Bucket') as 'Tactic_Bucket', sum(q1.'Revenue_Quota') as 'Revenue_Quota', sum(q.'A') as 'A', sum(q.'B') as 'B',sum(q.'C') as 'C', sum(q.'D') as 'D';\ng = group g by 'Date_Month';\ng = filter g by 'Date_Month' is not null;\ng = foreach g generate 'Date_Month', sum('A') as 'Current Year', sum('B') as 'Last Year',sum('C') as '2023', sum('D') as '2022', sum('R