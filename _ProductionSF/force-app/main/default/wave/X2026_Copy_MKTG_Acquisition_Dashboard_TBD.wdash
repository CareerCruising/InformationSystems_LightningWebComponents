 \"Closed Won\";\nq = cogroup q1 by 'Name' full,q2 by 'Campaign.Name' full, q3 by 'Campaign.Name'full, q4 by 'Campaign.Name';\nq = foreach q generate coalesce(q1.'Name',q2.'Campaign.Name',q3.'Campaign.Name',q4.'Campaign.Name') as 'Campaign Name',max(q1.'CreatedDate') as 'Campaign Created Date' ,max(q1.'BudgetedCost') as 'Budgeted Cost CAD', max(q1.'ActualCost') as 'Actual Cost CAD', count(q2) as 'Member #',sum(q2.'Is_MKTG_Lead') as 'MKTG - Working #',sum(q2.'Is_MQL_Lead') as 'MQL #',sum(q2.'Is_SAL_Lead') as 'SAL #',sum(q2.'Is_SQL_Lead') as 'SQL #',count(q3) as 'Opportunity #', count(q4) as 'Closed Won Opp #', sum(q4.'Id_formula') as 'Revenue Share CAD' , ((sum(q4.'Id_formula')-max(q1.'ActualCost'))/max(q1.'ActualCost')) as 'ROI', min(q1.'Aggregate0.COUNT_Rows') as 'Calls Made';\nq = order q by 'Campaign Created Date' desc;\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#000000","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_14_1":{"broadcastFacet":true,"groups":[],"label":"lens_14","numbers":[],"query":"q1 = load \"Campaigns_Members_Activity\";\nq2 = load \"Oppties_by_Activity_May_18th_2023\";\n--q2 = filter q2 by date('Opportunit.CreatedDate_Year', 'Opportunit.CreatedDate_Year', 'Opportunit.CreatedDate_Year') in [\"current year\"..\"current year\"];\n--q1 = filter q1 by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"current year\"..\"current year\"];\nq = cogroup q1 by all left, q2 by all;\nq