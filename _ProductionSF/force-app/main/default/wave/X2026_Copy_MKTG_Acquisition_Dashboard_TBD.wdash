CreatedDate_Year', 'Opportunit.CreatedDate_Month', 'Opportunit.CreatedDate_Day') in [\"current year\"..\"current year\"];\nq_D = filter q by date('Opportunit.CreatedDate_Year', 'Opportunit.CreatedDate_Month', 'Opportunit.CreatedDate_Day') in [dateRange([2022,1,1], [2022,12,31])];\nq_C = filter q by date('Opportunit.CreatedDate_Year', 'Opportunit.CreatedDate_Month', 'Opportunit.CreatedDate_Day') in [dateRange([2023,1,1], [2023,12,31])];\nq_B = filter q by date('Opportunit.CreatedDate_Year', 'Opportunit.CreatedDate_Month', 'Opportunit.CreatedDate_Day') in [\"1 year ago\"..\"1 year ago\"];\nq = cogroup q_A by ('Opportunit.CreatedDate_Month', 'Campaign.Tactic__c_bucket') full, q_D by ('Opportunit.CreatedDate_Month', 'Campaign.Tactic__c_bucket') full, q_C by ('Opportunit.CreatedDate_Month', 'Campaign.Tactic__c_bucket') full, q_B by ('Opportunit.CreatedDate_Month', 'Campaign.Tactic__c_bucket');\nq = foreach q generate coalesce(q_A.'Opportunit.CreatedDate_Month', q_D.'Opportunit.CreatedDate_Month', q_C.'Opportunit.CreatedDate_Month', q_B.'Opportunit.CreatedDate_Month') as 'Opportunit.CreatedDate_Month', coalesce(q_C.'Campaign.Tactic__c_bucket', q_D.'Campaign.Tactic__c_bucket', q_A.'Campaign.Tactic__c_bucket', q_B.'Campaign.Tactic__c_bucket') as 'Tactic_Bucket', sum(q_A.'Id_formula') as 'A', sum(q_D.'Id_formula') as 'D', sum(q_C.'Id_formula') as 'C', sum(q_B.'Id_formula') as 'B';\n\n\n\nq = order q by 'Opportunit.CreatedDate_Month' asc;\nq = limit q 2000;\n\n\nq1 = load \"MKTG_Dash_2023_24_quotas\";\nq1 = foreach q1 generate  'Date_Month' ,'Tactic_Bucket', sum('Pipe_Quota') as 'Pipe_Quota';\n\ng = cogroup q1 by ('Date_Month','Tactic_Bucket') full, q by ('Opportunit.CreatedDate_Month','Tactic_Bucket') ;\ng = foreach g generate coalesce(q1.'Date_Month',q.'Opportunit.CreatedDate_Month')  as 'Date_Month', coalesce (q.'Tactic_Bucket', q.'Tactic_Bucket') as 'Tactic_Bucket', sum(q1.'Pipe_Quota') as 'Pipe_Quota', sum(q.'A') as 'A', sum(q.'B') as 'B',sum(q.'C') as 'C', sum(q.'D') as