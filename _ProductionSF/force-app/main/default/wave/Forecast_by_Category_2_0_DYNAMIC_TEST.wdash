"parameters":{"autoFitMode":"keepLabels","showValues":true,"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","totalSumMode":"none","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"stackhbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":false,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Forecast_Analysis__M_1":{"broadcastFacet":true,"groups":[],"label":"Forecast Analysis: Monthly chart","numbers":[],"query":"q1 = load \"MetricOpenPipe\";\nq1 = group q1 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type');\nq1 = foreach q1 generate 'ActualPeriod_Year' as 'ActualPeriod_Year', 'ActualPeriod_Month' as 'ActualPeriod_Month', 'Type' as 'Type', \"Open\" as 'StageName', sum('Amount') as 'Amount';\n\nq2 = load \"MetricResults\";\nq2 = group q2 by ('ActualPeriod_Year', 'ActualPeriod_Month', 'Type');\nq2 = foreach q2 generate 'ActualPeriod_Year' as 'ActualPeriod_Year', 'ActualPeriod_Month' as 'ActualPeriod_Month', 'Type' as 'Type', \"Actual\" as 'StageName', sum('Actual') as 'Actual';\n\nq3 = cogroup q1 by ('ActualPeriod_Year', 'ActualPeriod_Month', 'Type', 'StageName') full, q2 by ('ActualPeriod_Year', 'ActualPeriod_Month', 'Type', 'StageName');\nq3 = foreach q3 generate q1.'ActualPeriod_Year' as 'ActualPeriod_Year', q1.'ActualPeriod_Month' as 'ActualPeriod_Month', coalesce (q1.'Type',q2.'Type') as 'Type', coalesce (q1.'StageName',q2.'StageName') as 'StageName', coalesce (sum(q1.'Amount'),0) + coalesce(sum (q2.'Actual'),0) as 'Current_Amount';\n\nq4 = load \"MetricOpenPipeWeekly\";\nq4 = filter q4 by date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day') in [dateRange([2023,1,2], [2023,1,2])];\nq4 = group q4 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type');\nq4 = foreach q4 generate 'ActualPeriod_Year' as 'ActualPeriod_Year', 'ActualPeriod_Month' as 'ActualPeriod_Month', 'Type' as 'Type', \"Open\" as 'StageName', sum('Amount') as 'Amount';\n\nq5 = load \"MetricResultsWeekly\";\nq5 = filter q5 by date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day') in [dateRange([2023,1,2], [2023,1,2])];\nq5 = group q5 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type');\nq5 = foreach q5 generate 'ActualPeriod_Year' as 'ActualPeriod_Year', 'ActualPeriod_Month' as 'ActualPeriod_Month',  'Type' as 'Type', \"Actual\" as 'StageName', sum('Actual') as 'Actual';\n\nq6 = cogroup q4 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type', 'StageName') full, q5 by ('ActualPeriod_Year', 'ActualPeriod_Month', 'Type', 'StageName');\nq6 = foreach q6 generate q4.'ActualPeriod_Year' as 'ActualPeriod_Year', q4.'ActualPeriod_Month' as 'ActualPeriod_Month', coalesce (q4.'Type',q5.'Type') as 'Type', coalesce (q4.'StageName',q5.'StageName') as 'StageName', coalesce (sum(q4.'Amount'),0) + coalesce(sum (q5.'Actual'),0) as 'Previous_Amount';\n\nq8 = load \"MetricTargets\"; \nq8 = group q8 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type');\nq8 = foreach q8 generate 'ActualPeriod_Year' as 'ActualPeriod_Year', 'ActualPeriod_Month' as 'ActualPeriod_Month', 'Type' as 'Type', sum('Target') as 'Target';\n\nq9 = cogroup q8 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type'), q2 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type');\nq9 = foreach q9 generate q8.'ActualPeriod_Year' as 'ActualPeriod_Year', q8.'ActualPeriod_Month' as 'ActualPeriod_Month', q8.'Type' as 'Type', \"Open\" as 'StageName', sum(q8.'Target') - sum(q2.'Actual') as 'Target';\n\nq10 = cogroup q8 by ('ActualPeriod_Year', 'ActualPeriod_Month', 'Type'), q2 by ('ActualPeriod_Year', 'ActualPeriod_Month', 'Type');\nq10 = foreach q10 generate q8.'ActualPeriod_Year' as 'ActualPeriod_Year', q8.'ActualPeriod_Month' as 'ActualPeriod_Month', q8.'Type' as 'Type', \"Actual\" as 'StageName', sum(q2.'Actual') as 'Target';\n\nq11 = union q9, q10;\nq11 = group q11 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type','StageName');\nq11 = foreach q11 generate 'ActualPeriod_Year' as 'ActualPeriod_Year', 'ActualPeriod_Month' as 'ActualPeriod_Month', 'Type' as 'Type', 'StageName' as 'StageName', sum('Target') as 'Target';\n\nq7 = cogroup q3 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type', 'StageName'), q6 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type', 'StageName'), q11 by ('ActualPeriod_Year', 'ActualPeriod_Month','Type', 'StageName');\nq7 = foreach q7 generate q3.'ActualPeriod_Year'+\"~~~\"+ q3.'ActualPeriod_Month' as 'ActualPeriod_Year~~~ActualPeriod_Month', q3.'Type' as 'Type', q3.'StageName' as 'StageName', sum(q11.'Target') as 'Target', sum(q3.'Current_Amount') as 'Current Amount' , sum (q6.'Previous_Amount') as 'Previous Amount';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"totalSumMode":"none","axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitl