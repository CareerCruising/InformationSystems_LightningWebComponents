}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"ActualPeriod_Year_Ac_1":{"broadcastFacet":true,"groups":[],"label":"ActualPeriod_Year_Ac_1","numbers":[],"query":"q1 = load \"MetricOpenPipeWeekly\";\nq1 = filter q1 by {{coalesce(row(static_2.selection, [0], [\"StartEpoch\", \"EndEpoch\"]), row(static_2.result, [0], [\"StartEpoch\", \"EndEpoch\"])).asDateRange(\"date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day')\")}};\n\nq2 = load \"MetricResultsWeekly\";\nq2 = filter q2 by {{coalesce(row(static_2.selection, [0], [\"StartEpoch\", \"EndEpoch\"]), row(static_2.result, [0], [\"StartEpoch\", \"EndEpoch\"])).asDateRange(\"date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day')\")}};\n\nq3 = cogroup q1 by ('ActualPeriod_Year', 'ActualPeriod_Quarter', 'Type') left, q2 by ('ActualPeriod_Year', 'ActualPeriod_Quarter', 'Type');\nq3 = foreach q3 generate q1.'ActualPeriod_Year' as 'ActualPeriod_Year', q1.'ActualPeriod_Quarter' as 'ActualPeriod_Quarter', q1.'Type' as 'Type', coalesce(sum(q1.'Amount'),0) as 'Amount',  coalesce(sum(q2.'Actual'),0) as 'Actual';\n\nq3 = group q3 by ('ActualPeriod_Year', 'ActualPeriod_Quarter', 'Type');\nq3 = foreach q3 generate 'ActualPeriod_Year' + \"~~~\" + 'ActualPeriod_Quarter' as 'ActualPeriod_Year~~~ActualPeriod_Quarter', 'Type' as 'Type', sum('Amount')+sum('Actual') as 'Amount';\n\nq4 = load \"MetricOpenPipe\";\nq5 = load \"MetricResults\";\nq6 = cogroup q4 by ('ActualPeriod_Year', 'ActualPeriod_Quarter', 'Type') left, q5 by ('ActualPeriod_Year', 'ActualPeriod_Quarter', 'Type');\nq6 = foreach q6 generate q4.'ActualPeriod_Year' as 'ActualPeriod_Year', q4.'ActualPeriod_Quarter' as 'ActualPeriod_Quarter', q4.'Type' as 'Type', coalesce(sum(q4.'Amount'),0) as 'Amount',  coalesce(sum(q5.'Actual'),0) as 'Actual';\n\nq6 = group q6 by ('ActualPeriod_Year', 'ActualPeriod_Quarter', 'Type');\nq6 = foreach q6 generate 'ActualPeriod_Year' + \"~~~\" + 'ActualPeriod_Quarter' as 'ActualPeriod_Year~~~ActualPeriod_Quarter', 'Type' as 'Type', sum('Amount')+sum('Actual') as 'Amount';\n\nq7 = cogroup q3 by ('ActualPeriod_Year~~~ActualPeriod_Quarter', 'Type'), q6 by ('ActualPeriod_Year~~~ActualPeriod_Quarter', 'Type');\nq7 = foreach q7 generate q3.'ActualPeriod_Year~~~ActualPeriod_Quarter' as 'ActualPeriod_Year~~~ActualPeriod_Quarter', q3.'Type' as 'Type', sum(q3.'Amount') as 'Previous', sum(q6.'Amount') as 'Current';\n\n\n\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","showValues":true,"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"sync","totalSumMode":"none","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"stackhbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":false,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Gap_Analysis_with_Mo_1":{"broadcastFacet":true,"groups":[],"label":"Gap Analysis Weekly","numbers":[],"query":"q1 = load \"MetricTargets\"; \nq2 = load \"MetricResults\";\nq3 = load \"MetricOpenPipe\"; \nq4 = load \"MetricResultsWeekly\"; q4 = filter q4 by {{cell(static_1.selection, 0,\"Text2\").asDateRange(\"date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day')\")}};\nq5 = load \"MetricOpenPipeWeekly\"; q5 = filter q5 by {{cell(static_1.selection, 0,\"Text2\").asDateRange(\"date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day')\")}};\nqq = group q1 by all;\nqq = foreach qq generate \"Quota\" as 'Category', sum('Target') as 'Current Total', sum('Target') as 'Previous Period', sum('Target')  - sum('Target') as 'Period over Period';\n\nqa1 = group q2 by all;\nqa1 = foreach qa1 generate \"Actual\" as 'Category', sum('Actual') as 'Total'; \nqa2 = group q4 by all;\nqa2 = foreach qa2 generate \"Actual\" as 'Category', sum('Actual') as 'Previous Period'; \nqa = cogroup qa1 by all, qa2 by all;\nqa = foreach qa generate \"Actual\" as 'Category', sum(qa1.'Total') as 'Current Total', sum(qa2.'Previous Period') as 'Previous Period', sum(qa1.'Total') - sum(qa2.'Previous Period') as 'Period over Period'; \n\nqf1 = group q3 by 'ForecastCategoryName';\nqf1 = foreach qf1 generate 'ForecastCategoryName' as 'Category', sum('Amount') as 'Current Total'; --full pipe\nqf2 = group q5 by 'ForecastCategoryName';\nqf2 = foreach qf2 generate 'ForecastCategoryName' as 'Category', sum('Amount') as 'Previous Period'; --full pipe\nqf = cogroup qf1 by 'Category', qf2 by 'Category';\nqf = foreach qf generate qf1.'Category' as 'Category', sum(qf1.'Current Total') as 'Current Total', sum(qf2.'Previous Period') as 'Previous Period', sum(qf1.'Current Total') - sum(qf2.'Previous Period') as 'Period over Period'; --full pipe\n\n\nqaf = union qa, qf;\nqaf = foreach qaf generate 'Category' as 'Category', sum('Current Total') as 'Current Total', sum('Previous Period') as 'Previous Period', 'Period over Period' as 'Period over Period';\nqaf = filter qaf by 'Category' != \"Omitted\";\n\nq = cogroup qq by all, qaf by all;\nq = foreach q generate \"Gap2Quota\" as 'Category', sum(qq.'Current Total') - sum(qaf.'Current Total') as 'Current Total', sum(qq.'Previous Period') - sum(qaf.'Previous Period') as 'Previous Period', (sum(qq.'Current Total') - sum(qaf.'Current Total')) - (sum(qq.'Previous Period') - sum(qaf.'Previous Period')) as 'Period over Period';\n\nunion qq, qaf, q;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Clone_of_Clone_of_Fo_1":{"broadcastFacet":true,"groups":[],"label":"Gap Analysis Chart","numbers":[],"query":"q1 = load \"MetricTargets\"; q2 = load \"MetricResults\"; q3 = load \"MetricOpenPipe\"; q3 = filter q3 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current fiscal_year\"..\"1 fiscal_year ahead\"]; \n\nqq = group q1 by all;\nqq = foreach qq generate \"Quota\" as 'Category', sum('Target') as 'Total';\n\nqa = group q2 by all;\nqa = foreach qa generate \"Actual\" as 'Category', sum('Actual') as 'Total'; \n\nqf = group q3 by 'ForecastCategoryName';\nqf = foreach qf generate 'ForecastCategoryName' as 'Category', sum('Amount') as 'Total'; --full pipe\n\nqaf = union qa, qf;\nqaf = foreach qaf generate 'Category' as 'Category', sum('Total') as 'Total';\nqaf = filter qaf by 'Category' != \"Omitted\";\n\nq = cogroup qq by all, qaf by all;\nq = foreach q generate \"Gap2Quota\" as 'Category', sum(qq.'Total') - sum(qaf.'Total') as 'Total';\n\nfinal = unio