:{"flipLabels":false,"showGridLines":true,"size":[150,80],"enable":false,"type":"x","chartsPerLine":4},"inner":60,"columnMap":{"trellis":[],"dimension":["TerritoryGroup"],"plots":["sum_Amount"]},"showActionMenu":false,"centerValueType":"none","measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Gap_Analysis_Weekly_2":{"broadcastFacet":true,"groups":[],"label":"Gap Analysis Weekly","numbers":[],"query":"q1 = load \"MetricTargets\"; \nq2 = load \"MetricResults\";\nq3 = load \"MetricOpenPipe\"; \nq4 = load \"MetricResultsWeekly\"; \nq4 = filter q4 by date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day') in all;\nq5 = load \"MetricOpenPipeWeekly\"; \nq5 = filter q5 by date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day') in all;\nqq = group q1 by all;\nqq = foreach qq generate \"Quota\" as 'Category', sum('Target') as 'Current Total', sum('Target') as 'Previous Period', sum('Target')  - sum('Target') as 'Period over Period';\n\nqa1 = group q2 by all;\nqa1 = foreach qa1 generate \"Actual\" as 'Category', sum('Actual') as 'Total'; \nqa2 = group q4 by all;\nqa2 = foreach qa2 generate \"Actual\" as 'Category', sum('Actual') as 'Previous Period'; \nqa = cogroup qa1 by all, qa2 by all;\nqa = foreach qa generate \"Actual\" as 'Category', sum(qa1.'Total') as 'Current Total', sum(qa2.'Previous Period') as 'Previous Period', sum(qa1.'Total') - sum(qa2.'Previous Period') as 'Period over Period'; \n\nqf1 = group q3 by 'ForecastCategoryName';\nqf1 = foreach qf1 generate 'ForecastCategoryName' as 'Category', sum('Amount') as 'Current Total'; --full pipe\nqf2 = group q5 by 'ForecastCategoryName';\nqf2 = foreach qf2 generate 'ForecastCategoryName' as 'Category', sum('Amount') as 'Previous Period'; --full pipe\nqf = cogroup qf1 by 'Category', qf2 by 'Category';\nqf = foreach qf generate qf1.'Category' as 'Category', sum(qf1.'Current Total') as 'Current Total', sum(qf2.'Previous Period') as 'Previous Period', sum(qf1.'Current Total') - sum(qf2.'Previous Period') as 'Period over Period'; --full pipe\n\n\nqaf = union qa, qf;\nqaf = foreach qaf generate 'Category' as 'Category', sum('Current Total') as 'Current Total', sum('Previous Period') as 'Previous Period', 'Period over Period' as 'Period over Period';\nqaf = filter qaf by 'Category' != \"Omitted\";\n\nq = cogroup qq by all, qaf by all;\nq = foreach q generate \"Gap2Quota\" as 'Category', sum(qq.'Current Total') - sum(qaf.'Current Total') as 'Current Total', sum(qq.'Previous Period') - sum(qaf.'Previous Period') as 'Previous Period', (sum(qq.'Current Total') - sum(qaf.'Current Total')) - (sum(qq.'Previous Period') - sum(qaf.'Previous Period')) as 'Period over Period';\n\nunion qq, qaf, q;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"Gap_Analysis_Weekly_1":{"broadcastFacet":true,"groups":[],"label":"Gap Analysis Weekly","numbers":[],"query":"q1 = load \"MetricTargets\"; \nq2 = load \"MetricResults\";\nq3 = load \"MetricOpenPipe\"; \nq4 = load \"MetricResultsWeekly\"; \nq4 = fil