;\nq2 = filter q2 by 'ForecastCategoryName' != \"Pipeline\";\nq2 = group q2 by ('ForecastCategoryName', 'OppId');\nq2 = foreach q2 generate 'ForecastCategoryName' as 'ForecastCategoryName', 'OppId' as 'OppId_Current', count() as 'count2';\n\n--q = cogroup q1 by ('ForecastCategoryName', 'OppId_Previous'), q2 by ('ForecastCategoryName', 'OppId_Current');\n--q = foreach q generate q2.'ForecastCategoryName' as 'ForecastCategoryName', q2.'OppId_Current' as 'OppId_Current';\n\n\nq = union q1, q2;\nq = group q by ('ForecastCategoryName', 'OppId_Current');\nq = foreach q generate 'ForecastCategoryName' as 'Forecast Category', 'OppId_Current' as 'OppId_Current', sum('count2') as 'Current'","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"vbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_4_1":{"broadcastFacet":true,"datasets":[{"name":"MetricResults"}],"isGlobal":false,"label":"lens_4","query":{"query":"{\"values\":[\"OppName\",\"OwnerName\",\"Actual\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"fixedColumnWidth":100,"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","mode":"fixed","numberOfLines":1,"showActionMenu":false,"showRowIndexColumn":true,"totals":true,"verticalPadding":8},"type":"table"}},"static_2":{"broadcastFacet":false,"groups":[],"label":"Snapshot Dates","numbers":[],"query":"q = load \"MetricOpenPipeWeekly\";\nq = foreach q generate 'SnapShotDate_Year' as 'SnapShotDate_Year', 'SnapShotDate_Month' as 'SnapShotDate_Month', 'SnapShotDate_Day' as 'SnapShotDate_Day';\nq1 = load \"MetricResultsWeekly\";\nq1 = foreach q1 generate 'SnapShotDate_Year' as 'SnapShotDate_Year', 'SnapShotDate_Month' as 'SnapShotDate_Month', 'SnapShotDate_Day' as 'SnapShotDate_Day';\nq = union q, q1;\nq = group q by ('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day');\nq = foreach q generate\n    date_to_string(\n        toDate(\n            'SnapShotDate_Year' + \"-\" +\n            number_to_string(string_to_number('SnapShotDate_Month'), \"00\") + \"-\" +\n            number_to_string(string_to_number('SnapShotDate_Day'), \"00\"),\n            \"yyyy-MM-dd\"\n        ),\n        \"MMM dd, yyyy\"\n    ) as 'Display',\n    date_to_epoch(\n        toDate(\n            'SnapShotDate_Year' + \"-\" +\n            number_to_string(string_to_number('SnapShotDate_Month'), \"00\") + \"-\" +\n            number_to_string(string_to_number('SnapShotDate_Day'), \"00\"),\n            \"yyyy-MM-dd\"\n        )\n    ) * 1000 as 'StartEpoch',\n    date_to_epoch(\n        toDate(\n            'SnapShotDate_Year' + \"-\" +\n            number_to_string(string_to_number('SnapShotDate_Month'), \"00\") + \"-\" +\n            number_to_string(string_to_number('SnapShotDate_Day'), \"00\"),\n            \"yyyy-MM-dd\"\n        )\n    ) * 1000 as 'EndEpoch',\n    'SnapShotDate_Year' +\n        number_to_string(string_to_number('SnapShotDate_Month'), \"00\") +\n        number_to_string(string_to_number('SnapShotDate_Day'), \"00\") as 'SortKey',\n    count() as 'count';\nq = order q by ('SortKey' desc);\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Type_StageName_1":{"broadcastFacet":true,"groups":[],"label":"Forecast Analysis: Quota Previous Current","numbers":[],"query":"q1 = load \"MetricOpenPipe\";\nq1 = group q1 by ('Type');\nq1 = foreach q1 generate 'Type' as 'Type', \"Open\" as 'StageName', sum('Amount') as 'Amount';\n\nq2 = load \"MetricResults\";\nq2 = group q2 by ('Type');\nq2 = foreach q2 generate 'Type' as 'Type', \"Actual\" as 'StageName', sum('Actual') as 'Actual';\n\nq3 = cogroup q1 by ('Type', 'StageName') full, q2 by ('Type', 'StageName');\nq3 = foreach q3 generate coalesce (q1.'Type',q2.'Type') as 'Type', coalesce (q1.'StageName',q2.'StageName') as 'StageName', coalesce (sum(q1.'Amount'),0) + coalesce(sum (q2.'Actual'),0) as 'Current_Amount';\n\nq4 = load \"MetricOpenPipeWeekly\";\nq4 = filter q4 by {{coalesce(row(static_2.selection, [0], [\"StartEpoch\", \"EndEpoch\"]), row(static_2.result, [0], [\"StartEpoch\", \"EndEpoch\"])).asDateRange(\"date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day')\")}};\nq4 = group q4 by ('Type');\nq4 = foreach q4 generate 'Type' as 'Type', \"Open\" as 'StageName', sum('Amount') as 'Amount';\n\nq5 = load \"MetricResultsWeekly\";\nq5 = filter q5 by {{coalesce(row(static_2.selection, [0], [\"StartEpoch\", \"EndEpoch\"]), row(static_2.result, [0], [\"StartEpoch\", \"EndEpoch\"])).asDateRange(\"date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day')\")}};\nq5 = group q5 by ('Type');\nq5 = foreach q5 generate 'Type' as 'Type', \"Actual\" as 'StageName', sum('Actual') as 'Actual';\n\nq6 = cogroup q4 by ('Type', 'StageName') full, q5 by ('Type', 'StageName');\nq6 = foreach q6 generate coalesce (q4.'Type',q5.'Type') as 'Type', coalesce (q4.'StageName',q5.'StageName') as 'StageName', coalesce (sum(q4.'Amount'),0) + coalesce(sum (q5.'Actual'),0) as 'Previous_Amount';\n\nq8 = load \"MetricTargets\"; \nq8 = group q8 by ('Type');\nq8 = foreach q8 generate 'Type' as 'Type', sum('Target') as 'Target';\n\nq9 = cogroup q8 by ('Type'), q2 by ('Type');\nq9 = foreach q9 generate q8.'Type' as 'Type', \"Open\" as 'StageName', sum(q8.'Target') - sum(q2.'Actual') as 'Target';\n\nq10 = cogroup q8 by ('Type'), q2 by ('Type');\nq10 = foreach q10 generate q8.'Type' as 'Type', \"Actual\" as 'StageName', sum(q2.'Actual') as 'Target';\n\nq11 = union q9, q10;\nq11 = group q11 by ('Type','StageName');\nq11 = foreach q11 generate 'Type' as 'Type', 'StageName' as 'StageName', sum('Target') as 'Target';\n\nq7 = cogroup q3 by ('Type', 'StageName'), q6 by ('Type', 'StageName'), q11 by ('Type', 'StageName');\nq7 = foreach q7 generate q3.'Type' as 'Type', q3.'StageName' as 'StageName', sum(q11.'Target') as 'Target', sum(q3.'Current_Amount') as 'Current Amount' , sum (q6.'Previous_Amount') as 'Previous Amount';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","totalSumMode":"none","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"split":["StageName"],"trellis":[],"dimensionAxis":["Type"],"plots":["Target","Current Amount"