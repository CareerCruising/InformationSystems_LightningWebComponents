iority';\nfinal = order final by 'Priority'; \n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","totalValue":"useLastBucket","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"positiveColor":"#4269E9","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"waterfall","title":{"fontSize":14,"subtitleFontSize":11,"label":"Current","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"startColor":"#1674D9","totalLabel":"Gap2Quota","columnMap":{"measureAxis1":["Total"],"trellis":[],"dimensionAxis":["Category"]},"showActionMenu":false,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"totalColor":"#1674D9","theme":"wave","negativeColor":"#00B531","dimensionAxis":{"showTitle":false,"showAxis":true,"title":""},"applyConditionalFormatting":true},"type":"chart"}},"Quarterly_Forecast_b_1":{"broadcastFacet":true,"groups":[],"label":"Quarterly Forecast by Category","numbers":[],"query":"q = load \"MetricTargets\";\nMetricResults = load \"MetricResults\";\nMetricOpenPipe = load \"MetricOpenPipe\";\nq = group q by ('ReportingPeriod_Quarter');\nq = foreach q generate 'ReportingPeriod_Quarter' as 'ReportingPeriod_Quarter', sum('Target') as 'Target';\n\nq1 =