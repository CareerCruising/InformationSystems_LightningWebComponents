ignment":"left"},"type":"text"},"Needs_Analysis.Success_Plan_URL__c":{"parameters":{"alignment":"left"},"type":"text"},"Opportunit.StageName":{"parameters":{"alignment":"left"},"type":"text"},"ARR_Direct_Open__c":{"parameters":{"alignment":"right"},"type":"text"},"Aggregate0.SUM_Opp_OutstandingPayment":{"parameters":{"alignment":"right"},"type":"text"},"Opportunit.Name":{"parameters":{"alignment":"left"},"type":"text"}},"columns":["Parent_Account_Name__c","Name","Aggregate0.SUM_OpenOppCheck","Aggregate0.SUM_Opp_in_future","Aggregate0.SUM_Opp_OutstandingPayment","Aggregate0.SUM_Opp_OutstandingPO","User.Name","ManagerName_Success","ARR_Direct_Open__c","ExpiryDate__c","Acct_RenewalQuarter","Opportunit.Name","Opportunit.StageName","Opportunit.Amount","Needs_Analysis.Name","ResubRisk__c","RiskCategory__c","Risk_Reason__c","Risk_Assessment_Date__c","Needs_Analysis.LastModifiedDate","Needs_Analysis.Users.Name","Needs_Analysis.Success_Plan_URL__c","Case.CaseNumber","Contact.Name","Contact.Operational_Type__c_formula","OL_ContactCount","Contact.Email"],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"#e4ecf2","fontColor":"#5c7a99","fontSize":12},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"oddRowColor":"#ffffff","showActionMenu":true,"showRowIndexColumn":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_2":{"broadcastFacet":true,"groups":[],"label":"lens_2","numbers":[],"query":"q1 = load \"Success_Acct_Opps_NeedsAnalysis\";\n--q1 = filter q1 by 'Name' == \"Poway Unified School District\";\nq2 = load \"Task_Events_Lead_Contact\";--For Current Month Activities\nq2 = filter q2 by date('ActivityDueDate__c_Year', 'ActivityDueDate__c_Month', 'ActivityDueDate__c_Day') in [\"current month\"..\"current month\"];\n\nq3 = load \"Task_Events_Lead_Contact\";--For Last Any Comm Date\nq3 = filter q3 by 'Is_Past_Activity' == 1;\n\nq4 = load \"Task_Events_Lead_Contact\";--For Next Event Date\nq4 = filter q4 by 'Is_Future_Activity' == 1;\nq4 = filter q4 by 'Activity_Type__c' == \"Event\";\n\nq = cogroup q1 by 'Name'full, q2 by 'Account_Name_Combined'full, q3 by 'Account_Name_Combined'full, q4 by 'Account_Name_Combined';\nq = foreach q generate q1.'Name' as 'Name', min(q1.'User.Name') as 'Account Owner', min(q1.'Parent_Account_Name__c') as 'Parent_Account_Name__c',min(q1.'Contact.COUNT_Id') as '# of OL Contacts',avg(q1.'ARR_Direct_Open__c') as 'ARR Direct Open (CAD)',min(q1.ExpiryDate__c) as 'Expiry Date', min(q1.'Acct_RenewalQuarter')as 'Acct Expiry Quarter', avg(q1.'Aggregate0.SUM_OpenOppCheck') as '# Open Opps' , avg(q1.'Aggregate0.SUM_Opp_in_future') as '# Future Opps',avg(q1.'Aggregate0.SUM_Opp_OutstandingPayment') as '# Outstanding Payment Opps',avg(q1.'Aggregate0.SUM_Opp_OutstandingPO') as '# Outstanding PO Opps', min(q1.'ResubRisk__c') as 'Resub Risk', min(q1.'Risk_Reason__c') as 'Risk Reason', min(q1.'RiskCategory__c') as 'Risk Category', min(q1.'Risk_Assessment_Date__c') as 'Risk Assessment Date', min(q1.'Case.SUM_OnboardingCaseCount') as '# Open Onboarding Cases', min(q1.'Case.SUM_TrainingCaseCount') as '# Open Training Cases', count(q2) as '# Activities Current Month', max(q3.'ActivityDueDate__c') as 'Last Comm Date', min(q4.'ActivityDueDate__c') as 'Next Comm Date', min(q4.'Contact.Name') as 'Contact.Name';\n\nq = order q by 'Name'asc;\nq = filter q by 'Name' is not null;\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e1e5ee","borderWidth":1,"cell":{"backgroundColor":"#f2f6fa","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"evenRowColor":"#f2f6fa","header":{"backgroundColor":"#e4ecf2","fontColor":"#5c7a99","fontSize":12},"innerMajorBorderColor":"#a9b7c7","innerMinorBorderColor":"#e1e5ee","maxColumnWidth":300,"min