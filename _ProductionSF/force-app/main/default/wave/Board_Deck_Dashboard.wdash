e('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current quarter\"..\"current quarter\"];\n\n\nq2 = load \"MetricResults\";\nq2 = filter q2 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current quarter\"..\"current quarter\"];\nq2 = filter q2 by 'Type' ==\"New Sales\";\n\n\nq = cogroup q1 by all full, q2 by all;\nq = foreach q generate sum(q1.'ProbableAmount') as 'Forecast $$', sum(q2.'Actual') as 'Actual';\n\nq = foreach q generate 'Actual' + 'Forecast $$' as 'New Business Forecast';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{"New Business Forecast":{"parameters":{"alignment":"left"},"type":"text"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_2_2":{"broadcastFacet":true,"groups":[],"label":"lens_2","numbers":[],"query":"-- Closed Won\nq1 = load \"OpportunityFull\";\nq1 = filter q1 by 'StageName' == \"Closed Won\";\nq1 = filter q1 by 'Type' in [\"New\", \"Upsell\"];\nq1 = filter q1 by 'Current_Incumbent__c' in [\"Naviance\",\"SchooLinks\"];\nq1 = group q1 by all;\n\n-- Closed Won + Closed Lost\nq2 = load \"OpportunityFull\";\nq2 = filter q2 by 'StageName' in [\"Closed Won\", \"Closed Lost\"];\nq2 = filter q2 by 'Type' in [\"New\", \"Upsell\"];\nq2 = filter q2 by 'Current_Incumbent__c' in [\"Naviance\",\"SchooLinks\"];\nq2 = group q2 by all;\n\n\n-- Final output: 1 row, 3 columns\nq = cogroup q1 by all full, q2 by all;\nq = foreach q generate count(q1)