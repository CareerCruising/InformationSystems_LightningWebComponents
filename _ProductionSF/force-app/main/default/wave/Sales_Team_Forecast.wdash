election, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) as 'GapToQuota',\n    case when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) / sum(t.'Quota')) end as 'PctToQuota';\n\na = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total', 1 as 'SortOrder';\nb1 = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total', 2 as 'SortOrder';\nc = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total', 3 as 'SortOrder';\nd = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total', 4 as 'SortOrder';\ne = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total', 5 as 'SortOrder';\nf = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total', 6 as 'SortOrder';\nu = union a, b1, c, d, e, f;\nu = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","totalValue":"useLastBucket","showValues":true,"positiveColor":"#4269E9","legend":{"