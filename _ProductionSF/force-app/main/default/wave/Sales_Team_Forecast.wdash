\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitAmt',\n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('CommitAmt') as 'CommitAmt', sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) as 'Commit',\n    ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n    (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'AdditionalPipe',\n    (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota';\n\na = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total';\nb1 = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total';\nc = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total';\nd = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total';\ne = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total';\nf = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total';\nu = union a, b1, c, d, e, f;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"weightSelector_Pipeline_Forecast_Wgt":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Weight Selector","selectMode":"singlerequired","start":"{\"Display\":[\"22%\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"40%\",\"Value\":\"0.40\"}","{\"Display\":\"35%\",\"Value\":\"0.35\"}","{\"Display\":\"30%\",\"Value\":\"0.30\"}","{\"Display\":\"25%\",\"Value\":\"0.25\"}","{\"Display\":\"22%\",\"Value\":\"0.22\"}","{\"Display\":\"20%\",\"Value\":\"0.20\"}","{\"Display\":\"15%\",\"Value\":\"0.15\"}","{\"Display\":\"10%\",\"Value\":\"0.10\"}","{\"Display\":\"5%\",\"Value\":\"0.05\"}","{\"Display\":\"0%\",\"Value\":\"0.00\"}"]},"kpi2_month_team":{"broadcastFacet":true,"groups":[],"label":"kpi2_month_team","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\nt = foreach t generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('Target') as 'Quota';\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\nr = foreach r generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('Amount') as 'Closed';\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate\n'ReportingPeriod_Year' as 'ReportingPeriod_Year',\n'ReportingPeriod_Month' as 'ReportingPeriod_Month',\ncase when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitRaw',\ncase when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseRaw',\ncase when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineRaw';\no = group o by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\no = foreach o generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw';\ng = cogroup t by ('ReportingPeriod_Year', 'ReportingPeriod_Month') left, r by ('ReportingPeriod_Year', 'ReportingPeriod_Month'), o by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\ng = foreach g generate\ncoalesce(t.'ReportingPeriod_Year', r.'ReportingPeriod_Year', o.'ReportingPeriod_Year') as 'ReportingPeriod_Year',\ncoalesce(t.'ReportingPeriod_Month', r.'ReportingPeriod_Month', o.'ReportingPeriod_Month') as 'ReportingPeriod_Month',\nsum(t.'Quota') as 'Quota',\nsum(r.'Closed') as 'Closed',\n(sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) as 'Commit',\n(sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n(sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'Pipeline',\n(sum(t.'Quota') - sum(r.'Closed') - (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota';\ng = foreach g generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', 'Quota' as 'Quota', 'Closed' as 'Closed', 'Commit' as 'Commit', 'BestCase' as 'BestCase', 'Pipeline' as 'Pipeline', 'GapToQuota' as 'GapToQuota', case when 'Quota' == 0 then 0 else ('GapToQuota' / 'Quota') end as 'PctToQuota';\ng = order g by ('ReportingPeriod_Year' asc, 'ReportingPeriod_Month' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"input_1":{"label":"","type":"input"},"quotaPeriodSelector":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Quota Period","selectMode":"singlerequired","start":"{\"Display\":[\"Full Year\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"H1\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= \\\"01\\\" and 'ReportingPeriod_Month' < \\\"07\\\"\"}","{\"Display\":\"H2\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= \\\"07\\\" and 'ReportingPeriod_Month' < \\\"13\\\"\"}","{\"Display\":\"Full Year\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= \\\"01\\\" and 'ReportingPeriod_Month' < \\\"13\\\"\"}"]},"Weight_Selector_19":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Weight Selector","selectMode":"singlerequired","start":"{\"Display\":[\"15%\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"0%\",\"Value\":\"0.00\"}","{\"Display\":\"5%\",\"Value\":\"0.05\"}","{\"Display\":\"10%\",\"Value\":\"0.10\"}","{\"Display\":\"15%\",\"Value\":\"0.15\"}","{\"Display\":\"20%\",\"Value\":\"0.20\"}","{\"Display\":\"25%\",\"Value\":\"0.25\"}","{\"Display\":\"30%\",\"Value\":\"0.30\"}","{\"Display\":\"35%\",\"Value\":\"0.35\"}","{\"Display\":\"40%\",\"Value\":\"0.40\"}","{\"Display\":\"45%\",\"Value\":\"0.45\"}","{\"Display\":\"50%\",\"Value\":\"0.50\"}","{\"Display\":\"55%\",\"Value\":\"0.55\"}","{\"Display\":\"60%\",\"Value\":\"0.60\"}","{\"Display\":\"65%\",\"Value\":\"0.65\"}","{\"Display\":\"70%\",\"Value\":\"0.70\"}","{\"Display\":\"75%\",\"Value\":\"0.75\"}","{\"Display\":\"80%\",\"Value\":\"0.80\"}","{\"Display\":\"85%\",\"Value\":\"0.85\"}","{\"Display\":\"90%\",\"Value\":\"0.90\"}","{\"Display\":\"95%\",\"Value\":\"0.95\"}","{\"Display\":\"100%\",\"Value\":\"1.00\"}"]},"Weight_Selector_18":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Weight Selector","selectMode":"singlerequired","start":"{\"Display\":[\"30%\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"0%\",\"Value\":\"0.00\"}","{\"Display\":\"5%\",\"Value\":\"0.05\"}","{\"Display\":\"10%\",\"Value\":\"0.10\"}","{\"Display\":\"15%\",\"Value\":\"0.15\"}","{\"Display\":\"20%\",\"Value\":\"0.20\"}","{\"Display\":\"25%\",\"Value\":\"0.25\"}","{\"Display\":\"30%\",\"Value\":\"0.30\"}","{\"Display\":\"35%\",\"Value\":\"0.35\"}","{\"Display\":\"40%\",\"Value\":\"0.40\"}","{\"Display\":\"45%\",\"Value\":\"0.45\"}","{\"Display\":\"50%\",\"Value\":\"0.50\"}","{\"Display\":\"55%\",\"Value\":\"0.55\"}","{\"Display\":\"60%\",\"Value\":\"0.60\"}","{\"Display\":\"65%\",\"Value\":\"0.65\"}","{\"Display\":\"70%\",\"Value\":\"0.70\"}","{\"Display\":\"75%\",\"Value\":\"0.75\"}","{\"Display\":\"80%\",\"Value\":\"0.80\"}","{\"Display\":\"85%\",\"Value\":\"0.85\"}","{\"Display\":\"90%\",\"Value\":\"0.90\"}","{\"Display\":\"95%\",\"Value\":\"0.95\"}","{\"Display\":\"100%\",\"Value\":\"1.00\"}"]},"page1_table_unweighted":{"broadcastFacet":true,"groups":[],"label":"page1_table_unweighted","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(needBySelector_v2.selection, 0, \"Value\"), cell(needBySelector_v2.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * 0.8) as 'AdditionalPipeRaw';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    (sum(r.'ClosedAmt') + ((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    ((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) as 'Commit',\n    (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) as 'BestCase',\n    (case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end) as 'AdditionalPipe',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota';\n\na = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total';\nb1 = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total';\nc = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total';\nd = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total';\ne = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total';\nf = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total';\nu = union a, b1, c, d, e, f;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_owner":{"broadcastFacet":true,"groups":[],"label":"kpi1_owner","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nt = group t by 'OwnerName';\nt = foreach t generate 'OwnerName' as 'OwnerName', sum('Target') as 'Quota';\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nr = group r by 'OwnerName';\nr = foreach r generate 'OwnerName' as 'OwnerName', sum('Amount') as 'ClosedWon';\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\no = foreach o generate\n'OwnerName' as 'OwnerName',\ncase when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitAmt',\ncase when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\ncase when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by 'OwnerName';\no = foreach o generate 'OwnerName' as 'OwnerName', sum('CommitAmt') as 'CommitAmt', sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\ng = cogroup t by 'OwnerName' left, r by 'OwnerName', o by 'OwnerName';\ng = foreach g generate\ncoalesce(t.'OwnerName', r.'OwnerName', o.'OwnerName') as 'OwnerName',\nsum(t.'Quota') as 'Quota',\n(sum(r.'ClosedWon') + sum(o.'CommitAmt') + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) as 'Commit',\n(sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) as 'BestCase',\nsum(o.'PipelineAmt') as 'AdditionalPipe',\n(sum(t.'Quota') - (sum(r.'ClosedWon') + sum(o.'CommitAmt') + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) - (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) as 'GapToQuota';\ng = foreach g generate 'OwnerName' as 'OwnerName', 'Quota' as 'Quota', 'Closed' as 'Closed', 'Commit' as 'Commit', 'BestCase' as 'BestCase', 'AdditionalPipe' as 'AdditionalPipe', 'GapToQuota' as 'GapToQuota', case when 'Quota' == 0 then 0 else ('GapToQuota' / 'Quota') end as 'PctToQuota';\nteam = group g by all;\nteam = foreach team generate\n\"TEAM\" as 'OwnerName',\nsum('Quota') as 'Quota',\nsum('Closed') as 'Closed',\nsum('Commit') as 'Commit',\nsum('BestCase') as 'BestCase',\nsum('AdditionalPipe') as 'AdditionalPipe',\nsum('GapToQuota') as 'GapToQuota',\ncase when sum('Quota') == 0 then 0 else (sum('GapToQuota') / sum('Quota')) end as 'PctToQuota';\nu = union team, g;\nu = foreach u generate 'OwnerName' as 'OwnerName', 'Quota' as 'Quota', 'Closed' as 'Closed', 'Commit' as 'Commit', 'BestCase' as 'BestCase', 'AdditionalPipe' as 'AdditionalPipe', 'GapToQuota' as 'GapToQuota', 'PctToQuota' as 'PctToQuota', case when 'OwnerName' == \"TEAM\" then 0 else 1 end as 'SortOrder';\nu = order u by ('SortOrder' asc, 'GapToQuota' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"columnProperties":{},"columns":["OwnerName","Quota","Closed","Commit","BestCase","AdditionalPipe","GapToQuota","PctToQuota"],"customBulkActions":[],"header":{"backgroundColor":"#000000","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"kpi1_waterfall_unwei_2":{"broadcastFacet":true,"groups":[],"label":"kpi1_waterfall_unweighted","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(needBySelector_v2.selection, 0, \"Value\"), cell(needBySelector_v2.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * 0.8) as 'AdditionalPipe';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) as 'Commit',\n    ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) as 'BestCase',\n    (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end) as 'AdditionalPipe',\n    (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) as 'GapToQuota',\n    case when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) / sum(t.'Quota')) end as 'PctToQuota';\n\na = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total', 1 as 'SortOrder';\nb1 = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total', 2 as 'SortOrder';\nc = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total', 3 as 'SortOrder';\nd = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total', 4 as 'SortOrder';\ne = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total', 5 as 'SortOrder';\nf = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total', 6 as 'SortOrder';\nu = union a, b1, c, d, e, f;\nu = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","totalValue":"useLastBucket","showValues":true,"positiveColor":"#4269E9","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"waterfall","title":{"fontSize":18,"subtitleFontSize":11,"label":"Predicted","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"startColor":"#1674D9","totalLabel":"Gap To Quota","columnMap":{"measureAxis1":["Total"],"trellis":[],"dimensionAxis":["Category"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"totalColor":"#1674D9","theme":"wave","negativeColor":"#00B531","dimensionAxis":{"showTitle":false,"showAxis":true,"title":""},"applyConditionalFormatting":true},"type":"chart"}},"TerritoryGroup_1_2":{"broadcastFacet":true,"datasets":