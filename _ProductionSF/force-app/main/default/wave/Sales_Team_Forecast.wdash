ctor.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n r = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n r = filter r by 'Type' == \"New Sales\";\n r = filter r by 'StageName' == \"Closed Won\";\n r = filter r by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n r = group r by all;\n r = foreach r generate 0 as 'Quota', sum('Amount') as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n o = load \"MetricOpenPipe_Results_Weekly_Stage\";\n o = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n o = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n o = filter o by 'Type' == \"New Sales\";\n o = filter o by 'StageNameSource' == \"Source: OpenPipe\";\n o = filter o by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n o = foreach o generate 0 as 'Quota', 0 as 'Closed', case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'Commit', case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCase', case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'Pipeline', 0 as 'AdditionalPipe', case when 'ForecastCategoryName' == \"Commit\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_4.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_9.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_10.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'CommitWgt', case when 'ForecastCategoryName' == \"Best Case\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_7.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_5.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_11.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'BestCaseWgt', case when 'ForecastCategoryName' == \"Pipeline\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'Repor