1\\\",\\\"TG 2\\\",\\\"TG 3\\\",\\\"TG 4\\\",\\\"TG 5\\\",\\\"TG - UK\\\",\\\"TG Non-K12\\\",\\\"TG Strategic\\\"]\"}","{\"Display\":\"TG Strategic\",\"Value\":\"[\\\"TG Strategic\\\"]\"}"]},"kpi1_summary_15":{"broadcastFacet":true,"groups":[],"label":"kpi1_summary","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(Need_By_v2_1.selection, 0, \"Value\"), cell(Need_By_v2_1.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'AdditionalPipe';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'Closed';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageNameSource' == \"Source: OpenPipe\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate\n  case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitRaw',\n  case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseRaw',\n  case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineRaw';\no = group o by all;\no = foreach o generate sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate\n  sum(t.'Quota') as 'Quota',\n  sum(r.'Closed') as 'Closed',\n  (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) as 'Commit',\n  (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n  (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'Pipeline',\n  (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end) as 'AdditionalPipe',\n  (sum(t.'Quota') - sum(r.'Closed') - (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) as 'GapToQuota',\n  case when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - sum(r.'Closed') - (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) / sum(t.'Quota')) end as 'PctToQuota';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_pipeline_details":{"broadcastFacet":true,"groups":[],"label":"kpi1_pipeline_details","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = filter q by 'ForecastCategoryName' in [\"Commit\", \"Best Case\", \"Pipeline\"];\nq = foreach q generate 'OwnerName' as 'OwnerName', 'OppName' as 'OppName', 'Amount' as 'Amount', 'ForecastCategoryName' as 'ForecastCategoryName', 'StageName' as 'StageName', 'ReportingPeriod' as 'ReportingPeriod', 'ForecastingNotes' as 'ForecastingNotes';\nq = order q by 'Amount' desc;\nq = limit q 25;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_summary_14":{"broadcastFacet":true,"groups":[],"label":"kpi1_summary","numbers":[],"query":" t = load \"MetricTargets\";\n t = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n t = filter t by 'Type' == \"New Sales\";\n t = filter t by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n t = group t by all;\n t = foreach t generate sum('Target') as 'Quota', 0 as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n b = load \"MetricTargets\";\n b = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n b = filter b by 'Type' == \"BDR New Sales Contribution\";\n b = filter b by {{coalesce(cell(Need_By_v2_1.selection, 0, \"Value\"), cell(Need_By_v2_1.result, 0, \"Value\")).asString()}};\n b = filter b by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n b = foreach b generate 0 as 'Quota', 0 as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', ('Target' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_6.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) as 'AdditionalPipe';\n b = group b by all;\n b = foreach b generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\n r = load \"MetricOpenPipe_Results_Weekly_Stage\";\n r = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n r = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n r = filter r by 'Type' == \"New Sales\";\n r = filter r by 'StageName' == \"Closed Won\";\n r = filter r by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n r = group r by all;\n r = foreach r generate 0 as 'Quota', sum('Amount') as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n o = load \"MetricOpenPipe_Results_Weekly_Stage\";\n o = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n o = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n o = filter o by 'Type' == \"New Sales\";\n o = filter o by 'StageNameSource' == \"Source: OpenPipe\";\n o = filter o by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n o = foreach o generate 0 as 'Quota', 0 as 'Closed', case when 'ForecastCategoryName' == \"Commit\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_4.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_9.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_10.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'Commit', case when 'ForecastCategoryName' == \"Best Case\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_7.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_5.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_11.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'BestCase', case when 'ForecastCategoryName' == \"Pipeline\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_6.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'Pipeline', 0 as 'AdditionalPipe';\n o = group o by all;\n o = foreach o generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\n u0 = union t, b, r, o;\n g = group u0 by all;\n g = foreach g generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe', (sum('Quota') - sum('Closed') - sum('Commit') - sum('BestCase') - sum('Pipeline') - sum('AdditionalPipe')) as 'GapToQuota', case when sum('Quota') == 0 then 0 else ((sum('Quota') - sum('Closed') - sum('Commit') - sum('BestCase') - sum('Pipeline') - sum('AdditionalPipe')) / sum('Quota')) end as 'PctToQuota';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_summary_13":{"broadcastFacet":true,"groups":[],"label":"kpi1_summary","numbers":[],"query":" t = load \"MetricTargets\";\n t = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n t = filter t by 'Type' == \"New Sales\";\n t = filter t by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n t = group t by all;\n t = foreach t generate sum('Target') as 'Quota', 0 as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n b = load \"MetricTargets\";\n b = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n b = filter b by 'Type' == \"BDR New Sales Contribution\";\n b = filter b by {{coalesce(cell(Need_By_v2_1.selection, 0, \"Value\"), cell(Need_By_v2_1.result, 0, \"Value\")).asString()}};\n b = filter b by {{coalesce(cell(weightedQuarterSelector.select