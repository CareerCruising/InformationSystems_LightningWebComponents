00\"}","{\"Display\":\"5%\",\"Value\":\"0.05\"}","{\"Display\":\"10%\",\"Value\":\"0.10\"}","{\"Display\":\"15%\",\"Value\":\"0.15\"}","{\"Display\":\"20%\",\"Value\":\"0.20\"}","{\"Display\":\"25%\",\"Value\":\"0.25\"}","{\"Display\":\"30%\",\"Value\":\"0.30\"}","{\"Display\":\"35%\",\"Value\":\"0.35\"}","{\"Display\":\"40%\",\"Value\":\"0.40\"}","{\"Display\":\"45%\",\"Value\":\"0.45\"}","{\"Display\":\"50%\",\"Value\":\"0.50\"}","{\"Display\":\"55%\",\"Value\":\"0.55\"}","{\"Display\":\"60%\",\"Value\":\"0.60\"}","{\"Display\":\"65%\",\"Value\":\"0.65\"}","{\"Display\":\"70%\",\"Value\":\"0.70\"}","{\"Display\":\"75%\",\"Value\":\"0.75\"}","{\"Display\":\"80%\",\"Value\":\"0.80\"}","{\"Display\":\"85%\",\"Value\":\"0.85\"}","{\"Display\":\"90%\",\"Value\":\"0.90\"}","{\"Display\":\"95%\",\"Value\":\"0.95\"}","{\"Display\":\"100%\",\"Value\":\"1.00\"}"]},"page1_table_current_2":{"broadcastFacet":true,"groups":[],"label":"page1_table_current","numbers":[],"query":" t = load \"MetricTargets\";\n t = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n t = filter t by 'Type' == \"New Sales\";\n t = filter t by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n t = group t by all;\n t = foreach t generate sum('Target') as 'Quota', 0 as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n r = load \"MetricOpenPipe_Results_Weekly_Stage\";\n r = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n r = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n r = filter r by 'Type' == \"New Sales\";\n r = filter r by 'StageName' == \"Closed Won\";\n r = filter r by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n r = group r by all;\n r = foreach r generate 0 as 'Quota', sum('Amount') as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n o = load \"MetricOpenPipe_Results_Weekly_Stage\";\n o = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n o = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n o = filter o by 'Type' == \"New Sales\";\n o = filter o by 'StageNameSource' == \"Source: OpenPipe\";\n o = filter o by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n o = foreach o generate 0 as 'Quota', 0 as 'Closed', case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'Commit', case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCase', case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'Pipeline', 0 as 'AdditionalPipe', case when 'ForecastCategoryName' == \"Commit\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_4.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_9.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_10.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'CommitWgt', case when 'ForecastCategoryName' == \"Best Case\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_7.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_5.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_11.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'BestCaseWgt', case when 'ForecastCategoryName' == \"Pipeline\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_6.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'PipelineWgt';\n o = group o by all;\n o = foreach o generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', 0 as 'AdditionalPipe', sum('CommitWgt') as 'CommitWgt', sum('BestCaseWgt') as 'BestCaseWgt', sum('PipelineWgt') as 'PipelineWgt';\n u0 = union t, r, o;\n g = group u0 by all;\n g = foreach g generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('CommitWgt') as 'CommitWgt', sum('BestCaseWgt') as 'BestCaseWgt', sum('PipelineWgt') as 'PipelineWgt', (sum('Quota') - sum('Closed') - sum('CommitWgt') - sum('BestCaseWgt') - sum('PipelineWgt')) as 'GapToQuota';\na = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total', 1 as 'SortOrder';\nb1 = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total', 2 as 'SortOrder';\nc = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total', 3 as 'SortOrder';\nd = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total', 4 as 'SortOrder';\ne = foreach g generate \"Pipeline\" as 'Category', 'Pipeline' as 'Total', 5 as 'SortOrder';\nf = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total', 6 as 'SortOrder';\nu = union a,b1,c,d,e,f;\nu = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi2_summary":{"broadcastFacet":true,"groups":[],"label":"kpi2_summary","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by 'OwnerName';\nt = foreach t generate 'OwnerName' as 'OwnerName', sum('Target') as 'Quota';\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by 'OwnerName';\nr = foreach r generate 'OwnerName' as 'OwnerName', sum('Amount') as 'Closed';\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate\n'OwnerName' as 'OwnerName',\ncase when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitRaw',\ncase when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseRaw',\ncase when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineRaw';\no = group o by 'OwnerName';\no = foreach o generate 'OwnerName' as 'OwnerName', sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw';\ng = cogroup t by 'OwnerName' left, r by 'OwnerName', o by 'OwnerName';\ng = foreach g generate\ncoalesce(t.'OwnerName', r.'OwnerName', o.'OwnerName') as 'OwnerName',\nsum(t.'Quota') as 'Quota',\nsum(r.'Closed') as 'Closed',\n(sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) as 'Commit',\n(sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n(sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'Pipeline',\n(sum(t.'Quota') - sum(r.'Closed') - (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota';\ns = group g by all;\ns = foreach s generate\nsum('Quota') as 'Quota',\nsum('Closed') as 'Closed',\nsum('Commit') as 'Commit',\nsum('BestCase') as 'BestCase',\nsum('Pipeline') as 'Pipeline',\nsum('GapToQuota') as 'GapToQuota',\ncase when sum('Quota') == 0 then 0 else (sum('GapToQuota') / sum('Quota')) end as 'PctToQuota';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"Need_By_2":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Need By","selectMode":"singlerequired","start":"{\"Display\":[\"Full Year\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"End of Q1\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"04\\\"\"}","{\"Display\":\"End of Q2\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"07\\\"\"}","{\"Display\":\"End of Q3\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"10\\\"\"}","{\"Display\":\"Full Year\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"13\\\"\"}"]},"weightSelector_Commit_Forecast_Wgt":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Weight Selector","selectMode":"singlerequired","start":"{\"Display\":[\"89%\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"100%\",\"Value\":\"1.00\"}","{\"Display\":\"95%\",\"Value\":\"0.95\"}","{\"Display\":\"90%\",\"Value\":\"0.90\"}","{\"Display\":\"89%\",\"Value\":\"0.89\"}","{\"Display\":\"85%\",\"Value\":\"0.85\"}","{\"Display\":\"80%\",\"Value\":\"0.80\"}","{\"Display\":\"75%\",\"Value\":\"0.75\"}","{\"Display\":\"70%\",\"Value\":\"0.70\"}","{\"Display\":\"65%\",\"Value\":\"0.65\"}","{\"Display\":\"60%\",\"Value\":\"0.60\"}","{\"Display\":\"55%\",\"Value\":\"0.55\"}","{\"Display\":\"50%\",\"Value\":\"0.50\"}","{\"Display\":\"45%\",\"Value\":\"0.45\"}","{\"Display\":\"40%\",\"Value\":\"0.40\"}","{\"Display\":\"35%\",\"Value\":\"0.35\"}","{\"Display\":\"30%\",\"Value\":\"0.30\"}","{\"Display\":\"25%\",\"Value\":\"0.25\"}","{\"Display\":\"20%\",\"Value\":\"0.20\"}","{\"Display\":\"15%\",\"Value\":\"0.15\"}","{\"Display\":\"10%\",\"Value\":\"0.10\"}","{\"Display\":\"5%\",\"Value\":\"0.05\"}","{\"Display\":\"0%\",\"Value\":\"0.00\"}"]},"SnapshotDate_Default":{"broadcastFacet":false,"groups":[],"label":"Snapshot Date Default","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by date('SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day') in [\"current year\"..\"current year\"];\nq = group q by ('SnapshotDate_TEXT', 'SnapShotDate_Year', 'SnapShotDate_Month', 'SnapShotDate_Day');\nq = foreach q generate\n    'SnapshotDate_TEXT' as 'Display',\n    (\"'SnapshotDate_TEXT' == \\\"\" + 'SnapshotDate_TEXT' + \"\\\"\") as 'Value',\n    'SnapShotDate_Year' + number_to_string(string_to_number('SnapShotDate_Month'), \"00\") + number_to_string(string_to_number('SnapShotDate_Day'), \"00\") as 'SortKey',\n    count() as 'count';\nq = order q by ('SortKey' desc);\nq = limit q 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"quarterCompareQ1":{"broadcastFacet":false,"groups":[],"label":"quarterCompareQ1","numbers":[],"query":" t = load \"MetricTargets\";\n t = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n t = filter t by 'Type' == \"New Sales\";\n t = filter t by 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\";\n t = group t by all;\n t = foreach t generate sum('Target') as 'Quota', 0 as 'Closed', 0 as 'CommitRaw', 0 as 'BestCaseRaw', 0 as 'PipelineRaw', 0 as 'AdditionalRaw';\n b = load \"MetricTargets\";\n b = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n b = filter b by 'Type' == \"BDR New Sales Contribution\";\n b = filter b by {{coalesce(cell(Need_By_v2_1.selection, 0, \"Value\"), cell(Need_By_v2_1.result, 0, \"Value\")).asString()}};\n b = filter b by 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\";\n b = group b by all;\n b = foreach b generate 0 as 'Quota', 0 as 'Closed', 0 as 'CommitRaw', 0 as 'BestCaseRaw', 0 as 'PipelineRaw', sum('Target') as 'AdditionalRaw';\n r = load \"MetricOpenPipe_Results_Weekly_Stage\";\n r = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n r = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n r = filter r by 'Type' == \"New Sales\";\n r = filter r by 'StageName' == \"Closed Won\";\n r = filter r by 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\";\n r = group r by all;\n r = foreach r generate 0 as 'Quota', sum('Amount') as 'Closed', 0 as 'CommitRaw', 0 as 'BestCaseRaw', 0 as 'PipelineRaw', 0 as 'AdditionalRaw';\n o = load \"MetricOpenPipe_Results_Weekly_Stage\";\n o = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n o = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n o = filter o by 'Type' == \"New Sales\";\n o = filter o by 'StageNameSource' == \"Source: OpenPipe\";\n o = filter o by 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\";\n o = foreach o generate 0 as 'Quota', 0 as 'Closed', case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitRaw', case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseRaw', case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineRaw', 0 as 'AdditionalRaw';\n o = group o by all;\n o = foreach o generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw', sum('AdditionalRaw') as 'AdditionalRaw';\n u0 = union t,b,r,o;\n g = group u0 by all;\n g = foreach g generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw', sum('AdditionalRaw') as 'AdditionalRaw';\n a = foreach g generate \"Commit\" as 'Metric', ('CommitRaw' * 0.89) as 'StdForecasted', ('CommitRaw' * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) as 'ManualForecasted', 1 as 'SortOrder';\n b1 = foreach g generate \"Best Case\" as 'Metric', ('BestCaseRaw' * 0.40) as 'StdForecasted', ('BestCaseRaw' * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'ManualForecasted', 2 as 'SortOrder';\n c = foreach g generate \"Pipeline\" as 'Metric', ('PipelineRaw' * 0.22) as 'StdForecasted', ('PipelineRaw' * {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'ManualForecasted', 3 as 'SortOrder';\n d = foreach g generate \"Gap2Quota\" as 'Metric', ('Quota' - 'Closed' - ('CommitRaw' * 0.89) - ('BestCaseRaw' * 0.40) - ('PipelineRaw' * 0.22) - ('AdditionalRaw' * 0.22)) as 'StdForecasted', ('Quota' - 'Closed' - ('CommitRaw' * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - ('BestCaseRaw' * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - ('PipelineRaw' * {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) - ('AdditionalRaw' * {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'ManualForecasted', 4 as 'SortOrder';\n u = union a,b1,c,d;\n u = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"columnProperties":{},"columns":["Metric","StdForecasted","ManualForecasted"],"customBulkActions":[],"header":{"backgroundColor":"#000000","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":false,"verticalPadding":8},"type":"table"}},"quarterCompareQ2":{"broadcastFacet":false,"groups":[],"label":"quarterCompareQ2","numbers":[],"query":"