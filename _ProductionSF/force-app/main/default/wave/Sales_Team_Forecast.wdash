elector_v2.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * 0.8) as 'AdditionalPipe';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) as 'Commit',\n    ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) as 'BestCase',\n    (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end) as 'AdditionalPipe',\n    (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) as 'GapToQuota',\n    case when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) / sum(t.'Quota')) end as 'PctToQuota';\n\na = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total', 1 as 'SortOrder';\nb1 = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total', 2 as 'SortOrder';\nc = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total', 3 as 'SortOrder';\nd = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total', 4 as 'SortOrder';\ne = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total', 5 as 'SortOrder';\nf = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total', 6 as 'SortOrder';\nu = union a, b1, c, d, e, f;\nu = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","totalValue":"useLastBucket","showValues":true,"positiveColor":"#4269E9","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"waterfall","title":{"fontSize":18,"subtitleFontSize":11,"label":"Predicted","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"startColor":"#1674D9","totalLabel":"Gap To Quota","columnMap":{"measureAxis1":["Total"],"trellis":[],"dimensionAxis":["Category"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"totalColor":"#1674D9","theme":"wave","negativeColor":"#00B531","dimensionAxis":{"showTitle":false,"showAxis":true,"title":""},"applyConditionalFormatting":true},"type":"chart"}},"TerritoryGroup_1_1":{"broadcastFacet":true,"datasets":[{"name":"MetricOpenPipe_Results_Weekly_Stage"}],"isGlobal":false,"label":"TerritoryGroup_1","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"TerritoryGroup\"],\"filters\":[[\"TerritoryGroup\",[\"TG College\",\"TG Communities\",\"TG Florida\",\"TG Florida - NH\",\"TG NYCPS\",\"TG Other\",\"TG Strategic\"],\"not in\"]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["TerritoryGroup"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Need_By_v2_1":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Need By v2","selectMode":"singlerequired","start":"{\"Display\":[\"Full Year\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"None\",\"Value\":\"1 == 0\"}","{\"Display\":\"End of Q2\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"07\\\"\"}","{\"Display\":\"End of Q3\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"10\\\"\"}","{\"Display\":\"Full Year\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"13\\\"\"}"]},"kpi2_month_team_long":{"broadcastFacet":true,"groups":[],"label":"kpi2_month_team_long","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\nt = foreach t generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('Target') as 'Quota';\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\nr = foreach r generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('Amount') as 'Closed';\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate\n'ReportingPeriod_Year' as 'ReportingPeriod_Year',\n'ReportingPeriod_Month' as 'ReportingPeriod_Month',\ncase when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitRaw',\ncase when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseRaw',\ncase when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineRaw';\no = group o by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\no = foreach o generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw';\ng = cogroup t by ('ReportingPeriod_Year', 'ReportingPeriod_Month') left, r by ('ReportingPeriod_Year', 'ReportingPeriod_Month'), o by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\ng = foreach g generate\ncoalesce(t.'ReportingPeriod_Year', r.'ReportingPeriod_Year', o.'ReportingPeriod_Year') as 'ReportingPeriod_Year',\ncoalesce(t.'ReportingPeriod_Month', r.'ReportingPeriod_Month', o.'ReportingPeriod_Month') as 'ReportingPeriod_Month',\nsum(t.'Quota') as 'Quota',\nsum(r.'Closed') as 'Closed',\n(sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) as 'Commit',\n(sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n(sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'Pipeline',\n(sum(t.'Quota') - sum(r.'Closed') - (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota',\ncase when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - sum(r.'Closed') - (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) / sum(t.'Quota')) end as 'PctToQuota';\ng = order g by ('ReportingPeriod_Year' asc, 'ReportingPeriod_Month' asc);\na = foreach g generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', \"Closed\" as 'Metric', 'Closed' as 'Value';\nb = foreach g generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', \"Commit\" as 'Metric', 'Commit' as 'Value';\nc = foreach g generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', \"Best Case\" as 'Metric', 'BestCase' as 'Value';\nd = foreach g generate 'ReportingPeriod_Year' as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', \"Pipeline\" as 'Metric', 'Pipeline' as 'Value';\nu = union a, b, c, d;\nu = order u by ('ReportingPeriod_Year' asc, 'ReportingPeriod_Month' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_waterfall_unweighted":{"broadcastFacet":true,"groups":[],"label":"kpi1_waterfall_unweighted","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(needBySelector_v2.selection, 0, \"Value\"), cell(needBySelector_v2.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * 0.8) as 'AdditionalPipe';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) as 'Commit',\n    ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) as 'BestCase',\n    (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end) as 'AdditionalPipe',\n    (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) as 'GapToQuota',\n    case when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - (sum(r.'ClosedAmt') + (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - (((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}}))) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}})) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) / sum(t.'Quota')) end as 'PctToQuota';\n\na = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total', 1 as 'SortOrder';\nb1 = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total', 2 as 'SortOrder';\nc = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total', 3 as 'SortOrder';\nd = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total', 4 as 'SortOrder';\ne = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total', 5 as 'SortOrder';\nf = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total', 6 as 'SortOrder';\nu = union a, b1, c, d, e, f;\nu = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","totalValue":"useLastBucket","showValues":true,"positiveColor":"#4269E9","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"waterfall","title":{"fontSize":18,"subtitleFontSize":11,"label":"Predicted","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"startColor":"#1674D9","totalLabel":"Gap To Quota","columnMap":{"measureAxis1":["Total"],"trellis":[],"dimensionAxis":["Category"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"totalColor":"#1674D9","theme":"wave","negativeColor":"#00B531","dimensionAxis":{"showTitle":false,"showAxis":true,"title":""},"applyConditionalFormatting":true},"type":"chart"}},"needBySelector_v2":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Need By v2","selectMode":"singlerequired","start":"{\"Display\":[\"Full Year\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"None\",\"Value\":\"1 == 0\"}","{\"Display\":\"End of Q2\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"07\\\"\"}","{\"Display\":\"End of Q3\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"10\\\"\"}","{\"Display\":\"Full Year\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= number_to_string(string_to_number(date_to_string(now(), \\\"MM\\\")) + 1, \\\"00\\\") and 'ReportingPeriod_Month' < \\\"13\\\"\"}"]},"trend_amount_pct":{"broadcastFacet":true,"groups":[],"label":"trend_amount_pct","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = foreach q generate\n'OppId' as 'OppId',\n'OwnerName' as 'OwnerName',\n'ForecastCategoryName' as 'ForecastCategoryName',\n'StageName' as 'StageName',\n'SnapShotDate_Year' as 'SnapShotDate_Year',\n'SnapShotDate_Month' as 'SnapShotDate_Month',\n'SnapShotDate_Day' as 'SnapShotDate_Day',\n'Amount' as 'Amount',\ncase\n  when 'StageName' == \"Closed Won\" or 'StageName' == \"Closed Lost\" or 'StageName' == \"Closed Quote\" then \"Closed\"\n  when 'ForecastCategoryName' == \"Omitted\" then \"Omitted\"\n  when 'ForecastCategoryName' == \"Pipeline\" then \"Pipeline\"\n  when 'ForecastCategoryName' == \"Best Case\" then \"Best Case\"\n  when 'ForecastCategoryName' == \"Commit\" then \"Commit\"\n  else \"Other\"\nend as 'EndBucketCandidate';\nq = filter q by ('ForecastCategoryName' in [\"Pipeline\",\"Best Case\",\"Commit\",\"Omitted\"] or 'EndBucketCandidate' == \"Closed\");\nq = order q by ('OppId' asc, 'SnapShotDate_Year' asc, 'SnapShotDate_Month' asc, 'SnapShotDate_Day' asc);\ng = group q by 'OppId';\ng = foreach g generate\nfirst('OppId') as 'OppId',\nfirst('OwnerName') as 'OwnerName',\nfirst('ForecastCategoryName') as 'StartBucket',\nlast('EndBucketCandidate') as 'EndBucket',\nfirst('Amount') as 'StartAmount',\nlast('Amount') as 'EndAmount';\ng = filter g by 'StartBucket' in [\"Pipeline\",\"Best Case\",\"Commit\"];\nh = foreach g generate\n'StartBucket' as 'StartBucket',\n'StartAmount' as 'TotalAmount',\ncase when 'EndBucket' == \"Omitted\" then 'StartAmount' else 0 end as 'OmittedAmount',\ncase when 'EndBucket' == \"Closed\" then 'StartAmount' else 0 end as 'ClosedAmount',\ncase when 'EndBucket' == \"Pipeline\" then 'StartAmount' else 0 end as 'PipelineAmount',\ncase when 'EndBucket' == \"Best Case\" then 'StartAmount' else 0 end as 'BestCaseAmount',\ncase when 'EndBucket' == \"Commit\" then 'StartAmount' else 0 end as 'CommitAmount';\nh = group h by 'StartBucket';\nh = foreach h generate\n'StartBucket' as 'StartBucket',\nsum('TotalAmount') as 'Total',\ncase when sum('TotalAmount') == 0 then 0 else sum('OmittedAmount') / sum('TotalAmount') end as 'Omitted',\ncase when sum('TotalAmount') == 0 then 0 else sum('ClosedAmount') / sum('TotalAmount') end as 'Closed',\ncase when sum('TotalAmount') == 0 then 0 else sum('PipelineAmount') / sum('TotalAmount') end as 'Pipeline',\ncase when sum('TotalAmount') == 0 then 0 else sum('BestCaseAmount') / sum('TotalAmount') end as 'BestCase',\ncase when sum('TotalAmount') == 0 then 0 else sum('CommitAmount') / sum('TotalAmount') end as 'Commit';\nh = order h by ('StartBucket' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"trend_count_raw":{"broadcastFacet":true,"groups":[],"label":"trend_count_raw","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = foreach q generate\n'OppId' as 'OppId',\n'OwnerName' as 'OwnerName',\n'ForecastCategoryName' as 'ForecastCategoryName',\n'StageName' as 'StageName',\n'SnapShotDate_Year' as 'SnapShotDate_Year',\n'SnapShotDate_Month' as 'SnapShotDate_Month',\n'SnapShotDate_Day' as 'SnapShotDate_Day',\n'Amount' as 'Amount',\ncase\n  when 'StageName' == \"Closed Won\" or 'StageName' == \"Closed Lost\" or 'StageName' == \"Closed Quote\" then \"Closed\"\n  when 'ForecastCategoryName' == \"Omitted\" then \"Omitted\"\n  when 'ForecastCategoryName' == \"Pipeline\" then \"Pipeline\"\n  when 'ForecastCategoryName' == \"Best Case\" then \"Best Case\"\n  when 'ForecastCategoryName' == \"Commit\" then \"Commit\"\n  else \"Other\"\nend as 'EndBucketCandidate';\nq = filter q by ('ForecastCategoryName' in [\"Pipeline\",\"Best Case\",\"Commit\",\"Omitted\"] or 'EndBucketCandidate' == \"Closed\");\nq = order q by ('OppId' asc, 'SnapShotDate_Year' asc, 'SnapShotDate_Month' asc, 'SnapShotDate_Day' asc);\ng = group q by 'OppId';\ng = foreach g generate\nfirst('OppId') as 'OppId',\nfirst('OwnerName') as 'OwnerName',\nfirst('ForecastCategoryName') as 'StartBucket',\nlast('EndBucketCandidate') as 'EndBucket',\nfirst('Amount') as 'StartAmount',\nlast('Amount') as 'EndAmount';\ng = filter g by 'StartBucket' in [\"Pipeline\",\"Best Case\",\"Commit\"];\nh = foreach g generate\n'StartBucket' as 'StartBucket',\n1 as 'Total',\ncase when 'EndBucket' == \"Omitted\" then 1 else 0 end as 'Omitted',\ncase when 'EndBucket' == \"Closed\" then 1 else 0 end as 'Closed',\ncase when 'EndBucket' == \"Pipeline\" then 1 else 0 end as 'Pipeline',\ncase when 'EndBucket' == \"Best Case\" then 1 else 0 end as 'BestCase',\ncase when 'EndBucket' == \"Commit\" then 1 else 0 end as 'Commit';\nh = group h by 'StartBucket';\nh = foreach h generate\n'StartBucket' as 'StartBucket',\nsum('Total') as 'Total',\nsum('Omitted') as 'Omitted',\nsum('Closed') as 'Closed',\nsum('Pipeline') as 'Pipeline',\nsum('BestCase') as 'BestCase',\nsum('Commit') as 'Commit';\nh = order h by ('StartBucket' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"Weight_Selec