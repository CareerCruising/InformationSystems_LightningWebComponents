.result, 0, \"Value\")).asString()}};\n t = filter t by 'Type' == \"New Sales\";\n t = filter t by 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\";\n t = group t by all;\n t = foreach t generate sum('Target') as 'Quota', 0 as 'Closed', 0 as 'CommitRaw', 0 as 'BestCaseRaw', 0 as 'PipelineRaw', 0 as 'AdditionalRaw';\n b = load \"MetricTargets\";\n b = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n b = filter b by 'Type' == \"BDR New Sales Contribution\";\n b = filter b by {{coalesce(cell(Need_By_v2_1.selection, 0, \"Value\"), cell(Need_By_v2_1.result, 0, \"Value\")).asString()}};\n b = filter b by 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\";\n b = group b by all;\n b = foreach b generate 0 as 'Quota', 0 as 'Closed', 0 as 'CommitRaw', 0 as 'BestCaseRaw', 0 as 'PipelineRaw', sum('Target') as 'AdditionalRaw';\n r = load \"MetricOpenPipe_Results_Weekly_Stage\";\n r = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n r = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n r = filter r by 'Type' == \"New Sales\";\n r = filter r by 'StageName' == \"Closed Won\";\n r = filter r by 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\";\n r = group r by all;\n r = foreach r generate 0 as 'Quota', sum('Amount') as 'Closed', 0 as 'CommitRaw', 0 as 'BestCaseRaw', 0 as 'PipelineRaw', 0 as 'AdditionalRaw';\n o = load \"MetricOpenPipe_Results_Weekly_Stage\";\n o = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n o = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n o = filter o by 'Type' == \"New Sales\";\n o = filter o by 'StageNameSource' == \"Source: OpenPipe\";\n o = filter o by 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\";\n o = foreach o generate 0 as 'Quota', 0 as 'Closed', case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitRaw', case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseRaw', case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineRaw', 0 as 'AdditionalRaw';\n o = group o by all;\n o = foreach o generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw', sum('AdditionalRaw') as 'AdditionalRaw';\n u0 = union t,b,r,o;\n g = group u0 by all;\n g = foreach g generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw', sum('AdditionalRaw') as 'AdditionalRaw';\n a = foreach g generate \"Commit\" as 'Metric', ('CommitRaw' * 0.89) as 'StdForecasted', ('CommitRaw' * {{coalesce(cell(Weight_Selector_10.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) as 'ManualForecasted', 1 as 'SortOrder';\n b1 = foreach g generate \"Best Case\" as 'Metric', ('BestCaseRaw' * 0.40) as 'StdForecasted', ('BestCaseRaw' * {{coalesce(cell(Weight_Selector_11.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'ManualForecasted', 2 as 'SortOrder';\n c = foreach g generate \"Pipeline\" as 'Metric', ('PipelineRaw' * 0.22) as 'StdForecasted', ('PipelineRaw' * {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'ManualForecasted', 3 as 'SortOrder';\n d = foreach g generate \"Gap2Quota\" as 'Metric', ('Quota' - 'Closed' - ('CommitRaw' * 0.89) - ('BestCaseRaw' * 0.40) - ('PipelineRaw' * 0.22) - ('AdditionalRaw' * 0.22)) as 'StdForecasted', ('Quota' - 'Closed' - ('CommitRaw' * {{coalesce(cell(Weight_Selector_10.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - ('BestCaseRaw' * {{coalesce(cell(Weight_Selector_11.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - ('PipelineRaw' * {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) - ('AdditionalRaw' * {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'ManualForecasted', 4 as 'SortOrder';\n u = union a,b1,c,d;\n u = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"columnProperties":{},"columns":["Metric","StdForecasted","ManualForecasted"],"customBulkActions":[],"header":{"backgroundColor":"#000000","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":false,"verticalPadding":8},"type":"table"}},"trend_count_pct":{"broadcastFacet":true,"groups":[],"label":"trend_count_pct","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = foreach q generate\n'OppId' as 'OppId',\n'OwnerName' as 'OwnerName',\n'ForecastCategoryName' as 'ForecastCategoryName',\n'StageName' as 'StageName',\n'SnapShotDate_Year' as 'SnapShotDate_Year',\n'SnapShotDate_Month' as 'SnapShotDate_Month',\n'SnapShotDate_Day' as 'SnapShotDate_Day',\n'Amount' as 'Amount',\ncase\n  when 'StageName' == \"Closed Won\" or 'StageName' == \"Closed Lost\" or 'StageName' == \"Closed Quote\" then \"Closed\"\n  when 'ForecastCategoryName' == \"Omitted\" then \"Omitted\"\n  when 'ForecastCategoryName' == \"Pipeline\" then \"Pipeline\"\n  when 'ForecastCategoryName' == \"Best Case\" then \"Best Case\"\n  when 'ForecastCategoryName' == \"Commit\" then \"Commit\"\n  else \"Other\"\nend as 'EndBucketCandidate';\nq = filter q by ('ForecastCategoryName' in [\"Pipeline\",\"Best Case\",\"Commit\",\"Omitted\"] or 'EndBucketCandidate' == \"Closed\");\nq = order q by ('OppId' asc, 'SnapShotDate_Year' asc, 'SnapShotDate_Month' asc, 'SnapShotDate_Day' asc);\ng = group q by 'OppId';\ng = foreach g generate\nfirst('OppId') as 'OppId',\nfirst('OwnerName') as 'OwnerName',\nfirst('ForecastCategoryName') as 'StartBucket',\nlast('EndBucketCandidate') as 'EndBucket',\nfirst('Amount') as 'StartAmount',\nlast('Amount') as 'EndAmount';\ng = filter g by 'StartBucket' in [\"Pipeline\",\"Best Case\",\"Commit\"];\nh = foreach g generate\n'StartBucket' as 'StartBucket',\n1 as 'TotalCount',\ncase when 'EndBucket' == \"Omitted\" then 1 else 0 end as 'OmittedCount',\ncase when 'EndBucket' == \"Closed\" then 1 else 0 end as 'ClosedCount',\ncase when 'EndBucket' == \"Pipeline\" then 1 else 0 end as 'PipelineCount',\ncase when 'EndBucket' == \"Best Case\" then 1 else 0 end as 'BestCaseCount',\ncase when 'EndBucket' == \"Commit\" then 1 else 0 end as 'CommitCount';\nh = group h by 'StartBucket';\nh = foreach h generate\n'StartBucket' as 'StartBucket',\nsum('TotalCount') as 'Total',\ncase when sum('TotalCount') == 0 then 0 else sum('OmittedCount') / sum('TotalCount') end as 'Omitted',\ncase when sum('TotalCount') == 0 then 0 else sum('ClosedCount') / sum('TotalCount') end as 'Closed',\ncase when sum('TotalCount') == 0 then 0 else sum('PipelineCount') / sum('TotalCount') end as 'Pipeline',\ncase when sum('TotalCount') == 0 then 0 else sum('BestCaseCount') / sum('TotalCount') end as 'BestCase',\ncase when sum('TotalCount') == 0 then 0 else sum('CommitCount') / sum('TotalCount') end as 'Commit';\nh = order h by ('StartBucket' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"trend_owner_amount":{"broadcastFacet":true,"groups":[],"label":"trend_owner_amount","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = foreach q generate\n'OppId' as 'OppId',\n'OwnerName' as 'OwnerName',\n'ForecastCategoryName' as 'ForecastCategoryName',\n'StageName' as 'StageName',\n'SnapShotDate_Year' as 'SnapShotDate_Year',\n'SnapShotDate_Month' as 'SnapShotDate_Month',\n'SnapShotDate_Day' as 'SnapShotDate_Day',\n'Amount' as 'Amount',\ncase\n  when 'StageName' == \"Closed Won\" or 'StageName' == \"Closed Lost\" or 'StageName' == \"Closed Quote\" then \"Closed\"\n  when 'ForecastCategoryName' == \"Omitted\" then \"Omitted\"\n  when 'ForecastCategoryName' == \"Pipeline\" then \"Pipeline\"\n  when 'ForecastCategoryName' == \"Best Case\" then \"Best Case\"\n  when 'ForecastCategoryName' == \"Commit\" then \"Commit\"\n  else \"Other\"\nend as 'EndBucketCandidate';\nq = filter q by ('ForecastCategoryName' in [\"Pipeline\",\"Best Case\",\"Commit\",\"Omitted\"] or 'EndBucketCandidate' == \"Closed\");\nq = order q by ('OppId' asc, 'SnapShotDate_Year' asc, 'SnapShotDate_Month' asc, 'SnapShotDate_Day' asc);\ng = group q by 'OppId';\ng = foreach g generate\nfirst('OppId') as 'OppId',\nfirst('OwnerName') as 'OwnerName',\nfirst('ForecastCategoryName') as 'StartBucket',\nlast('EndBucketCandidate') as 'EndBucket',\nfirst('Amount') as 'StartAmount',\nlast('Amount') as 'EndAmount';\ng = filter g by 'StartBucket' in [\"Pipeline\",\"Best Case\",\"Commit\"];\nh = foreach g generate\n'OwnerName' as 'OwnerName',\n'EndBucket' as 'Bucket',\n'EndAmount' as 'Amount';\nh = group h by ('OwnerName', 'Bucket');\nh = foreach h generate 'OwnerName' as 'OwnerName', 'Bucket' as 'Bucket', sum('Amount') as 'Amount';\nh = order h by 'Amount' desc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"weightedQuarterSelector":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Reporting Period Quarter","selectMode":"multi","start":"{\"Display\":[\"All\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"Q1 2026\",\"Value\":\"'ReportingPeriod_Year' == \\\"2026\\\" and 'ReportingPeriod_Month' >= \\\"01\\\" and 'ReportingPeriod_Month' < \\\"04\\\"\"}","{\"Display\":\"Q2 2026\",\"Value\":\"'ReportingPeriod_Year' == \\\"2026\\\" and 'ReportingPeriod_Month' >= \\\"04\\\" and 'ReportingPeriod_Month' < \\\"07\\\"\"}","{\"Display\":\"Q3 2026\",\"Value\":\"'ReportingPeriod_Year' == \\\"2026\\\" and 'ReportingPeriod_Month' >= \\\"07\\\" and 'ReportingPeriod_Month' < \\\"10\\\"\"}","{\"Display\":\"Q4 2026\",\"Value\":\"'ReportingPeriod_Year' == \\\"2026\\\" and 'ReportingPeriod_Month' >= \\\"10\\\" and 'ReportingPeriod_Month' < \\\"13\\\"\"}","{\"Display\":\"All\",\"Value\":\"'ReportingPeriod_Year' == \\\"2026\\\"\"}"]},"trend_totals":{"broadcastFacet":true,"groups":[],"label":"trend_totals","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = foreach q generate\n'OppId' as 'OppId',\n'OwnerName' as 'OwnerName',\n'ForecastCategoryName' as 'ForecastCategoryName',\n'StageName' as 'StageName',\n'SnapShotDate_Year' as 'SnapShotDate_Year',\n'SnapShotDate_Month' as 'SnapShotDate_Month',\n'SnapShotDate_Day' as 'SnapShotDate_Day',\n'Amount' as 'Amount',\ncase\n  when 'StageName' == \"Closed Won\" or 'StageName' == \"Closed Lost\" or 'StageName' == \"Closed Quote\" then \"Closed\"\n  when 'ForecastCategoryName' == \"Omitted\" then \"Omitted\"\n  when 'ForecastCategoryName' == \"Pipeline\" then \"Pipeline\"\n  when 'ForecastCategoryName' == \"Best Case\" then \"Best Case\"\n  when 'ForecastCategoryName' == \"Commit\" then \"Commit\"\n  else \"Other\"\nend as 'EndBucketCandidate';\nq = filter q by ('ForecastCategoryName' in [\"Pipeline\",\"Best Case\",\"Commit\",\"Omitted\"] or 'EndBucketCandidate' == \"Closed\");\nq = order q by ('OppId' asc, 'SnapShotDate_Year' asc, 'SnapShotDate_Month' asc, 'SnapShotDate_Day' asc);\ng = group q by 'OppId';\ng = foreach g generate\nfirst('OppId') as 'OppId',\nfirst('OwnerName') as 'OwnerName',\nfirst('ForecastCategoryName') as 'StartBucket',\nlast('EndBucketCandidate') as 'EndBucket',\nfirst('Amount') as 'StartAmount',\nlast('Amount') as 'EndAmount';\ng = filter g by 'StartBucket' in [\"Pipeline\",\"Best Case\",\"Commit\"];\nh = group g by all;\nh = foreach h generate sum('EndAmount') as 'Amount', count() as 'OppCount';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"quotaPeriodSelector_v2":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Quota Period v2","selectMode":"singlerequired","start":"{\"Display\":[\"Full Year\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"H1\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= \\\"01\\\" and 'ReportingPeriod_Month' < \\\"07\\\"\"}","{\"Display\":\"Full Year\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= \\\"01\\\" and 'ReportingPeriod_Month' < \\\"13\\\"\"}"]},"weightedPipelineAvg":{"broadcastFacet":false,"groups":[],"label":"Weighted Pipeline Avg","numbers":[],"query":"q = load \"MetricTargets\";\nq = group q by all;\nq = foreach q generate ((({{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) + ({{coalesce(cell(Weight_Selector_6.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) + ({{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) + ({{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) / 4) * 100 as 'AvgPct';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false},"page1_table_1":{"broadcastFacet":true,"groups":[],"label":"page1_table_1","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(needBySelector_v2.selection, 0, \"Value\"), cell(needBySelector_v2.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * 0.8) as 'AdditionalPipeRaw';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitAmt',\n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('CommitAmt') as 'CommitAmt', sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) as 'Commit',\n    ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n    (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'AdditionalPipe',\n    (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota';\n\na = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total';\nb1 = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total';\nc = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total';\nd = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total';\ne = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total';\nf = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total';\nu = union a, b1, c, d, e, f;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"Quota_Period_2":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Quota Period","selectMode":"singlerequired","start":"{\"Display\":[\"Full Year\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"H1\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= \\\"01\\\" and 'ReportingPeriod_Month' < \\\"07\\\"\"}","{\"Display\":\"H2\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= \\\"07\\\" and 'ReportingPeriod_Month' < \\\"13\\\"\"}","{\"Display\":\"Full Year\",\"Value\":\"'ReportingPeriod_Year' == date_to_string(now(), \\\"yyyy\\\") and 'ReportingPeriod_Month' >= \\\"01\\\" and 'ReportingPeriod_Month' < \\\"13\\\"\"}"]},"trend_owner_bucket_summary":{"broadcastFacet":true,"groups":[],"label":"trend_owner_bucket_summary","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = foreach q generate\n'OppId' as 'OppId',\n'OwnerName' as 'OwnerName',\n'ForecastCategoryName' as 'ForecastCategoryName',\n'StageName' as 'StageName',\n'SnapShotDate_Year' as 'SnapShotDate_Year',\n'SnapShotDate_Month' as 'SnapShotDate_Month',\n'SnapShotDate_Day' as 'SnapShotDate_Day',\n'Amount' as 'Amount',\ncase\n  when 'StageName' == \"Closed Won\" or 'StageName' == \"Closed Lost\" or 'StageName' == \"Closed Quote\" then \"Closed\"\n  when 'ForecastCategoryName' == \"Omitted\" then \"Omitted\"\n  when 'ForecastCategoryName' == \"Pipeline\" then \"Pipeline\"\n  when 'ForecastCategoryName' == \"Best Case\" then \"Best Case\"\n  when 'ForecastCategoryName' == \"Commit\" then \"Commit\"\n  else \"Other\"\nend as 'EndBucketCandidate';\nq = filter q by ('ForecastCategoryName' in [\"Pipeline\",\"Best Case\",\"Commit\",\"Omitted\"] or 'EndBucketCandidate' == \"Closed\");\nq = order q by ('OppId' asc, 'SnapShotDate_Year' asc, 'SnapShotDate_Month' asc, 'SnapShotDate_Day' asc);\ng = group q by 'OppId';\ng = foreach g generate\nfirst('OppId') as 'OppId',\nfirst('OwnerName') as 'OwnerName',\nfirst('ForecastCategoryName') as 'StartBucket',\nlast('EndBucketCandidate') as 'EndBucket',\nfirst('Amount') as 'StartAmount',\nlast('Amount') as 'EndAmount';\ng = filter g by 'StartBucket' in [\"Pipeline\",\"Best Case\",\"Commit\"];\nh = foreach g generate 'OwnerName' as 'OwnerName', 'StartBucket' as 'StartBucket', 'EndBucket' as 'EndBucket', 'StartAmount' as 'Amount';\nh = order h by ('OwnerName' asc, 'Amount' desc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"page1_table_current":{"broadcastFacet":true,"groups":[],"label":"page1_table_current","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitAmt',\n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('CommitAmt') as 'CommitAmt', sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    sum(r.'ClosedAmt') as 'Closed',\n    sum(o.'CommitAmt') as 'Commit',\n    sum(o.'BestCaseAmt') as 'BestCase',\n    sum(o.'PipelineAmt') as 'Pipeline',\n    (sum(t.'Quota') - sum(r.'ClosedAmt') - (sum(o.'CommitAmt') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota';\n\na = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total';\nb = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total';\nc = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total';\nd = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total';\ne = foreach g generate \"Pipeline\" as 'Category', 'Pipeline' as 'Total';\nf = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total';\nu = union a, b, c, d, e, f;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#7D98B3","borderEdges":["all"],"borderRadius":4,"borderWidth":1},"widgets":{"text_14":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"24px","color":"#ffffff","bold":true},"insert":"Weighted Predicted Gap2Quota"},{"attributes":{"align":"center"},"insert":"\n"}]},"showActionMenu":true},"type":"text"},"text_13":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#ffffff"},"insert":"Pipeline Weighting"},{"attributes":{"align":"center"},"insert":"\n"}]},"showActionMenu":true},"type":"text"},"text_10":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#ffffff"},"insert":"Pipeline → Commit"},{"attributes":{"align":"center"},"insert":"\n"}]},"showActionMenu":true},"type":"text"},"text_12":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#ffffff"},"insert":"Best Case Weighting"},{"attributes":{"align":"center"},"insert":"\n"}]},"showActionMenu":true},"type":"text"},"text_11":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#ffffff"},"insert":"Pipeline → Best Case"},{"attributes":{"align":"center"},"insert":"\n"}]},"showActionMenu":true},"type":"text"},"text_3":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"24px"},"insert":"Predictive Forecast"},{"attributes":{"align":"left"},"insert":"\n"}]},"showActionMenu":true},"type":"text"},"chart_5":{"parameters":{"totalValue":"useLastBucket","autoFitMode":"keepLabels","showValues":true,"positiveColor":"#1674D9","legend":{"descOrder":fal