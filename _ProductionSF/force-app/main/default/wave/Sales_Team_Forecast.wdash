t_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'Pipeline', 0 as 'AdditionalPipe';\n o = group o by all;\n o = foreach o generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\n u0 = union t, b, r, o;\n g = group u0 by all;\n g = foreach g generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe', (sum('Quota') - sum('Closed') - sum('Commit') - sum('BestCase') - sum('Pipeline') - sum('AdditionalPipe')) as 'GapToQuota', case when sum('Quota') == 0 then 0 else ((sum('Quota') - sum('Closed') - sum('Commit') - sum('BestCase') - sum('Pipeline') - sum('AdditionalPipe')) / sum('Quota')) end as 'PctToQuota';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_summary_12":{"broadcastFacet":true,"groups":[],"label":"kpi1_summary","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(needBySelector_v2.selection, 0, \"Value\"), cell(needBySelector_v2.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * 0.8) as 'AdditionalPipeRaw';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitAmt',\n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('CommitAmt') as 'CommitAmt', sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) as 'Commit',\n    ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n    (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'AdditionalPipe',\n    (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota',\n    case when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) / sum(t.'Quota')) end as 'PctToQuota';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_owner_2":{"broadcastFacet":true,"groups":[],"label":"kpi1_owner","numbers":[],"query":"qbase = load \"MetricTargets\";\nqbase = filter qbase by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nqbase = filter qbase by 'Type' == \"New Sales\";\nqbase = filter qbase by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nqbase = filter qbase by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\nqbase = group qbase by ('OwnerName', 'TerritoryGroup');\nqbase = foreach qbase generate 'OwnerName' as 'OwnerName', 'TerritoryGroup' as 'TerritoryGroup', sum('Target') as 'OwnerQuota';\n\nqsrc = group qbase by 'OwnerName';\nqsrc = foreach qsrc generate 'OwnerName' as 'OwnerName', sum('OwnerQuota') as 'Quota', 0 as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n\nqterr = group qbase by 'TerritoryGroup';\nqterr = foreach qterr generate 'TerritoryGroup' as 'TerritoryGroup', sum('OwnerQuota') as 'TerritoryQuota';\n\nbterr = load \"MetricTargets\";\nbterr = filter bterr by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nbterr = filter bterr by 'Type' == \"BDR New Sales Contribution\";\nbterr = filter bterr by {{coalesce(cell(Need_By_v2_1.selection, 0, \"Value\"), cell(Need_By_v2_1.result, 0, \"Value\")).asString()}};\nbterr = filter bterr by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\nbterr = foreach bterr generate 'TerritoryGroup' as 'TerritoryGroup', ('Target' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_6.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) as 'AdditionalPipeTerr';\nbterr = group bterr by 'TerritoryGroup';\nbterr = foreach bterr generate 'TerritoryGroup' as 'TerritoryGroup', sum('AdditionalPipeTerr') as 'AdditionalPipeTerr';\n\nbmap = cogroup qbase by 'TerritoryGroup' left, qterr by 'TerritoryGroup', bterr by 'TerritoryGroup';\nbmap = foreach bmap generate \n  first(qbase.'OwnerName') as 'OwnerName',\n  0 as 'Quota',\n  0 as 'Closed',\n  0 as 'Commit',\n  0 as 'BestCase',\n  0 as 'Pipeline',\n  case when count(bterr) == 0 then 0 when sum(qbase.'OwnerQuota') == 0 then 0 when first(qterr.'TerritoryQuota') == 0 then 0 else (sum(qbase.'OwnerQuota') / first(qterr.'TerritoryQuota')) * sum(bterr.'AdditionalPipeTerr') end as 'AdditionalPipe';\nbmap = group bmap by 'OwnerName';\nbmap = foreach bmap generate 'OwnerName' as 'OwnerName', 0 as 'Quota', 0 as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nr = filter r by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\nr = group r by 'OwnerName';\nr = foreach r generate 'OwnerName' as 'OwnerName', 0 as 'Quota', coalesce(sum('Amount'),0) as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageNameSource' == \"Source: OpenPipe\";\no = filter o by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\no = filter o by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\no = foreach o generate\n  'OwnerName' as 'OwnerName',\n  0 as 'Quota',\n  0 as 'Closed',\n  case when 'ForecastCategoryName' == \"Commit\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_4.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_9.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_10.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'Commit',\n  case when 'ForecastCategoryName' == \"Best Case\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_7.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_5.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_11.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'BestCase',\n  case when 'ForecastCategoryName' == \"Pipeline\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_6.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'Pipeline',\n  0 as 'AdditionalPipe';\no = group o by 'OwnerName';\no = foreach o generate 'OwnerName' as 'OwnerName', sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\n\nu0 = union qsrc, bmap, r, o;\nu0 = group u0 by 'OwnerName';\nu0 = foreach u0 generate 'OwnerName' as 'OwnerName', sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\nu0 = cogroup qsrc by 'OwnerName' left, u0 by 'OwnerName';\nu0 = foreach u0 generate first(qsrc.'OwnerName') as 'OwnerName', sum(u0.'Quota') as 'Quota', sum(u0.'Closed') as 'Closed', sum(u0.'Commit') as 'Commit', sum(u0.'BestCase') as 'BestCase', sum(u0.'Pipeline') as 'Pipeline', sum(u0.'AdditionalPipe') as 'AdditionalPipe';\nu0 = foreach u0 generate 'OwnerName' as 'OwnerName', 'Quota' as 'Quota', 'Closed' as 'Closed', 'Commit' as 'Commit', 'BestCase' as 'BestCase', 'Pipeline' as 'Pipeline', 'AdditionalPipe' as 'AdditionalPipe', ('Quota' - 'Closed' - 'Commit' - 'BestCase' - 'Pipeline' - 'AdditionalPipe') as 'GapToQuota';\nu0 = foreach u0 generate 'OwnerName' as 'OwnerName', 'Quota' as 'Quota', 'Closed' as 'Closed', 'Commit' as 'Commit', 'BestCase' as 'BestCase', 'Pipeline' as 'Pipeline', 'AdditionalPipe' as 'AdditionalPipe', 'GapToQuota' as 'GapToQuota', case when 'Quota' == 0 then 0 else ('GapToQuota' / 'Quota') end as 'PctToQuota';\nteam = group u0 by all;\nteam = foreach team generate \"TEAM\" as 'OwnerName', sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe', sum('GapToQuota') as 'GapToQuota', case when sum('Quota') == 0 then 0 else (sum('GapToQuota') / sum('Quota')) end as 'PctToQuota';\nu = union team, u0;\nu = foreach u generate 'OwnerName' as 'OwnerName', 'Quota' as 'Quota', 'Closed' as 'Closed', 'Commit' as 'Commit', 'BestCase' as 'BestCase', 'Pipeline' as 'Pipeline', 'AdditionalPipe' as 'AdditionalPipe', 'GapToQuota' as 'GapToQuota', 'PctToQuota' as 'PctToQuota', case when 'OwnerName' == \"TEAM\" then 0 else 1 end as 'SortOrder';\nu = order u by ('SortOrder' asc, 'GapToQuota' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_waterfall":{"broadcastFacet":true,"groups":[],"label":"kpi1_waterfall","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(needBySelector_v2.selection, 0, \"Value\"), cell(needBySelector_v2.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * 0.8) as 'AdditionalPipeRaw';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current year\"..\"current year\"];\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitAmt',\n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('CommitAmt') as 'CommitAmt', sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) as 'Commit',\n    ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n    (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'AdditionalPipe',\n    (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota',\n    case when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) / sum(t.'Quota')) end as 'PctToQuota';\n\na = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total', 1 as 'SortOrder';\nb1 = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total', 2 as 'SortOrder';\nc = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total', 3 as 'SortOrder';\nd = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total', 4 as 'SortOrder';\ne = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total', 5 as 'SortOrder';\nf = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total', 6 as 'SortOrder';\nu = union a, b1, c, d, e, f;\nu = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","totalValue":"useLastBucket","showValues":true,"positiveColor":"#4269E9","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"waterfall","title":{"fontSize":18,"subtitleFontSize":11,"label":"Predicted","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"startColor":"#1674D9","totalLabel":"Gap To Quota","columnMap":{"measureAxis1":["Total"],"trellis":[],"dimensionAxis":["Category"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"totalColor":"#1674D9","theme":"wave","negativeColor":"#00B531","dimensionAxis":{"showTitle":false,"showAxis":true,"title":""},"applyConditionalFormatting":true},"type":"chart"}},"page1_table_unweight_2":{"broadcastFacet":true,"groups":[],"label":"page1_table_unweighted","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(needBySelector_v2.selection, 0, \"Value\"), cell(needBySelector_v2.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * 0.8) as 'AdditionalPipeRaw';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'ClosedAmt';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageName' != \"Closed Won\" and 'StageName' != \"Closed Lost\" and 'StageName' != \"Closed Quote\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate \n    case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseAmt',\n    case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineAmt';\no = group o by all;\no = foreach o generate sum('BestCaseAmt') as 'BestCaseAmt', sum('PipelineAmt') as 'PipelineAmt';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate \n    sum(t.'Quota') as 'Quota',\n    (sum(r.'ClosedAmt') + ((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) as 'Closed',\n    ((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) as 'Commit',\n    (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) as 'BestCase',\n    (case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end) as 'AdditionalPipe',\n    (sum(t.'Quota') - (sum(r.'ClosedAmt') + ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) + (sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Closed_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Closed_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Closed_Wgt\")).asString()}})) - ((((sum(o.'BestCaseAmt') * {{coalesce(cell(weightSelector_BestCase_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"BestCase_to_Commit_Wgt\")).asString()}}) + (sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_Commit_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_Commit_Wgt\")).asString()}})) * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}})) - ((sum(o.'PipelineAmt') * {{coalesce(cell(weightSelector_Pipeline_to_BestCase_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi1.result, 0, \"Pipeline_to_BestCase_Wgt\")).asString()}}) * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (((case when count(b) == 0 then 0 else sum(b.'AdditionalPipeRaw') end)) * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}})) as 'GapToQuota';\n\na = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total';\nb1 = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total';\nc = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total';\nd = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total';\ne = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total';\nf = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total';\nu = union a, b1, c, d, e, f;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"page1_table_unweight_1":{"broadcastFacet":true,"groups":[],"label":"page1_table_unweighted","numbers":[],"query":" t = load \"MetricTargets\";\n t = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n t = filter t by 'Type' == \"New Sales\";\n t = filter t by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n t = group t by all;\n t = foreach t generate sum('Target') as 'Quota', 0 as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n b = load \"MetricTargets\";\n b = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n b = filter b by 'Type' == \"BDR New Sales Contribution\";\n b = filter b by {{coalesce(cell(Need_By_v2_1.selection, 0, \"Value\"), cell(Need_By_v2_1.result, 0, \"Value\")).asString()}};\n b = filter b by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n b = foreach b generate 0 as 'Quota', 0 as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', ('Target' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_6.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) as 'AdditionalPipe';\n b = group b by all;\n b = foreach b generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\n r = load \"MetricOpenPipe_Results_Weekly_Stage\";\n r = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n r = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n r = filter r by 'Type' == \"New Sales\";\n r = filter r by 'StageName' == \"Closed Won\";\n r = filter r by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n r = group r by all;\n r = foreach r generate 0 as 'Quota', sum('Amount') as 'Closed', 0 as 'Commit', 0 as 'BestCase', 0 as 'Pipeline', 0 as 'AdditionalPipe';\n o = load \"MetricOpenPipe_Results_Weekly_Stage\";\n o = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n o = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\n o = filter o by 'Type' == \"New Sales\";\n o = filter o by 'StageNameSource' == \"Source: OpenPipe\";\n o = filter o by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n o = foreach o generate 0 as 'Quota', 0 as 'Closed', case when 'ForecastCategoryName' == \"Commit\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_4.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_9.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_10.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'Commit', case when 'ForecastCategoryName' == \"Best Case\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_7.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(Weight_Selector_5.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_11.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'BestCase', case when 'ForecastCategoryName' == \"Pipeline\" then ('Amount' * case when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"01\" and 'ReportingPeriod_Month' < \"04\" then {{coalesce(cell(Weight_Selector_8.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"04\" and 'ReportingPeriod_Month' < \"07\" then {{coalesce(cell(Weight_Selector_6.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"07\" and 'ReportingPeriod_Month' < \"10\" then {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'Pipeline', 0 as 'AdditionalPipe';\n o = group o by all;\n o = foreach o generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\n u0 = union t, b, r, o;\n g = group u0 by all;\n g = foreach g generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe', (sum('Quota') - sum('Closed') - sum('Commit') - sum('BestCase') - sum('Pipeline') - sum('AdditionalPipe')) as 'GapToQuota', case when sum('Quota') == 0 then 0 else ((sum('Quota') - sum('Closed') - sum('Commit') - sum('BestCase') - sum('Pipeline') - sum('AdditionalPipe')) / sum('Quota')) end as 'PctToQuota';\na = foreach g generate \"Quota\" as 'Category', 'Quota' as 'Total', 1 as 'SortOrder';\nb1 = foreach g generate \"Closed\" as 'Category', 'Closed' as 'Total', 2 as 'SortOrder';\nc = foreach g generate \"Commit\" as 'Category', 'Commit' as 'Total', 3 as 'SortOrder';\nd = foreach g generate \"Best Case\" as 'Category', 'BestCase' as 'Total', 4 as 'SortOrder';\ne = foreach g generate \"Pipeline\" as 'Category', 'Pipeline' as 'Total', 5 as 'SortOrder';\nf = foreach g generate \"Additional Pipeline\" as 'Category', 'AdditionalPipe' as 'Total', 6 as 'SortOrder';\ng2 = foreach g generate \"Gap To Quota\" as 'Category', 'GapToQuota' as 'Total', 7 as 'SortOrder';\nu = union a,b1,c,d,e,f,g2;\nu = order u by 'SortOrder' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#000000","fontColor":"#ffffff","fontSize":14},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","mode":"fittocontainer","numberOfLines":1,"showActionMenu":false,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"weightSelector_BestCase_to_Closed_Wgt":{"broadcastFacet":false,"columns":{"Value":{"type":"string"},"Display":{"type":"string"}},"isGlobal":false,"label":"Weight Selector","selectMode":"singlerequired","start":"{\"Display\":[\"30%\"]}","type":"staticflex","useGlobal":false,"values":["{\"Display\":\"0%\",\"Value\":\"0.00\"}","{\"Display\":\"5%\",\"Value\":\"0.05\"}","{\"Display\":\"10%\",\"Value\":\"0.10\"}","{\"Display\":\"15%\",\"Value\":\"0.15\"}","{\"Display\":\"20%\",\"Value\":\"0.20\"}","{\"Display\":\"25%\",\"Value\":\"0.25\"}","{\"Display\":\"30%\",\"Value\":\"0.30\"}","{\"Display\":\"35%\",\"Value\":\"0.35\"}","{\"Display\":\"40%\",\"Value\":\"0.40\"}","{\"Display\":\"45%\",\"Value\":\"0.45\"}","{\"Display\":\"50%\",\"Value\":\"0.50\"}","{\"Display\":\"55%\",\"Value\":\"0.55\"}","{\"Display\":\"60%\",\"Value\":\"0.60\"}","{\"Display\":\"65%\",\"Value\":\"0.65\"}","{\"Display\":\"70%\",\"Value\":\"0.70\"}","{\"Display\":\"75%\",\"Value\":\"0.75\"}","{\"Display\":\"80%\",\"Value\":\"0.80\"}","{\"Display\":\"85%\",\"Value\":\"0.85\"}","{\"Display\":\"90%\",\"Value\":\"0.90\"}","{\"Display\":\"95%\",\"Value\":\"0.95\"}","{\"Display\":\"100%\",\"Value\":\"1.00\"}"]},"trend_amount_raw":{"broadcastFacet":true,"groups":[],"label":"trend_amount_raw","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = foreach q generate\n'OppId' as 'OppId',\n'OwnerName' as 'OwnerName',\n'ForecastCategoryName' as 'ForecastCategoryName',\n'StageName' as 'StageName',\n'SnapShotDate_Year' as 'SnapShotDate_Year',\n'SnapShotDate_Month' as 'SnapShotDate_Month',\n'SnapShotDate_Day' as 'SnapShotDate_Day',\n'Amount' as 'Amount',\ncase\n  when 'StageName' == \"Closed Won\" or 'StageName' == \"Closed Lost\" or 'StageName' == \"Closed Quote\" then \"Closed\"\n  when 'ForecastCategoryName' == \"Omitted\" then \"Omitted\"\n  when 'ForecastCategoryName' == \"Pipeline\" then \"Pipeline\"\n  when 'ForecastCategoryName' == \"Best Case\" then \"Best Case\"\n  when 'ForecastCategoryName' == \"Commit\" then \"Commit\"\n  else \"Other\"\nend as 'EndBucketCandidate';\nq = filter q by ('ForecastCategoryName' in [\"Pipeline\",\"Best Case\",\"Commit\",\"Omitted\"] or 'EndBucketCandidate' == \"Closed\");\nq = order q by ('OppId' asc, 'SnapShotDate_Year' asc, 'SnapShotDate_Month' asc, 'SnapShotDate_Day' asc);\ng = group q by 'OppId';\ng = foreach g generate\nfirst('OppId') as 'OppId',\nfirst('OwnerName') as 'OwnerName',\nfirst('ForecastCategoryName') as 'StartBucket',\nlast('EndBucketCandidate') as 'EndBucket',\nfirst('Amount') as 'StartAmount',\nlast('Amount') as 'EndAmount';\ng = filter g by 'StartBucket' in [\"Pipeline\",\"Best Case\",\"Commit\"];\nh = foreach g generate\n'StartBucket' as 'StartBucket',\n'StartAmount' as 'Total',\ncase when 'EndBucket' == \"Omitted\" then 'StartAmount' else 0 end as 'Omitted',\ncase when 'EndBucket' == \"Closed\" then 'StartAmount' else 0 end as 'Closed',\ncase when 'EndBucket' == \"Pipeline\" then 'StartAmount' else 0 end as 'Pipeline',\ncase when 'EndBucket' == \"Best Case\" then 'StartAmount' else 0 end as 'BestCase',\ncase when 'EndBucket' == \"Commit\" then 'StartAmount' else 0 end as 'Commit';\nh = group h by 'StartBucket';\nh = foreach h generate\n'StartBucket' as 'StartBucket',\nsum('Total') as 'Total',\nsum('Omitted') as 'Omitted',\nsum('Closed') as 'Closed',\nsum('Pipeline') as 'Pipeline',\nsum('BestCase') as 'BestCase',\nsum('Commit') as 'Commit';\nh = order h by ('StartBucket' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_summary_19":{"broadcastFacet":true,"groups":[],"label":"kpi1_summary","numbers":[],"query":" t = load \"MetricTargets\";\n t = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\n t = filter t by 'Type' == \"New Sales\";\n t = filter t by {{coalesce(cell(weightedQuarterSelector.selection, 0, \"Value\"), cell(weightedQuarterSelector.result, 0, \"Value\")).asString()}};\n t = group t by all;\n t = foreach t gener