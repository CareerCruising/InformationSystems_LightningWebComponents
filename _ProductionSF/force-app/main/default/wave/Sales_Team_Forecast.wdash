Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} when 'ReportingPeriod_Year' == \"2026\" and 'ReportingPeriod_Month' >= \"10\" and 'ReportingPeriod_Month' < \"13\" then {{coalesce(cell(Weight_Selector_20.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}} else 0 end) else 0 end as 'Pipeline', 0 as 'AdditionalPipe';\n o = group o by all;\n o = foreach o generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe';\n u0 = union t, b, r, o;\n g = group u0 by all;\n g = foreach g generate sum('Quota') as 'Quota', sum('Closed') as 'Closed', sum('Commit') as 'Commit', sum('BestCase') as 'BestCase', sum('Pipeline') as 'Pipeline', sum('AdditionalPipe') as 'AdditionalPipe', (sum('Quota') - sum('Closed') - sum('Commit') - sum('BestCase') - sum('Pipeline') - sum('AdditionalPipe')) as 'GapToQuota', case when sum('Quota') == 0 then 0 else ((sum('Quota') - sum('Closed') - sum('Commit') - sum('BestCase') - sum('Pipeline') - sum('AdditionalPipe')) / sum('Quota')) end as 'PctToQuota';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["Quota","Closed","Commit","BestCase","Pipeline","AdditionalPipe","GapToQuota","PctToQuota"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"trend_owner_count":{"broadcastFacet":true,"groups":[],"label":"trend_owner_count","numbers":[],"query":"q = load \"MetricOpenPipe_Results_Weekly_Stage\";\nq = filter q by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nq = filter q by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nq = filter q by 'Type' == \"New Sales\";\nq = filter q by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nq = foreach q generate\n'OppId' as 'OppId',\n'OwnerName' as 'OwnerName',\n'ForecastCategoryName' as 'ForecastCategoryName',\n'StageName' as 'StageName',\n'SnapShotDate_Year' as 'SnapShotDate_Year',\n'SnapShotDate_Month' as 'SnapShotDate_Month',\n'SnapShotDate_Day' as 'SnapShotDate_Day',\n'Amount' as 'Amount',\ncase\n  when 'StageName' == \"Closed Won\" or 'StageName' == \"Closed Lost\" or 'StageName' == \"Closed Quote\" then \"Closed\"\n  when 'ForecastCategoryName' == \"Omitted\" then \"Omitted\"\n  when 'ForecastCategoryName' == \"Pipeline\" then \"Pipeline\"\n  when 'ForecastCategoryName' == \"Best Case\" then \"Best Case\"\n  when 'ForecastCategoryName' == \"Commit\" then \"Commit\"\n  else \"Other\"\nend as 'EndBucketCandidate';\nq = filter q by ('ForecastCategoryName' in [\"Pipeline\",\"Best Case\",\"Commit\",\"Omitted\"] or 'EndBucketCandidate' == \"Closed\");\nq = order q by ('OppId' asc, 'SnapShotDate_Year' asc, 'SnapShotDate_Month' asc, 'SnapShotDate_Day' asc);\ng = group q by 'OppId';\ng = foreach g generate\nfirst('OppId') as 'OppId',\nfirst('OwnerName') as 'OwnerName',\nfirst('ForecastCategoryName') as 'StartBucket',\nlast('EndBucketCandidate') as 'EndBucket',\nfirst('Amount') as 'StartAmount',\nlast('Amount') as 'EndAmount';\ng = filter g by 'StartBucket' in [\"Pipeline\",\"Best Case\",\"Commit\"];\nh = foreach g generate\n'OwnerName' as 'OwnerName',\n'EndBucket' as 'Bucket',\n1 as 'OppCount';\nh = group h by ('OwnerName', 'Bucket');\nh = foreach h generate 'OwnerName' as 'OwnerName', 'Bucket' as 'Bucket', sum('OppCount') as 'OppCount';\nh = order h by 'OppCount' desc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true},"kpi1_summary_16":{"broadcastFacet":true,"groups":[],"label":"kpi1_summary","numbers":[],"query":"t = load \"MetricTargets\";\nt = filter t by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nt = filter t by 'Type' == \"New Sales\";\nt = filter t by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nt = group t by all;\nt = foreach t generate sum('Target') as 'Quota';\n\nb = load \"MetricTargets\";\nb = filter b by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nb = filter b by 'Type' == \"BDR New Sales Contribution\";\nb = filter b by {{coalesce(cell(Need_By_v2_1.selection, 0, \"Value\"), cell(Need_By_v2_1.result, 0, \"Value\")).asString()}};\nb = group b by all;\nb = foreach b generate (sum('Target') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'AdditionalPipe';\n\nr = load \"MetricOpenPipe_Results_Weekly_Stage\";\nr = filter r by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\nr = filter r by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\nr = filter r by 'Type' == \"New Sales\";\nr = filter r by 'StageName' == \"Closed Won\";\nr = filter r by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\nr = group r by all;\nr = foreach r generate sum('Amount') as 'Closed';\n\no = load \"MetricOpenPipe_Results_Weekly_Stage\";\no = filter o by 'TerritoryGroup' in {{coalesce(cell(tgGroupSelector.selection, 0, \"Value\"), cell(tgGroupSelector.result, 0, \"Value\")).asString()}};\no = filter o by {{coalesce(cell(OppName_1.selection, 0, \"Value\"), cell(SnapshotDate_Default.result, 0, \"Value\")).asString()}};\no = filter o by 'Type' == \"New Sales\";\no = filter o by 'StageNameSource' == \"Source: OpenPipe\";\no = filter o by {{coalesce(cell(quotaPeriodSelector_v2.selection, 0, \"Value\"), cell(quotaPeriodSelector_v2.result, 0, \"Value\")).asString()}};\no = foreach o generate\n  case when 'ForecastCategoryName' == \"Commit\" then 'Amount' else 0 end as 'CommitRaw',\n  case when 'ForecastCategoryName' == \"Best Case\" then 'Amount' else 0 end as 'BestCaseRaw',\n  case when 'ForecastCategoryName' == \"Pipeline\" then 'Amount' else 0 end as 'PipelineRaw';\no = group o by all;\no = foreach o generate sum('CommitRaw') as 'CommitRaw', sum('BestCaseRaw') as 'BestCaseRaw', sum('PipelineRaw') as 'PipelineRaw';\n\ng = cogroup t by all left, b by all, r by all, o by all;\ng = foreach g generate\n  sum(t.'Quota') as 'Quota',\n  sum(r.'Closed') as 'Closed',\n  (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) as 'Commit',\n  (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) as 'BestCase',\n  (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) as 'Pipeline',\n  (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end) as 'AdditionalPipe',\n  (sum(t.'Quota') - sum(r.'Closed') - (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) as 'GapToQuota',\n  case when sum(t.'Quota') == 0 then 0 else ((sum(t.'Quota') - sum(r.'Closed') - (sum(o.'CommitRaw') * {{coalesce(cell(weightSelector_Commit_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Commit_Forecast_Wgt\")).asString()}}) - (sum(o.'BestCaseRaw') * {{coalesce(cell(weightSelector_BestCase_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"BestCase_Forecast_Wgt\")).asString()}}) - (sum(o.'PipelineRaw') * {{coalesce(cell(weightSelector_Pipeline_Forecast_Wgt.selection, 0, \"Value\"), cell(weightConfigKpi2.result, 0, \"Pipeline_Forecast_Wgt\")).asString()}}) - (case when count(b) == 0 then 0 else (case when count(b) == 0 then 0 else sum(b.'AdditionalPipe') end) end)) / sum(t.'Quota')) end as 'PctToQuota';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["Quota","Commit","BestCase","AdditionalPipe","Closed","GapToQuota","PctToQuota"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"kpi1_summary_20":{"broadcastFacet":true,"groups":[],"label":"kpi1_summary","numbers":[],"query":" t = load \"MetricTargets\";\n t = filter t by 'TerritoryGroup' in