{"dataSourceLinks":[],"filters":[],"gridLayouts":[{"name":"Default","numColumns":12,"pages":[{"label":"Gross Renewal","name":"gross-renewal-page","navigationHidden":false,"widgets":[{"colspan":12,"column":0,"name":"container_header","row":0,"rowspan":2,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D8E1EB","borderEdges":["bottom"],"borderRadius":10,"borderWidth":1}},{"colspan":12,"column":0,"name":"text_title","row":0,"rowspan":2,"widgetStyle":{"backgroundColor":"rgba(255,255,255,0)","borderEdges":[]}},{"colspan":4,"column":0,"name":"container_year","row":2,"rowspan":2,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D8E1EB","borderEdges":["all"],"borderRadius":10,"borderWidth":1}},{"colspan":4,"column":4,"name":"container_quarter","row":2,"rowspan":2,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D8E1EB","borderEdges":["all"],"borderRadius":10,"borderWidth":1}},{"colspan":4,"column":8,"name":"text_hint","row":2,"rowspan":2,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D8E1EB","borderEdges":["all"],"borderRadius":10,"borderWidth":1}},{"colspan":4,"column":0,"name":"listselector_year","row":2,"rowspan":2,"widgetStyle":{"backgroundColor":"rgba(255,255,255,0)","borderEdges":[]}},{"colspan":4,"column":4,"name":"listselector_quarter","row":2,"rowspan":2,"widgetStyle":{"backgroundColor":"rgba(255,255,255,0)","borderEdges":[]}},{"colspan":12,"column":0,"name":"container_chart","row":4,"rowspan":9,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D8E1EB","borderEdges":["all"],"borderRadius":10,"borderWidth":1}},{"colspan":12,"column":0,"name":"chart_gross_renewal","row":4,"rowspan":9,"widgetStyle":{"backgroundColor":"rgba(255,255,255,0)","borderEdges":[]}},{"colspan":12,"column":0,"name":"container_table","row":13,"rowspan":8,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D8E1EB","borderEdges":["all"],"borderRadius":10,"borderWidth":1}},{"colspan":12,"column":0,"name":"text_table_title","row":13,"rowspan":1,"widgetStyle":{"backgroundColor":"rgba(255,255,255,0)","borderEdges":[]}},{"colspan":12,"column":0,"name":"table_underlying_records","row":14,"rowspan":7,"widgetStyle":{"backgroundColor":"rgba(255,255,255,0)","borderEdges":[]}}]}],"rowHeight":"normal","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":8,"cellSpacingY":8,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"Renewal_Quarter_Chart":{"broadcastFacet":true,"groups":[],"label":"Gross Renewal by Quarter","numbers":[],"query":"seed = load \"OpportunityFull\";\nseed = group seed by all;\nseed = foreach seed generate count() as 'SeedCount';\n\nopps = load \"OpportunityFull\";\nopps = filter opps by 'Type' == \"Renewal\";\nopps = filter opps by 'Contract_Duration__c' >= 1;\nopps = filter opps by ('Acc.Demo_Type__c' is null or 'Acc.Demo_Type__c' == \"\");\nopps = foreach opps generate\n  'Renewal_Period__c_Quarter' as 'Renewal_Period__c_Quarter',\n  case when 'Renewal_Period__c_Quarter' == \"1\" then \"Q1\" when 'Renewal_Period__c_Quarter' == \"2\" then \"Q2\" when 'Renewal_Period__c_Quarter' == \"3\" then \"Q3\" else \"Q4\" end as 'Period Label',\n  case when 'Renewal_Period__c_Quarter' == \"1\" then 1 when 'Renewal_Period__c_Quarter' == \"2\" then 2 when 'Renewal_Period__c_Quarter' == \"3\" then 3 else 4 end as 'SortOrder',\n  case when 'StageName' == \"Closed Won\" then case when 'Revenue_Change_Type__c' == \"Downsell\" then ('Renewal_Expected_ARR__c' + 'Revenue_Change_Amount__c') else 'Renewal_Expected_ARR__c' end else 0 end as 'ClosedWon',\n  case when 'StageName' == \"Closed Lost\" then 'Renewal_Expected_ARR__c' else 0 end as 'ClosedLost',\n  case when 'IsClosed' == \"false\" then 'Renewal_Expected_ARR__c' else 0 end as 'OpenGR',\n  'Renewal_Expected_ARR__c' as 'ExpectedARR';\n\ndata = group opps by ('Renewal_Period__c_Quarter','Period Label','SortOrder');\ndata = foreach data generate\n  'Renewal_Period__c_Quarter' as 'Renewal_Period__c_Quarter',\n  'Period Label' as 'Period Label',\n  'SortOrder' as 'SortOrder',\n  sum('ClosedWon') as 'Closed Won',\n  sum('OpenGR') as 'Open GR Amount',\n  sum('ClosedLost') as 'Closed Lost',\n  sum('ExpectedARR') as 'Expected ARR',\n  case when sum('ExpectedARR') == 0 then 0 else (sum('ClosedWon') / sum('ExpectedARR')) * 100 end as 'Gross Renewal Rate';\n\nfy = group opps by all;\nfy = foreach fy generate\n  \"5\" as 'Renewal_Period__c_Quarter',\n  \"FY Summary\" as 'Period Label',\n  5 as 'SortOrder',\n  sum('ClosedWon') as 'Closed Won',\n  sum('OpenGR') as 'Open GR Amount',\n  sum('ClosedLost') as 'Closed Lost',\n  sum('ExpectedARR') as 'Expected ARR',\n  case when sum('ExpectedARR') == 0 then 0 else (sum('ClosedWon') / sum('ExpectedARR')) * 100 end as 'Gross Renewal Rate';\n\nq1 = foreach seed generate \"1\" as 'Renewal_Period__c_Quarter', \"Q1\" as 'Period Label', 1 as 'SortOrder', 0 as 'Closed Won', 0 as 'Open GR Amount', 0 as 'Closed Lost', 0 as 'Expected ARR', 0 as 'Gross Renewal Rate';\nq2 = foreach seed generate \"2\" as 'Renewal_Period__c_Quarter', \"Q2\" as 'Period Label', 2 as 'SortOrder', 0 as 'Closed Won', 0 as 'Open GR Amount', 0 as 'Closed Lost', 0 as 'Expected ARR', 0 as 'Gross Renewal Rate';\nq3 = foreach seed generate \"3\" as 'Renewal_Period__c_Quarter', \"Q3\" as 'Period Label', 3 as 'SortOrder', 0 as 'Closed Won', 0 as 'Open GR Amount', 0 as 'Closed Lost', 0 as 'Expected ARR', 0 as 'Gross Renewal Rate';\nq4 = foreach seed generate \"4\" as 'Renewal_Period__c_Quarter', \"Q4\" as 'Period Label', 4 as 'SortOrder', 0 as 'Closed Won', 0 as 'Open GR Amount', 0 as 'Closed Lost', 0 as 'Expected ARR', 0 as 'Gross Renewal Rate';\nq5 = foreach seed generate \"5\" as 'Renewal_Period__c_Quarter', \"FY Summary\" as 'Period Label', 5 as 'SortOrder', 0 as 'Closed Won', 0 as 'Open GR Amount', 0 as 'Closed Lost', 0 as 'Expected ARR', 0 as 'Gross Renewal Rate';\nquarters = union q1, q2, q3, q4, q5;\n\ncombined = union data, fy;\n\nresult = cogroup quarters by ('Renewal_Period__c_Quarter','Period Label','SortOrder') left, combined by ('Renewal_Period__c_Quarter','Period Label','SortOrder');\nresult = foreach result generate\n  coalesce(quarters.'Renewal_Period__c_Quarter', combined.'Renewal_Period__c_Quarter') as 'Renewal_Period__c_Quarter',\n  coalesce(quarters.'Period Label', combined.'Period Label') as 'Period Label',\n  coalesce(quarters.'SortOrder', combined.'SortOrder') as 'SortOrder',\n  case when sum(combined.'Closed Won') is null then 0 else sum(combined.'Closed Won') end as 'Closed Won',\n  case when sum(combined.'Open GR Amount') is null then 0 else sum(combined.'Open GR Amount') end as 'Open GR Amount',\n  case when sum(combined.'Closed Lost') is null then 0 else sum(combined.'Closed Lost') end as 'Closed Lost',\n  case when sum(combined.'Expected ARR') is null then 0 else sum(combined.'Expected ARR') end as 'Expected ARR',\n  case when sum(combined.'Gross Renewal Rate') is null then 0 else round(sum(combined.'Gross Renewal Rate'), 0) end as 'Gross Renewal Rate';\nresult = order result by 'SortOrder' asc;\nresult = limit result 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":true,"showValues":true,"showPoints":true,"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"top-left","inside":false},"axisMode":"dual","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"combo","missingValue":"connect","showValuesOnLine":false,"title":{"fontSize":20,"subtitleFontSize":11,"label":"Gross Renewal Analysis by Quarter","align":"center","subtitleLabel":"Renewal Period, Renewal only, real accounts only, contract duration >= 1 year"},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"plots":{"Closed Lost":{"color":"#E53935","mark":"bar"},"Closed Won":{"color":"#36C56D","mark":"bar"},"Open GR Amount":{"color":"#F9C80E","mark":"bar"},"Gross Renewal Rate":{"color":"#243B53","mark":"line"}},"columnMap":{"trellis":[],"dimensionAxis":["Period Label"],"plots":["Closed Won","Open GR Amount","Closed Lost","Gross Renewal Rate"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Gross Renewal Rate (%)","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"ARR","customDomain":{"showDomain":false}},"theme":"light","step":"Renewal_Quarter_Chart","dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Year_Selector":{"broadcastFacet":true,"datasets":[{"name":"OpportunityFull"}],"isGlobal":false,"label":"Renewal Period Year","query":{"query":"{\"measures\":[[\"count\",\"*\",\"Rows\"]],\"groups\":[\"Renewal_Period__c_Year\"],\"filters\":[[\"Type\",[\"Renewal\"],\"in\"],[\"Contract_Duration__c\",[1],\">=\"]],\"order\":[[\"Renewal_Period__c_Year\",{\"ascending\":false}]]}","version":-1.0},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"singlerequired","start":"[\"2026\"]","type":"aggregateflex","useGlobal":false,"visualizationParameters":{}},"Renewal_Record_Details":{"broadcastFacet":true,"groups":[],"label":"Underlying Renewal Opportunities","numbers":[],"query":"q = load \"OpportunityFull\";\nq = filter q by 'Type' == \"Renewal\";\nq = filter q by 'Contract_Duration__c' >= 1;\nq = filter q by ('Acc.Demo_Type__c' is null or 'Acc.Demo_Type__c' == \"\");\nq = foreach q generate\n  'Renewal_Period__c_Quarter' as 'Renewal_Period__c_Quarter',\n  case when 'Renewal_Period__c_Quarter' == \"1\" then \"Q1\" when 'Renewal_Period__c_Quarter' == \"2\" then \"Q2\" when 'Renewal_Period__c_Quarter' == \"3\" then \"Q3\" else \"Q4\" end as 'Quarter',\n  'Name' as 'Opportunity Name',\n  'Owner_Name__c' as 'Owner',\n  'StageName' as 'Stage',\n  'Renewal_Period__c' as 'Renewal Period',\n  'Renewal_Expected_ARR__c' as 'Expected ARR',\n  case when 'StageName' == \"Closed Won\" then case when 'Revenue_Change_Type__c' == \"Downsell\" then ('Renewal_Expected_ARR__c' + 'Revenue_Change_Amount__c') else 'Renewal_Expected_ARR__c' end else 0 end as 'Gross Renewal Amount',\n  case when 'IsClosed' == \"false\" then 'Renewal_Expected_ARR__c' else 0 end as 'Open GR Amount',\n  case when 'StageName' == \"Closed Lost\" then 'Renewal_Expected_ARR__c' else 0 end as 'Closed Lost Amount',\n  'Revenue_Change_Type__c' as 'Revenue Change Type',\n  'Revenue_Change_Amount__c' as 'Revenue Change Amount';\nq = order q by ('Renewal_Period__c_Quarter' asc, 'Opportunity Name' asc);\nq = limit q 200;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{"Owner":{"parameters":{"alignment":"left"},"type":"text"},"Opportunity Name":{"parameters":{"alignment":"left"},"type":"text"},"Stage":{"parameters":{"alignment":"left"},"type":"text"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":4},"type":"table"}},"Quarter_Selector":{"broadcastFacet":true,"datasets":[{"name":"OpportunityFull"}],"isGlobal":false,"label":"Renewal Period Quarter","query":{"query":"{\"measures\":[[\"count\",\"*\",\"Rows\"]],\"groups\":[\"Renewal_Period__c_Quarter\"],\"filters\":[[\"Type\",[\"Renewal\"],\"in\"],[\"Contract_Duration__c\",[1],\">=\"]],\"order\":[[\"Renewal_Period__c_Quarter\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","start":"[]","type":"aggregateflex","useGlobal":true,"visualizationParameters":{}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1},"widgets":{"text_title":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"26px","color":"#091A3E","bold":true},"insert":"Gross Renewal Analysis by Quarter"},{"attributes":{"align":"center"},"insert":"\n"},{"attributes":{"size":"14px","color":"#54698D"},"insert":"Closed Won = Gross Renewal Amount formula, Open = Renewal Expected ARR for open renewals, Closed Lost = Renewal Expected ARR"},{"attributes":{"align":"center"},"insert":"\n"}]},"showActionMenu":true},"type":"text"},"text_table_title":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"18px","color":"#091A3E","bold":true},"insert":"Underlying Opportunity Records"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#54698D"},"insert":"This table facets with the year selector, quarter selector, and chart clicks."},{"attributes":{},"insert":"\n"}]},"showActionMenu":true},"type":"text"},"chart_gross_renewal":{"parameters":{"autoFitMode":"keepLabels","stack":true,"showValues":true,"showPoints":true,"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"top-left","inside":false},"axisMode":"dual","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"combo","missingValue":"connect","showValuesOnLine":false,"exploreLink":true,"title":{"fontSize":20,"subtitleFontSize":11,"label":"Gross Renewal Analysis by Quarter","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[