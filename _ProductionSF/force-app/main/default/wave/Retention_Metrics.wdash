_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq1 = filter q1 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq1 = group q1 by all;\nq1 = foreach q1 generate count() as 'G';\n\n\nq2 = cogroup q by all, q1 by all;\nq2 = foreach q2 generate sum(q.'F')/(sum(q1.'G')+sum(q.'F')) as 'Y';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["Y"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_6_11":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"OpportunityFull\";\nq = filter q by 'StageName' == \"Closed Won\";\nq = filter q by 'Is_Retention__c' == \"true\";\nq = filter q by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq = filter q by 'Renewal_Expected_ARR__c' > 0;\nq = filter q by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq = group q by all;\nq = foreach q generate count(q) as 'F';\n\nq1 = load \"OpportunityFull\";\nq1 = filter q1 by 'StageName' == \"Closed Lost\";\nq1 = filter q1 by 'Is_Retention__c' == \"true\";\nq1 = filter q1 by 'Renewal_Expected_ARR__c' > 0;\nq1 = filter q1 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq1 = filter q1 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq1 = group q1 by all;\nq1 = foreach q1 generate count() as 'G';\n\n\nq2 = cogroup q by all, q1 by all;\nq2 = foreach q2 generate sum(q1.'G')/(sum(q1.'G')+sum(q.'F')) as 'Y';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["Y"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_6_3":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"-- To calculate the Gross Renewal Churned ($)\nh = load \"OpportunityFull\";\nh = filter h by 'Is_Retention__c' == \"true\" and 'Renewal_Expected_ARR__c' > 0 and 'StageName' == \"Closed Lost\" and date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nh = filter h by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nh = group h by all;\nh = foreach h generate sum('Renewal_Expected_ARR__c') as 'A';\n\nh1 = load \"OpportunityFull\";\nh1 = filter h1 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nh1 = filter h1 by 'StageName' == \"Closed Won\";\nh1 = filter h1 by 'Revenue_Change_Type__c' == \"Downsell\";\nh1 = filter h1 by 'Is_Retention__c' == \"true\";\nh1 = filter h1 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nh1 = group h1 by all;\nh1 = foreach h1 generate sum('Revenue_Change_Amount__c') as 'B';\n\nh2 = cogroup h by all, h1 by all;\nh2 = foreach h2 generate sum(h.'A') - sum(h1.'B') as 'C'; --< Gross Renewal Churned ($)\n\nq = load \"OpportunityFull\";\nq = filter q by 'Is_Retention__c' == \"true\";\nq = filter q by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq = filter q by (!('StageName' in [\"10N-BDR Qualified\", \"BDR Opp Rejected\", \"Closed Quote\"]) || 'StageName' is null);\nq = filter q by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq = group q by all;\nq = foreach q generate sum('Renewal_Expected_ARR__c') as 'A';\n\nq2 = cogroup h2 by all, q by all;\nq2 = foreach q2 generate (sum(q.'A') - sum(h2.'C'))/sum(q.'A') as 'Y';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["Y"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_6_2":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"--Gross Renewal Revenue Churned (%)\n\n--------------------------------------------------------------------------------------------------------------------------------------------------------\n-- Starting ARR\nq3 = load \"OpportunityFull\"; \nq3 = filter q3 by 'Is_Retention__c' == \"true\";\nq3 = filter q3 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq3 = filter q3 by (!('StageName' in [\"10N-BDR Qualified\", \"BDR Opp Rejected\", \"Closed Quote\"]) || 'StageName' is null);\nq3 = filter q3 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq3 = group q3 by all;\nq3 = foreach q3 generate sum('Renewal_Expected_ARR__c') as 'sum_Renewal_Expected_ARR__c';\n--------------------------------------------------------------------------------------------------------------------------------------------------------\n-- Gross Renewal Churned \nq = load \"OpportunityFull\"; -- All closed Lost\nq = filter q by 'Is_Retention__c' == \"true\" and 'Renewal_Expected_ARR__c' > 0 and 'StageName' == \"Closed Lost\" and date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq = filter q by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq = group q by all;\nq = foreach q generate sum('Renewal_Expected_ARR__c') as 'A';\n\nq1 = load \"OpportunityFull\"; -- Downsell in Closed Won\nq1 = filter q1 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq1 = filter q1 by 'StageName' == \"Closed Won\";\nq1 = filter q1 by 'Revenue_Change_Type__c' == \"Downsell\";\nq1 = filter q1 by 'Is_Retention__c' == \"true\";\nq1 = filter q1 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq1 = group q1 by all;\nq1 = foreach q1 generate sum('Revenue_Change_Amount__c') as 'B'; -- this is a negative number\n\nq2 = cogroup q by all, q1 by all;\nq2 = foreach q2 generate sum(q.'A') - sum(q1.'B') as 'C'; -- Gross Renewal Churned = \"All closed Lost\" + \"Downsell in Closed Won\" (since it is negative in formula we have \"-\")\n--------------------------------------------------------------------------------------------------------------------------------------------------------\n\nq4 = cogroup q3 by all, q2 by all;\nq4 = foreach q4 generate sum(q2.'C')/sum(q3.'sum_Renewal_Expected_ARR__c') as 'D'; -- Gross Renewal Revenue Churned = \"Gross Renewal Churned\" / \"Starting ARR\"\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["D"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_6_5":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q3 = load \"OpportunityFull\";\nq3 = filter q3 by 'Is_Retention__c' == \"true\";\nq3 = filter q3 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq3 = filter q3 by (!('StageName' in [\"10N-BDR Qualified\", \"BDR Opp Rejected\", \"Closed Quote\"]) || 'StageName' is null);\nq3 = filter q3 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq3 = group q3 by all;\nq3 = foreach q3 generate sum('Renewal_Expected_ARR__c') as 'A';\n\n\nq = load \"OpportunityFull\";\nq = filter q by 'StageName' == \"Closed Won\" and date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"] and 'Is_Retention__c' == \"true\";\nq = filter q by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq = group q by all;\nq = foreach q generate sum(q.'Renewal_Adjusted_ARR__c') as 'A';\n\n\nq5 = cogroup q by all, q3 by all;\nq5 = foreach q5 generate sum(q.'A')/sum(q3.'A') as 'Y';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["Y"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_6_4":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q3 = load \"OpportunityFull\";\nq3 = filter q3 by 'Is_Retention__c' == \"true\" and 'Renewal_Expected_ARR__c' > 0 and (('StageName' == \"Closed Won\" and 'Revenue_Change_Type__c' == \"Downsell\") or 'StageName' == \"Closed Lost\") and date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq3 = filter q3 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq3 = group q3 by all;\nq3 = foreach q3 generate sum('Renewal_Expected_ARR__c') as 'D';\n\nq = load \"OpportunityFull\";\nq = filter q by 'StageName' == \"Closed Won\" and date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"] and 'Is_Retention__c' == \"true\";\nq = filter q by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq = group q by all;\nq = foreach q generate sum(q.'Renewal_Adjusted_ARR__c') as 'A';\n\nq1 = load \"OpportunityFull\";\nq1 = filter q1 by 'StageName' == \"Closed Won\";\nq1 = filter q1 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq1 = filter q1 by 'Revenue_Change_Type__c' in [\"Cross-sell\", \"Price Increase\", \"Product Upgrade\", \"Student Count Increase\"];\nq1 = filter q1 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq1 = group q1 by all;\nq1 = foreach q1 generate sum(q1.'Revenue_Change_Amount__c') as 'B';\n\nq2 = cogroup q by all, q1 by all;\nq2 = foreach q2 generate sum(q.'A') - sum(q1.'B') as 'C';\n\nq4 = cogroup q3 by all, q2 by all;\nq4 = foreach q4 generate sum(q3.'D')/(sum(q3.'D') + sum(q2.'C')) as 'Y';\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["Y"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_6_7":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"OpportunityFull\";\nq = filter q by 'StageName' == \"Closed Lost\";\nq = filter q by 'Is_Retention__c' == \"true\";\nq = filter q by 'Renewal_Expected_ARR__c' > 0;\nq = filter q by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq = filter q by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq = group q by all;\nq = foreach q generate count() as 'G';\n\nq1 = load \"OpportunityFull\";\nq1 = filter q1 by (!('StageName' in [\"BDR Opp Rejected\", \"Closed Lost\", \"Closed Quote\"]) || 'StageName' is null);\nq1 = filter q1 by 'Is_Retention__c' == \"true\";\nq1 = filter q1 by 'Renewal_Expected_ARR__c' > 0;\nq1 = filter q1 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq1 = filter q1 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq1 = group q1 by all;\nq1 = foreach q1 generate count() as 'B';\n\n\nq2 = cogroup q by all, q1 by all;\nq2 = foreach q2 generate (sum(q1.'B')-sum(q.'G'))/sum(q1.'B') as 'Y';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":"