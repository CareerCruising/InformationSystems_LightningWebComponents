howActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Renewal_Expected_ARR_1":{"broadcastFacet":true,"datasets":[{"name":"OpportunityFull"}],"isGlobal":false,"label":"Starting ARR Renewal Expected","query":{"query":"{\"measures\":[[\"sum\",\"Renewal_Expected_ARR__c\"]],\"filters\":[[\"Is_Retention__c\",[\"true\"],\"in\"],[\"Renewal_Period__c\",[[[\"year\",0],[\"year\",0]]],\">=<=\"],[\"StageName\",[\"10N-BDR Qualified\",\"BDR Opp Rejected\",\"Closed Quote\"],\"not in\"],[\"Acc.Demo_Type__c\",[\"Client Demo\",\"Closed (Inactive)\",\"Test Account\"],\"not in\"]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["sum_Renewal_Expected_ARR__c"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_6_1":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"--Gross Renewal Revenue Rate (%)\n---------------------------------------------------------------------------------------------------------------------------------------------------------\n--Gross Renewal Won\t\nq = load \"OpportunityFull\"; -- Closed Won - All\nq = filter q by 'StageName' == \"Closed Won\" and date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"] and 'Is_Retention__c' == \"true\";\nq = filter q by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq = group q by all;\nq = foreach q generate sum(q.'Renewal_Adjusted_ARR__c') as 'A';\n\nq1 = load \"OpportunityFull\"; -- Closed won - Expansion\nq1 = filter q1 by 'StageName' == \"Closed Won\";\nq1 = filter q1 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nq1 = filter q1 by 'Revenue_Change_Type__c' in [\"Cross-sell\", \"Price Increase\", \"Product Upgrade\", \"Student Count Increase\"];\nq1 = filter q1 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nq1 = group q1 by all;\nq1 = foreach q1 generate sum(q1.'Revenue_Change_Amount__c') as 'B';\n\nq2 = cogroup q by all, q1 by all;\nq2 = foreach q2 generate sum(q.'A') - sum(q1.'B') as 'C'; -- Gross Renewal Won\t= \"Closed Won - All\" - \"Closed won - Expansion\"\n--------------------------------------------------------------------------------------------------------------------------------------------------------\n-- Gross Renewal Churned \nh = load \"OpportunityFull\"; -- All closed Lost\nh = filter h by 'Is_Retention__c' == \"true\" and 'Renewal_Expected_ARR__c' > 0 and 'StageName' == \"Closed Lost\" and date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nh = filter h by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nh = group h by all;\nh = foreach h generate sum('Renewal_Expected_ARR__c') as 'A';\n\nh1 = load \"OpportunityFull\"; -- Downsell in Closed Won\nh1 = filter h1 by date('Renewal_Period__c_Year', 'Renewal_Period__c_Month', 'Renewal_Period__c_Day') in [\"current year\"..\"current year\"];\nh1 = filter h1 by 'StageName' == \"Closed Won\";\nh1 = filter h1 by 'Revenue_Change_Type__c' == \"Downsell\";\nh1 = filter h1 by 'Is_Retention__c' == \"true\";\nh1 = filter h1 by (!('Acc.Demo_Type__c' in [\"Client Demo\", \"Closed (Inactive)\", \"Test Account\"]) || 'Acc.Demo_Type__c' is null);\nh1 = group h1 by all;\nh1 = foreach h1 generate sum('Revenue_Change_Amount__c') as 'B'; -- this is a negative number\n\nh2 = cogroup h by all, h1 by all;\nh2 = foreach h2 generate sum(h.'A') - sum(h1.'B') as 'C'; -- Gross Renewal Churned = \"All closed Lost\" + \"Downsell in Closed Won\" (since it is negative in formula we have \"-\")\n--------------------------------------------------------------------------------------------------------------------------------------------------------\n\nq4 = cogroup h2 by all, q2 by all;\nq4 = foreach q4 generate sum(q2.'C')/(sum(h2.'C') + sum(q2.'C')) as 'D'; --Gross Renewal Revenue Rate (%) = Gross Renewal Won / (Gross Renewal Won + Gross Renewal Churned)\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["D"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"RenewalGross_1":{"broadcastFacet":true,"datasets":[{"name":"OpportunityFull"}],"isGlobal":false,"label":"Renewal Churn Lost - Different Approach","query":{"query":"{\"measures\":[[\"sum\",\"Renewal_Expected_ARR__c\"],[\"count\",\"*\"]],\"filters\":[[\"StageName\",[\"Closed Lost\"],\"in\"],[\"Is_Retention__c\",[\"true\"],\"in\"],[\"Renewal_Expected_ARR__c\",[[0]],\">\"],[\"EndDate__c\",[[1672531200000,null]],\">=\"],[\"CloseDate\",[[[\"year\",-1],[\"year\",-1]]],\">=<=\"]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"sing