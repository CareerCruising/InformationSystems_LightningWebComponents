 by (!('Type' in [\"All Growth\", \"All Retention\", \"All Revenue\"]) || 'Type' is null);\nq2 = filter q2 by 'ForecastCategoryName' == \"Commit\";\nq2 = group q2 by 'Type';\nq2 = foreach q2 generate 'Type' as 'Type', sum('Amount') as 'Commit_Amount';\n\nq3 = load \"MetricOpenPipe\";\nq3 = filter q3 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq3 = filter q3 by (!('Type' in [\"All Growth\", \"All Retention\", \"All Revenue\"]) || 'Type' is null);\nq3 = filter q3 by 'ForecastCategoryName' == \"Best Case\";\nq3 = group q3 by 'Type';\nq3 = foreach q3 generate 'Type' as 'Type', sum('Amount') as 'Best_Amount';\n\nq4 = load \"MetricOpenPipe\";\nq4 = filter q4 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nq4 = filter q4 by (!('Type' in [\"All Growth\", \"All Retention\", \"All Revenue\"]) || 'Type' is null);\nq4 = filter q4 by 'ForecastCategoryName' == \"Pipeline\";\nq4 = group q4 by 'Type';\nq4 = foreach q4 generate 'Type' as 'Type', sum('Amount') as 'Pipe';\n\nq5 = union q, q1, q2, q3, q4;\nq5 = group q5 by 'Type';\nq5 = foreach q5 generate 'Type' as 'Type', sum('sum_Actual') as 'Actual', (sum('Commit_Amount')+sum('sum_Actual')) as 'Commit', (sum('Commit_Amount')+sum('sum_Actual')+ sum('Best_Amount')) as 'Best Case', sum('sum_Target') as 'Quota', (sum('Commit_Amount')+sum('sum_Actual')+ sum('Best_Amount') + sum('Pipe')) as 'Open Pipe';\nq5 = order q5 by 'Type' desc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","showValues":true,"bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customS