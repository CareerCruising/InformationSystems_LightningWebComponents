ortingPeriod_Month', sum('Actual') as 'Actual';\nq1 = fill q1 by (dateCols=('ReportingPeriod_Year', 'ReportingPeriod_Month', \"Y-M\"), startDate=\"2021-10\", endDate=\"2022-12\");\nq1 = foreach q1 generate 'ReportingPeriod_Year' + \"~~~\" + 'ReportingPeriod_Month' as 'ReportingPeriod_Year~~~ReportingPeriod_Month', coalesce(sum('Actual'),0) as 'sum_Actual';\n\nq2 = load \"MetricOpenPipe\";\nq2 = filter q2 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [dateRange([2021,10,1], [2022,12,30])];\nq2 = filter q2 by (!('Type' in [\"All Growth\", \"All Retention\", \"All Revenue\"]) || 'Type' is null);\nq2 = filter q2 by 'ForecastCategoryName' == \"Commit\";\nq2 = group q2 by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\nq2 = foreach q2 generate 'ReportingPeriod_Year'  as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('Amount') as 'Amount';\nq2 = fill q2 by (dateCols=('ReportingPeriod_Year', 'ReportingPeriod_Month', \"Y-M\"), startDate=\"2021-10\", endDate=\"2022-12\");\nq2 = foreach q2 generate 'ReportingPeriod_Year' + \"~~~\" + 'ReportingPeriod_Month' as 'ReportingPeriod_Year~~~ReportingPeriod_Month', coalesce(sum('Amount'),0) as 'Commit_Amount';\n\nq3 = load \"MetricOpenPipe\";\nq3 = filter q3 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [dateRange([2021,10,1], [2022,12,30])];\nq3 = filter q3 by (!('Type' in [\"All Growth\", \"All Retention\", \"All Revenue\"]) || 'Type' is null);\nq3 = filter q3 by 'ForecastCategoryName' == \"Best Case\";\nq3 = group q3 by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\nq3 = foreach q3 generate 'ReportingPeriod_Year'  as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('Amount') as 'Amount';\nq3 = fill q3 by (dateCols=('ReportingPeriod_Year', 'ReportingPeriod_Month', \"Y-M\"), startDate=\"2021-10\", endDate=\"2022-12\");\nq3 = foreach q3 generate 'ReportingPeriod_Year' + \"~~~\" + 'ReportingPeriod_Month' as 'ReportingPeriod_Year~~~ReportingPeriod_Month', coalesce(sum('Amount'),0) as 'Best_Amount';\n\nq4 = load \"MetricOpenPipe\";\nq4 = filter q4 by date('ReportingPeriod_Year', 'ReportingPeriod_Month', 'ReportingPeriod_Day') in [dateRange([2021,10,1], [2022,12,30])];\nq4 = filter q4 by (!('Type' in [\"All Growth\", \"All Retention\", \"All Revenue\"]) || 'Type' is null);\nq4 = filter q4 by 'ForecastCategoryName' == \"Pipeline\";\nq4 = group q4 by ('ReportingPeriod_Year', 'ReportingPeriod_Month');\nq4 = foreach q4 generate 'ReportingPeriod_Year'  as 'ReportingPeriod_Year', 'ReportingPeriod_Month' as 'ReportingPeriod_Month', sum('Amount') as 'Amount';\nq4 = fill q4 by (dateCols=('ReportingPeriod_Year', 'ReportingPeriod_Month', \"Y-M\"), startDate=\"2021-10\", endDate=\"2022-12\");\nq4 = foreach q4 generate 'ReportingPeriod_Year' + \"~~~\" + 'ReportingPeriod_Month' as 'ReportingPeriod_Year~~~ReportingPeriod_Month', coalesce(sum('Amount'),0) as 'Pipe';\n\nq5 = union q, q1, q2, q3, q4;\nq5 = group q5 by ('ReportingPeriod_Year~~~ReportingPeriod_Month');\nq5 = foreach q5 generate 'ReportingPeriod_Year~~~ReportingPeriod_Month' as 'ReportingPeriod_Year~~~ReportingPeriod_Month', sum('sum_Actual') as 'Actual', sum('Commit_Amount') as 'Commit', sum('Best_Amount') as 'Best Case', (sum('sum_Target')- sum('sum_Actual')) as 'Remaining Quota', (sum('sum_Target') - (sum('Commit_Amount')+sum('sum_Actual')+ sum('Best_Amount'))) as 'Gap2Quota';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":true,"showValues":true,"showPoints":true,"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""