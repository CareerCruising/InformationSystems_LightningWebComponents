alPadding":8},"type":"table"}},"lens_31_5":{"broadcastFacet":true,"groups":[],"label":"lens_31","numbers":[],"query":"q = load \"Oppties_by_Activity_May_18th_2023\";\nq = filter q by 'Campaign.Tactic__c_bucket' == \"Content\";\nq = foreach q generate q.'Opportunit.Name' as 'Opportunit.Name', q.'Campaign.Name' as 'Campaign.Name', q.'Opportunit.CloseDate' as 'Opportunit.CloseDate', q.'Opportunit.StageName' as 'Opportunit.StageName', q.'Id_formula' as 'Id_formula', q.'Opportunit.Amount' as 'Opportunit.Amount';\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"fixedColumnWidth":100,"header":{"backgroundColor":"#000000","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","mode":"fixed","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_8_10":{"broadcastFacet":true,"groups":[],"label":"lens_8","numbers":[],"query":"q = load \"Campaigns_Members_Activity\";\nq = group q by 'Campaign.Name';\nq = filter q by 'Campaign.Tactic__c_bucket' like \"%Website%\";\nq = foreach q generate 'Campaign.Name' as 'Campaign.Name', count(q) as 'Total Members', sum(q.'Transform2.IsMQLtoSAL') as '# MQL to SAL',sum(q.'Transform3.IsSALtoSQL') as '# SAL to SQL', sum(q.'Transform2.IsMQLtoSAL')/count(q) as 'Sales Accepted Rate',sum(q.'Transform3.IsSALtoSQL')/count(q) as 'Sales Qualified Rate';\n\n\n\n\n// Create the total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'Campaign.Name',\n    sum(q.'Total Members') as 'Total Members',\n    sum(q.'# MQL to SAL') as 'Total MQL to SAL',\n    sum(q.'# SAL to SQL') as 'Total SAL to SQL',\n    avg(q.'Sales Accepted Rate') as 'Sales Accepted Rate',\n     avg(q.'Sales Qualified Rate') as 'Sales Qualified Rate';\n// Put total at the top\nq = union totalRow, q;\n\n// Final projection\nq = foreach q generate 'Sales Accepted Rate'; \nq = limit q 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_5_23":{"broadcastFacet":true,"groups":[],"label":"lens_5","numbers":[],"query":"q1 = load \"All_MKTG_Campaigns\";\nq1 = filter q1 by 'Tactic__c_bucket' like \"%Content%\";\nq2 = load \"Campaigns_Members_Activity\";\nq2 = filter q2 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq3 = load \"Oppties_by_Activity_May_18th_2023\";\nq3 = filter q3 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq4 = load \"Closed_won_lost_opps\";\n\nq4 = filter q4 by 'Opportunit.StageName' == \"Closed Won\";\nq4 = filter q4 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\n\nq = cogroup q1 by 'Name' full, q2 by 'Campaign.Name' full, q3 by 'Campaign.Name' full, q4 by 'Campaign.Name';\nq = foreach q generate\n    coalesce(q1.'Name', q2.'Campaign.Name', q3.'Campaign.Name', q4.'Campaign.Name') as 'Campaign Name',\n    max(q1.'CreatedDate') as 'Campaign Created Date',\n    max(q1.'BudgetedCost') as 'Budgeted Cost CAD',\n    max(q1.'ActualCost') as 'Actual Cost CAD',\n    count(q2) as 'Member #',\n    max(q1.'ActualCost') / count(q2) as 'Cost Per Lead',\n    sum(q2.'Is_MKTG_Lead') as 'MKTG - Working #',\n    sum(q2.'Is_MQL_Lead') as 'MQL #',\n    sum(q2.'Is_SAL_Lead') as 'SAL #',\n    sum(q2.'Is_SQL_Lead') as 'SQL #',\n    count(q3) as 'Opportunity #',\n    count(q4) as 'Closed Won Opp #',\n    sum(q4.'Id_formula') as 'Revenue Share CAD',\n    ((sum(q4.'Id_formula') - max(q1.'ActualCost')) / max(q1.'ActualCost')) as 'ROI',\n    min(q1.'Aggregate0.COUNT_Rows') as 'Calls Made', sum(q3.'Id_formula') as 'Pipe Share CAD';\n\nq = order q by 'Campaign Created Date' desc;\n\n// Create the total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'Campaign Name',\n    null as 'Campaign Created Date',\n    null as 'Actual Cost CAD',\n    null as 'Budgeted Cost CAD',\n    null as 'Member #',\n    null as 'Cost Per Lead',\n    null as 'MKTG - Working #',\n    null as 'MQL #',\n    null as 'SAL #',\n    null as 'SQL #',\n    null as 'Opportunity #',\n    null as 'Closed Won Opp #',\n    sum('Revenue Share CAD') as 'Total Revenue Share CAD',\n    null as 'ROI',\n    null as 'Calls Made',\n    null as 'Total Pipe Share CAD';\n\n// Put total at the top\nq = union totalRow, q;\n\n// Final projection\nq = foreach q generate'Total Revenue Share CAD';\nq = limit q 1;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMod