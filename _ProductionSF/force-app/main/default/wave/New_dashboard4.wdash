alueType":"compactNumber","showTotal":true,"theme":"wave","stemSegments":0,"applyConditionalFormatting":true},"type":"chart"}},"lens_37_28":{"broadcastFacet":true,"groups":[],"label":"lens_37","numbers":[],"query":"q1 = load \"All_MKTG_Campaigns\";\nq1 = filter q1 by 'Tactic__c_bucket' like \"%Content%\";\nq2 = load \"Campaigns_Members_Activity\";\nq2 = filter q2 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq3 = load \"Oppties_by_Activity_May_18th_2023\";\nq3 = filter q3 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq4 = load \"Closed_won_lost_opps\";\n\nq4 = filter q4 by 'Opportunit.StageName' == \"Closed Won\";\nq4 = filter q4 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq = cogroup q1 by ('Quarter__c','Name') full,q2 by ('Campaign.Quarter__c','Campaign.Name') full, q3 by ('Campaign.Quarter__c','Campaign.Name') full, q4 by ('Campaign.Quarter__c','Campaign.Name');\nq = foreach q generate coalesce(q1.'Quarter__c',q2.'Campaign.Quarter__c',q3.'Campaign.Quarter__c',q4.'Campaign.Quarter__c') as 'Campaign Quarter',coalesce(q1.'Name',q2.'Campaign.Name',q3.'Campaign.Name',q4.'Campaign.Name') as 'Campaign Name',count(q3) as 'Opportunity #', count(q4) as 'Closed Won Opp #', ((sum(q4.'Id_formula')-max(q1.'ActualCost'))/max(q1.'ActualCost')) as 'ROI', min(q1.'Aggregate0.COUNT_Rows') as 'Calls Made';\nq = order q by 'Campaign Quarter' desc;\n\nq = foreach q generate 'Campaign Quarter','Campaign Name', 'Opportunity #', 'Closed Won Opp #','ROI';\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":true,"showValues":true,"showPoints":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":["Opportunity #","Closed Won Opp #","ROI"],"showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":true,"dimensions":["Campaign Name"]},"visualizationType":"combo","missingValue":"connect","showValuesOnLine":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"plots":{"Actual Cost CAD":{"mark":"bar"},"Calls Made":{"mark":"line"},"Closed Won Opp #":{"mark":"bar"},"Budgeted Cost CAD":{"mark":"bar"},"Opportunity #":{"mark":"bar"},"ROI":{"mark":"line"}},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":true,"showTitle":true,"showAxis":true,"title":"","customDomain":{"high":50,"showDomain":true}},"theme":"wave","applyConditionalFormatting":true,"dimensionAxis":{"showTitle":true,"customSize":40,"showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}}},"type":"chart"}},"lens_6_1":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"Campaigns_Members_Activity\";\nq = group q by 'Campaign.Name';\nq = filter q by 'Campaign.Tactic__c_bucket' like \"%Event%\";\nq = foreach q generate 'Campaign.Name' as 'Campaign.Name', count(q) as 'Total Members',sum(q.'Filter12.IsMktgWorkingtoMQL') as '# MKTG Working to MQL', sum(q.'Transform2.IsMQLtoSAL') as '# MQL to SAL',sum(q.'Transform3.IsSALtoSQL') as '# SAL to SQL',sum(q.'Filter12.IsMktgWorkingtoMQL')/count(q) as 'Nurture to MQL Rate', sum(q.'Transform2.IsMQLtoSAL')/count(q) as 'Sales Accepted Rate',sum(q.'Transform3.IsSALtoSQL')/count(q) as 'Sales Qualified Rate';\n\n\n\n\n// Create the total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'Campaign.Name',\n    sum(q.'Total Members') as 'Total Members',\n    sum(q.'# MKTG Working to MQL') as 'Total MKTG Working to MQL',\n    sum(q.'# MQL to SAL') as 'Total MQL to SAL',\n    sum(q.'# SAL to SQL') as 'Total SAL to SQL',\n    avg(q.'Nurture to MQL Rate') as 'Nurture to MQL Rate',\n    avg(q.'Sales Accepted Rate') as 'Sales Accepted Rate',\n     avg(q.'Sales Qualified Rate') as 'Sales Qualified Rate';\n// Put total at the top\nq = union totalRow, q;\n\n// Final projection\nq = foreach q generate 'Total Members','Total MKTG Working to MQL','Total MQL to SAL','Total SAL to SQL', 'Sales Accepted Rate', 'Sales Qualified Rate'; \nq = limit q 1;\n// Unpivot: convert columns into rows with consistent schema\nrow1 = foreach q generate \"Total Members\" as 'Stage', 'Total Members' as 'Value';\nrow2 = foreach q generate \"Total MKTG Working to MQL\" as 'Stage', 'Total MKTG Working to MQL' as 'Value';\nrow3 = foreach q generate \"Total MQL to SAL\" as 'Stage', 'Total MQL to SAL' as 'Value';\nrow4 = foreach q generate \"Total SAL to SQL\" as 'Stage', 'Total SAL to SQL' as 'Value';\n--row4 = foreach q generate \"Sales Accepted Rate\" as 'Stage', 'Sales Accepted Rate' as 'Value';\n--row5 = foreach q generate \"Sales Qualified Rate\" as 'Stage', 'Sales Qualified Rate' as 'Value';\n\n// Union into single funnel dataset\nfunnel = union row1, row2, row3,row4;--, row5;\nfunnel = limit funnel 10;\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":false,"tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"funnel","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"valueType":"compactNumber","showTotal":true,"theme":"wave","stemSegments":0,"applyConditionalFormatting":true},"type":"chart"}},"lens_37_29":{"broadcastFacet":true,"groups":[],"label":"lens_37","numbers":[],"query":"q = load \"Campaigns_Members_Activity\";\nq = filter q by 'Campaign.Tactic__c_bucket' == \"Content\";\n\n/* Group and count by Lead Status */\nq = group q by 'Lead_Status__c';\nq = foreach q generate q.'Lead_Status__c' as 'Lead_Status__c', count(q) as 'A';\n\n/* Create TOTAL row */\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate \n    \"TOTAL\" as 'Lead_Status__c',\n    sum(q.'A') as 'A';\n\n/* Combine grouped data with total */\nq = union q, totalRow;\n\n/* Filter only the statuses of interest */\nq = filter q by 'Lead_Status__c' in [\"Active\", \"Contact\", \"Converted - Sales\", \"MKTG - Working\", \"Open\", \"TOTAL\"];\n\n/* Assign reversed prefix-based labels to control stacked bar order */\nq = foreach q generate\n    case \n        when 'Lead_Status__c' == \"TOTAL\" then \"6.) TOTAL\"\n        when 'Lead_Status__c' == \"MKTG - Working\" then \"5.) MKTG - Working\"\n        when 'Lead_Status__c' == \"Open\" then \"4.) MQLs\"\n        when 'Lead_Status__c' == \"Active\" then \"3.) SALs\"\n        when 'Lead_Status__c' == \"Converted - Sales\" then \"2.) SQLs\"\n        when 'Lead_Status__c' == \"Contact\" then \"1.) Contacts\"\n        else 'Lead_Status__c'\n    end as 'Lead Status',\n    'A' as 'Count';\n\n/* No additional sort needed — CRM Analytics will use label alphabetically for stacking */\nq = limit q 2000;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","showValues":true,"legend":{"descOrder":true,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","totalSumMode":"none","tooltip":{"showBinLabel":true,"measures":["Count"],"showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":true,"dimensions":["Lead Status"]},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_37_31":{"broadcastFacet":true,"groups":[],"label":"lens_37","numbers":[],"query":"q1 = load \"All_MKTG_Campaigns\";\nq1 = filter q1 by 'Tactic__c_bucket' like \"%Content%\";\nq2 = load \"Campaigns_Members_Activity\";\nq2 = filter q2 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq3 = load \"Oppties_by_Activity_May_18th_2023\";\nq3 = filter q3 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq4 = load \"Closed_won_lost_opps\";\n\nq4 = filter q4 by 'Opportunit.StageName' == \"Closed Won\";\nq4 = filter q4 by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq = cogroup q1 by 'Name' full,q2 by 'Campaign.Name' full, q3 by 'Campaign.Name'full, q4 by 'Campaign.Name';\nq = foreach q generate coalesce(q1.'Name',q2.'Campaign.Name',q3.'Campaign.Name',q4.'Campaign.Name') as 'Campaign Name',max(q1.'CreatedDate') as 'Campaign Created Date' ,max(q1.'BudgetedCost') as 'Budgeted Cost CAD', max(q1.'ActualCost') as 'Actual Cost CAD', count(q2) as 'Member #',max(q1.'ActualCost')/count(q2) as 'Cost Per Lead',sum(q2.'Is_MKTG_Lead') as 'MKTG - Working #',sum(q2.'Is_MQL_Lead') as 'MQL #',sum(q2.'Is_SAL_Lead') a