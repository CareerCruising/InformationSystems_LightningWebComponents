"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"none","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"compactDecimalDigitsOnLine":-1,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":["Calls Made","Events Booked"],"showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":true,"dimensions":["Campaign Name"]},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"binValues":false,"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":true,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":true}},"theme":"wave","applyConditionalFormatting":true,"dimensionAxis":{"showTitle":true,"customSize":40,"showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}}},"type":"chart"}},"lens_6_10":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"Campaigns_Members_Activity\";\nq = group q by 'Campaign.Name';\nq = filter q by 'Campaign.Tactic__c_bucket' like \"%Content%\";\nq = foreach q generate 'Campaign.Name' as 'Campaign.Name', count(q) as 'Total Members',sum(q.'Filter12.IsMktgWorkingtoMQL') as '# MKTG Working to MQL', sum(q.'Transform2.IsMQLtoSAL') as '# MQL to SAL',sum(q.'Transform3.IsSALtoSQL') as '# SAL to SQL',sum(q.'Filter12.IsMktgWorkingtoMQL')/count(q) as 'Nurture to MQL Rate', sum(q.'Transform2.IsMQLtoSAL')/count(q) as 'Sales Accepted Rate',sum(q.'Transform3.IsSALtoSQL')/count(q) as 'Sales Qualified Rate';\n\n\n\n\n// Create the total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'Campaign.Name',\n    sum(q.'Total Members') as 'Total Members',\n    sum(q.'# MKTG Working to MQL') as 'Total MKTG Working to MQL',\n    sum(q.'# MQL to SAL') as 'Total MQL to SAL',\n    sum(q.'# SAL to SQL') as 'Total SAL to SQL',\n    avg(q.'Nurture to MQL Rate') as 'Nurture to MQL Rate',\n    avg(q.'Sales Accepted Rate') as 'Sales Accepted Rate',\n     avg(q.'Sales Qualified Rate') as 'Sales Qualified Rate';\n// Put total at the top\nq = union totalRow, q;\n\n// Final projection\nq = foreach q generate 'Total Members','Total MKTG Working to MQL','Total MQL to SAL','Total SAL to SQL', 'Sales Accepted Rate', 'Sales Qualified Rate'; \nq = limit q 1;\n// Unpivot: convert columns into rows with consistent schema\nrow1 = foreach q generate \"Total Members\" as 'Stage', 'Total Members' as 'Value';\nrow2 = foreach q generate \"Total MKTG Working to MQL\" as 'Stage', 'Total MKTG Working to MQL' as 'Value';\nrow3 = foreach q generate \"Total MQL to SAL\" as 'Stage', 'Total MQL to SAL' as 'Value';\nrow4 = foreach q generate \"Total SAL to SQL\" as 'Stage', 'Total SAL to SQL' as 'Value';\n--row4 = foreach q generate \"Sales Accepted Rate\" as 'Stage', 'Sales Accepted Rate' as 'Value';\n--row5 = foreach q generate \"Sales Qualified Rate\" as 'Stage', 'Sales Qualified Rate' as 'Value';\n\n// Union into single funnel dataset\nfunnel = union row1, row2, row3,row4;--, row5;\nfunnel = limit funnel 10;\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":false,"tooltip":{"showBinLa