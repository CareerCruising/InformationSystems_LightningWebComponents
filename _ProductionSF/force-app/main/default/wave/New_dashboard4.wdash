m(q2.'Is_MQL_Lead') as 'MQL #',\n    sum(q2.'Is_SAL_Lead') as 'SAL #',\n    sum(q2.'Is_SQL_Lead') as 'SQL #',\n    count(q3) as 'Opportunity #',\n    count(q4) as 'Closed Won Opp #',\n    sum(q4.'Id_formula') as 'Revenue Share CAD',\n    ((sum(q4.'Id_formula') - max(q1.'ActualCost')) / max(q1.'ActualCost')) as 'ROI',\n    min(q1.'Aggregate0.COUNT_Rows') as 'Calls Made', sum(q3.'Id_formula') as 'Pipe Share CAD';\n\n\nq = order q by 'Campaign Created Date' desc;\n\n// Create the total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'Campaign Name',\n    null as 'Campaign Created Date',\n    null as 'Actual Cost CAD',\n    null as 'Budgeted Cost CAD',\n    null as 'Member #',\n    sum('Cost Per Lead') as 'Total Cost Per Lead',\n    null as 'MKTG - Working #',\n    null as 'MQL #',\n    null as 'SAL #',\n    null as 'SQL #',\n    null as 'Opportunity #',\n    null as 'Closed Won Opp #',\n    null as 'Total Revenue Share CAD',\n    null as 'ROI',\n    null as 'Calls Made',\n    null as 'Total Pipe Share CAD';\n\n// Put total at the top\nq = union totalRow, q;\n\n// Final projection\nq = foreach q generate'Total Cost Per Lead';\nq = limit q 1;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binV