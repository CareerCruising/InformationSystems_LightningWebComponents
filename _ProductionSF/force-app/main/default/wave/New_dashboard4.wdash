lter q3 by 'Campaign.Tactic__c_bucket' like \"%Website%\";\nq4 = load \"Closed_won_lost_opps\";\n\nq4 = filter q4 by 'Opportunit.StageName' == \"Closed Won\";\nq4 = filter q4 by 'Campaign.Tactic__c_bucket' like \"%Website%\";\nq = cogroup q1 by ('Quarter__c','Name') full,q2 by ('Campaign.Quarter__c','Campaign.Name') full, q3 by ('Campaign.Quarter__c','Campaign.Name') full, q4 by ('Campaign.Quarter__c','Campaign.Name');\nq = foreach q generate coalesce(q1.'Quarter__c',q2.'Campaign.Quarter__c',q3.'Campaign.Quarter__c',q4.'Campaign.Quarter__c') as 'Campaign Quarter',coalesce(q1.'Name',q2.'Campaign.Name',q3.'Campaign.Name',q4.'Campaign.Name') as 'Campaign Name',count(q3) as 'Opportunity #', count(q4) as 'Closed Won Opp #', ((sum(q4.'Id_formula')-max(q1.'ActualCost'))/max(q1.'ActualCost')) as 'ROI', min(q1.'Aggregate0.COUNT_Rows') as 'Calls Made';\nq = order q by 'Campaign Quarter' desc;\n\nq = foreach q generate 'Campaign Quarter','Campaign Name', 'Opportunity #', 'Closed Won Opp #','ROI';\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":true,"showValues":true,"showPoints":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":["Opportunity #","Closed Won Opp #","Calls Made"],"showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":true,"dimensions":["Campaign Name"]},"visualizationType":"combo","missingValue":"connect","showValuesOnLine":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"plots":{"Actual Cost CAD":{"mark":"bar"},"Calls Made":{"mark":"line"},"Closed Won Opp #":{"mark":"bar"},"Budgeted Cost CAD":{"mark":"bar"},"Opportunity #":{"mark":"bar"},"ROI":{"mark":"line"}},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":true,"showTitle":true,"showAxis":true,"title":"","customDomain":{"high":50,"showDomain":true}},"theme":"wave","applyConditionalFormatting":true,"dimensionAxis":{"showTitle":true,"customSize":40,"showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}}},"type":"chart"}},"lens_37_23":{"broadcastFacet":true,"groups":[],"label":"lens_37","numbers":[],"query":"q = load \"Campaigns_Members_Activity\";\nq = filter q by 'Campaign.Tactic__c_bucket' == \"Website\";\n\n/* Group and count by Lead Status */\nq = group q by 'Lead_Status__c';\nq = foreach q generate q.'Lead_Status__c' as 'Lead_Status__c', count(q) as 'A';\n\n/* Create TOTAL row */\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate \n    \"TOTAL\" as 'Lead_Status__c',\n    sum(q.'A') as 'A';\n\n/* Combine grouped data with total */\nq = union q, totalRow;\n\n/* Filter only the statuses of interest */\nq = filter q by 'Lead_Status__c' in [\"Active\", \"Contact\", \"Converted - Sales\", \"MKTG - Working\", \"Open\", \"TOTAL\"];\n\n/* Assign reversed prefix-based labels to control stacked bar order */\nq = foreach q generate\n    case \n        when 'Lead_Status__c' == \"TOTAL\" then \"6.) TOTAL\"\n        when 'Lead_Status__c' == \"MKTG - Working\" then \"5.) MKTG - Working\"\n        when 'Lead_Status__c' == \"Open\" then \"4.) MQLs\"\n        when 'Lead_Status__c' == \"Active\" then \"3.) SALs\"\n        when 'Lead_Status__c' == \"Converted - Sales\" then \"2.) SQLs\"\n        when 'Lead_Status__c' == \"Contact\" then \"1.) Contacts\"\n        else 'Lead_Status__c'\n    end as 'Lead Status',\n    'A' as 'Count';\n\n/* No additional sort needed — CRM Analytics will use label alphabetically for stacking */\nq = limit q 2000;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","showValues":true,"legend":{"descOrder":true,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","totalSumMode":"none","tooltip":{"showBinLabel":true,"measures":["Count"],"showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":true,"dimensions":["Lead Status"]},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_37_20":{"broadcastFacet":true,"groups":[],"label":"lens_37","numbers":[],"query":"q1 = load \"All_MKTG_Campaigns\";\nq1 = filter q1 by 'Tactic__c_bucket' like \"%Website%\";\nq2 = load \"Campaigns_Members_Activity\";\nq2 = filter q2 by 'Campaign.Tactic__c_bucket' like \"%Website%\";\nq3 = load \"Oppties_by_Activity_May_18th_2023\";\nq3 = filter q3 by 'Campaign.Tactic__c_bucket' like \"%Website%\";\nq4 = load \"Closed_won_lost_opps\";\nq4 = filter q4 by 'Campaign.Tactic__c_bucket' like \"%Website%\";\nq4 = filter q4 by 'Opportunit.StageName' == \"Closed Won\";\nq = cogroup q1 by ('Quarter__c','Name') full,q2 by ('Campaign.Quarter__c','Campaign.Name') full, q3 by ('Campaign.Quarter__c','Campaign.Name') full, q4 by ('Campaign.Quarter__c','Campaign.Name');\nq = foreach q generate coalesce(q1.'Quarter__c',q2.'Campaign.Quarter__c',q3.'Campaign.Quarter__c',q4.'Campaign.Quarter__c') as 'Campaign Quarter',coalesce(q1.'Name',q2.'Campaign.Name',q3.'Campaign.Name',q4.'Campaign.Name') as 'Campaign Name',max(q1.'CreatedDate') as 'Campaign Created Date' ,max(q1.'BudgetedCost') as 'Budgeted Cost CAD', max(q1.'ActualCost') as 'Actual Cost CAD', count(q2) as 'Member #',sum(q2.'Is_MKTG_Lead') as 'MKTG - Working #',sum(q2.'Is_MQL_Lead') as 'MQL #',sum(q2.'Is_SAL_Lead') as 'SAL #',sum(q2.'Is_SQL_Lead') as 'SQL #',count(q3) as 'Opportunity #', count(q4) as 'Closed Won Opp #', sum(q4.'Id_formula') as 'Revenue Share CAD' , ((sum(q4.'Id_formula')-max(q1.'ActualCost'))/max(q1.'ActualCost')) as 'ROI', min(q1.'Aggregate0.COUNT_Rows') as 'Calls Made', max(q1.'Tactic__c') as 'Tactic';\nq = order q by 'Campaign Quarter' desc;\n\nq = foreach q generate 'Campaign Quarter','Campaign Name', 'Budgeted Cost CAD', 'Actual Cost CAD', 'Revenue Share CAD';\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":true,"showValues":true,"showPoints":true,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":["Budgeted Cost CAD","Actual Cost CAD"],"showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":true,"dimensions":["Campaign Name"]},"visualizationType":"combo","missingValue":"connect","showValuesOnLine":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"plots":{"Actual Cost CAD":{"mark