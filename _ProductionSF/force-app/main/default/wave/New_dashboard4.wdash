'Stage', 'Total MQL to SAL' as 'Value';\nrow4 = foreach q generate \"Total SAL to SQL\" as 'Stage', 'Total SAL to SQL' as 'Value';\n--row4 = foreach q generate \"Sales Accepted Rate\" as 'Stage', 'Sales Accepted Rate' as 'Value';\n--row5 = foreach q generate \"Sales Qualified Rate\" as 'Stage', 'Sales Qualified Rate' as 'Value';\n// Union into single funnel dataset\nfunnel = union row1, row2, row3,row4;-- row5;\nfunnel = limit funnel 10;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":false,"tooltip":{"showBinLabel":true,"measures":"","showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":false,"dimensions":""},"visualizationType":"funnel","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"valueType":"compactNumber","showTotal":true,"theme":"wave","stemSegments":0,"applyConditionalFormatting":true},"type":"chart"}},"lens_6_4":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"Big_Ticket_Campaign_Members\"; \n\n// Group by Campaign Parent Name and Campaign Name\nq = group q by 'Campaign.CampaignParent.Name'; \n\n// Filter campaigns by name\nq = filter q by 'Campaign.CampaignParent.Name' like \"%Ops%\";\n\n// Generate metrics\nq = foreach q generate \n    'Campaign.CampaignParent.Name' as 'Campaign.CampaignParent.Name',\n\n    count(q) as 'Total Members',\n    sum(q.'Filter12.IsMktgWorkingtoMQL') as '# MKTG Working to MQL', \n    sum(q.'Filter9.IsMQLtoSAL') as '# MQL to SAL',\n    sum(q.'Filter10.IsSALtoSQL') as '# SAL to SQL',\n    sum(q.'Filter12.IsMktgWorkingtoMQL')/count(q) as 'Nurture to MQL Rate',\n    sum(q.'Filter9.IsMQLtoSAL')/count(q) as 'Sales Accepted Rate',\n    sum(q.'Filter10.IsSALtoSQL')/count(q) as 'Sales Qualified Rate';\n\n// Create total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'Campaign.CampaignParent.Name',\n    \n    sum(q.'Total Members') as 'Total Members',\n    sum(q.'# MKTG Working to MQL') as '# MKTG Working to MQL',\n    sum(q.'# MQL to SAL') as '# MQL to SAL',\n    sum(q.'# SAL to SQL') as '# SAL to SQL',\n    avg(q.'Nurture to MQL Rate') as 'Nurture to MQL Rate',\n    avg(q.'Sales Accepted Rate') as 'Sales Accepted Rate',\n    avg(q.'Sales Qualified Rate') as 'Sales Qualified Rate';\n\n// Combine total with the rest\nq = union totalRow, q;\n\n// Final projection including parent grouping\nq = foreach q generate \n    'Campaign.CampaignParent.Name', \n\n    'Total Members',\n    '# MKTG Working to MQL',\n    '# MQL to SAL',\n    '# SAL to SQL',\n    'Nurture to MQL Rate', \n    'Sales Accepted Rate', \n    'Sales Qualified Rate'; \n\nq = limit q 2000;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#54698d","borderWidth":1,"cell":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#000000","fontColor":"#ffffff","fontSize":12},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#54698d","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_6_7":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"Campaigns_Members_Activity\";\nq = group q by 'Campaign.Name';\nq = filter q by 'Campaign.Tactic__c_bucket' like \"%Online%\";\nq = foreach q generate 