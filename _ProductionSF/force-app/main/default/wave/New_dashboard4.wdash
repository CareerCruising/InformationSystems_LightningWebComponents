mpaign.Name') as 'Campaign Name',max(q1.'CreatedDate') as 'Campaign Created Date' ,max(q1.'BudgetedCost') as 'Budgeted Cost CAD', max(q1.'ActualCost') as 'Actual Cost CAD', count(q2) as 'Member #', max(q1.'ActualCost')/count(q2) as 'Cost Per Lead',sum(q2.'Is_MKTG_Lead') as 'MKTG - Working #',sum(q2.'Is_MQL_Lead') as 'MQL #',sum(q2.'Is_SAL_Lead') as 'SAL #',sum(q2.'Is_SQL_Lead') as 'SQL #',count(q3) as 'Opportunity #', count(q4) as 'Closed Won Opp #', sum(q4.'Id_formula') as 'Revenue Share CAD' , ((sum(q4.'Id_formula')-max(q1.'ActualCost'))/max(q1.'ActualCost')) as 'ROI', min(q1.'Aggregate0.COUNT_Rows') as 'Calls Made', max(q1.'Tactic__c') as 'Tactic';\nq = order q by 'Cost Per Lead' desc;\nq = filter q by 'Campaign Name' like \"%Conferences%\";\nq = foreach q generate 'Campaign Quarter','Campaign Name', 'Cost Per Lead';\nq = filter q by 'Cost Per Lead' is not null;\n\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"compactDecimalDigitsOnLine":-1,"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"showBinLabel":true,"measures":["Cost Per Lead"],"showNullValues":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"customizeTooltip":true,"dimensions":["Campaign Name"]},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"binValues":false,"columnMap":{"trellis":[],"dimensionAxis":["Campaign Quarter","Campaign Name"],"plots":["Cost Per Lead"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":true,"showTitle":true,"showAxis":true,"title":"","customDomain":{"high":10000,"showDomain":true}},"theme":"wave","applyConditionalFormatting":true,"dimensionAxis":{"showTitle":true,"customSize":30,"showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}}},"type":"chart"}},"lens_6_3":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"Big_Ticket_Campaign_Members\";\nq = group q by 'Campaign.Name';\nq = filter q by 'Campaign.Name' like \"%Ops%\";\nq = foreach q generate 'Campaign.Name' as 'Campaign.Name', count(q) as 'Total Members',sum(q.'Filter12.IsMktgWorkingtoMQL') as '# MKTG Working to MQL', sum(q.'Filter9.IsMQLtoSAL') as '# MQL to SAL',sum(q.'Filter10.IsSALtoSQL') as '# SAL to SQL',sum(q.'Filter12.IsMktgWorkingtoMQL')/count(q) as 'Nurture to MQL Rate',sum(q.'Filter9.IsMQLtoSAL')/count(q) as 'Sales Accepted Rate',sum(q.'Filter10.IsSALtoSQL')/count(q) as 'Sales Qualified Rate';\n\n// Create the total row\ntotalRow = group q by all;\ntotalRow = foreach totalRow generate\n    \"Total\" as 'Campaign.Name',\n    sum(q.'Total Members') as 'Total Members',\n    sum(q.'# MKTG Working to MQL') as '# MKTG Working to MQL',\n    sum(q.'# MQL to SAL') as '# MQL to SAL',\n    sum(q.'# SAL to SQL') as '# SAL to SQL',\n    avg(q.'Nurture to MQL Rate') as 'Nurture to MQL Rate',\n    avg(q.'Sales Accepted Rate') as 'Sales Accepted Rate',\n     avg(q.'Sales Qualified Rate') as 'Sales Qualified Rate';\n// Put total at the top\nq = union totalRow, q;\n\n// Final projection\nq = foreach q generate'Campaign.Name', 'Total Members','# MKTG Working to MQL','# MQL to SAL','# SAL to SQL','Nurture to MQL Rate', 'Sales Accepted Rate', 'Sales Qualified Rate'; \nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":