Flag',\n  sum(q2.'Stats.StudentCount') as 'Eligible students',\n  sum(q2.'Stats.CpIncompleteYTD') as 'CP incomplete',\n  sum(q2.'Stats.CpCompleteYTD') as 'CP Complete',\n  sum(q2.'Stats.CpSubmittedYTD') as 'CP Submitted',\n  sum(q2.'Stats.CpApprovedYTD') as 'CP Approved';\nq = filter q by 'Matched Account Id' is not null;\nq = foreach q generate\n  'Account Name' as 'Account Name',\n  'Account Owner' as 'Account Owner',\n  'State' as 'State',\n  'CP Flag' as 'CP Flag',\n  'Eligible students' as 'Eligible students',\n  'CP incomplete' as 'CP incomplete',\n  'CP Complete' as 'CP Complete',\n  'CP Submitted' as 'CP Submitted',\n  'CP Approved' as 'CP Approved';\nq = order q by ('Eligible students' desc, 'Account Name' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#747474","borderEdges":[],"borderRadius":0,"borderWidth":1},"widgets":{"table_1":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{"CP incomplete":{"parameters":{"alignment":"right"},"type":"text"},"Account Name":{"parameters":{"alignment":"left"},"type":"text"},"Eligible students":{"parameters":{"alignment":"right"},"type":"text"},"CP Approved":{"parameters":{"alignment":"right"},"type":"text"},"State":{"parameters":{"alignment":"left"},"type":"text"},"CP Flag":{"parameters":{"alignment":"left"},"type":"text"},"CP Submitted":{"parameters":{"alignment":"right"},"type":"text"},"Account Owner":{"parameters":{"alignment":"left"},"type":"text"},"CP Complete":{"parameters":{"alignment":"right"},"type":"text"}},"columns":["Account Name","Account Owner","State","CP Flag","Eligible students","CP incomplete","CP Complete","CP Submitted","CP Approved"],"customBulkActions":[],"exploreLink":true,"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"inner