SitesLicensed_ly') as 'SitesLicensed_ly'\n\t,sum(q.'SitesLicensed') - sum(q.'SitesLicensed_ly') as 'SitesLicensed_chg'\n\t\n\t,sum(q.'SitesWithUsage') as 'SitesWithUsage'\n\t,sum(q.'SitesWithUsage_ly') as 'SitesWithUsage_ly'\n\t,sum(q.'SitesWithUsage') - sum(q.'SitesWithUsage_ly') as 'SitesWithUsage_chg'\t\n\t\n\t,sum(q.'SitesWithUsage') / sum(q.'SitesLicensed') as 'SitesWithUsagePercent'\n\t,sum(q.'SitesWithUsage_ly') / sum(q.'SitesLicensed_ly') as 'SitesWithUsagePercent_ly'\n\t,(sum(q.'SitesWithUsage') / sum(q.'SitesLicensed')) - (sum(q.'SitesWithUsage_ly') / sum(q.'SitesLicensed_ly')) as 'SitesWithUsagePercent_chg'\n\t\n\t,sum(q.'StudentCount') as 'StudentCount'\n\t,sum(q.'StudentCount_ly') as 'StudentCount_ly'\n\t,sum(q.'StudentCount') - sum(q.'StudentCount_ly') as 'StudentCount_chg'\t\n\t\n\t,sum(q.'StudentLoginsUniqueYTD') as 'StudentLoginsUniqueYTD'\n\t,sum(q.'StudentLoginsUniqueYTD_ly') as 'StudentLoginsUniqueYTD_ly'\n\t,sum(q.'StudentLoginsUniqueYTD') - sum(q.'StudentLoginsUniqueYTD_ly') as 'StudentLoginsUniqueYTD_chg'\t\n\t\n\t,sum(q.'StudentLoginsUniqueYTD') / sum(q.'StudentCount') as 'StudentLoginsPercent'\n\t,sum(q.'StudentLoginsUniqueYTD_ly') / sum(q.'StudentCount_ly') as 'StudentLoginsPercent_ly'\n\t,(sum(q.'StudentLoginsUniqueYTD') / sum(q.'StudentCount')) - (sum(q.'StudentLoginsUniqueYTD_ly') / sum(q.'StudentCount_ly')) as 'StudentLoginsPercent_chg'\n\t\n\t,sum(q.'StudentLoginsYTD') as 'StudentLoginsYTD'\n\t,sum(q.'StudentLoginsYTD_ly') as 'StudentLoginsYTD_ly'\n\t,sum(q.'StudentLoginsYTD') - sum(q.'StudentLoginsYTD_ly') as 'StudentLoginsYTD_chg'\t\n\t\n\t,sum(q.'StudentLoginsYTD') / sum(q.'StudentLoginsUniqueYTD') as 'LoginsPerStudent'\n\t,sum(q.'StudentLoginsYTD_ly') / sum(q.'StudentLoginsUniqueYTD_ly') as 'LoginsPerStudent_ly'\n\t,(sum(q.'StudentLoginsYTD') / sum(q.'StudentLoginsUniqueYTD')) - (sum(q.'StudentLoginsYTD_ly') / sum(q.'StudentLoginsUniqueYTD_ly')) as 'LoginsPerStudent_chg'\t\n\t\n\t,avg(q.'StudentAverageSessionLengthYTD')/60 as 'StudentAverageSessionLengthYTD'\n\t,avg(q.'StudentAverageSessionLengthYTD_ly')/60 as 'StudentAverageSessionLengthYTD_ly'\n\t,(avg(q.'StudentAverageSessionLengthYTD') - avg(q.'StudentAverageSessionLengthYTD_ly'))/60 as 'StudentAverageSessionLengthYTD_chg'\t\n\t\n\t,(avg(q.'StudentAverageSessionLengthYTD')/60) * (sum(q.'StudentLoginsYTD') / sum(q.'StudentLoginsUniqueYTD')) as 'StudentAverageTimeOnline'\n\t,(avg(q.'StudentAverageSessionLengthYTD_ly')/60) * (sum(q.'StudentLoginsYTD_ly') / sum(q.'StudentLoginsUniqueYTD_ly')) as 'StudentAverageTimeOnline_ly'\n\t,((avg(q.'StudentAverageSessionLengthYTD')/60) * (sum(q.'StudentLoginsYTD') / sum(q.'StudentLoginsUniqueYTD'))) - ((avg(q.'StudentAverageSessionLengthYTD_ly')/60) * (sum(q.'StudentLoginsYTD_ly') / sum(q.'StudentLoginsUniqueYTD_ly'))) as 'StudentAverageTimeOnline_chg'\t\n\t\n\t,sum(q.'EducatorLoginsUniqueYTD') as 'EducatorLoginsUniqueYTD'\n\t,sum(q.'EducatorLoginsUniqueYTD_ly') as 'EducatorLoginsUniqueYTD_ly'\n\t,sum(q.'EducatorLoginsUniqueYTD') - sum(q.'EducatorLoginsUniqueYTD_ly') as 'EducatorLoginsUniqueYTD_chg'\t\n\t\n\t,sum(q.'StudentCount') / sum(q.'EducatorLoginsUniqueYTD') as 'StudentsPerEducator'\n\t,sum(q.'StudentCount') / sum(q.'EducatorLoginsUniqueYTD_ly') as 'StudentsPerEducator_ly'\n\t,(sum(q.'StudentCount') / sum(q.'EducatorLoginsUniqueYTD')) - (sum(q.'StudentCount') / sum(q.'EducatorLoginsUniqueYTD_ly')) as 'StudentsPerEducator_chg'\n\t\n\t,sum(q.'EducatorLoginsYTD') as 'EducatorLoginsYTD'\n\t,sum(q.'EducatorLoginsYTD_ly') as 'EducatorLoginsYTD_ly'\n\t,sum(q.'EducatorLoginsYTD') - sum(q.'EducatorLoginsYTD_ly') as 'EducatorLoginsYTD_chg'\t\n\n\t,sum(q.'EducatorLoginsYTD') / sum(q.'EducatorLoginsUniqueYTD') as 'LoginsPerEducator'\n\t,sum(q.'EducatorLoginsYTD_ly') / sum(q.'EducatorLoginsUniqueYTD_ly') as 'LoginsPerEducator_ly'\n\t,(sum(q.'EducatorLoginsYTD') / sum(q.'EducatorLoginsUniqueYTD')) - (sum(q.'EducatorLoginsYTD_ly') / sum(q.'EducatorLoginsUniqueYTD_ly')) as 'LoginsPerEducator_chg'\n\t\n\t,avg(q.'EducatorAverageSessionLengthYTD')/60 as 'EducatorAverageSessionLengthYTD'\n\t,avg(q.'EducatorAverageSessionLengthYTD_ly')/60 as 'EducatorAverageSessionLengthYTD_ly'\n\t,(avg(q.'EducatorAverageSessionLengthYTD') - avg(q.'EducatorAverageSessionLengthYTD_ly'))/60 as 'EducatorAverageSessionLengthYTD_chg'\t\t\n\t\n\t,(avg(q.'EducatorAverageSessionLengthYTD')/60) * (sum(q.'EducatorLoginsYTD') / sum(q.'EducatorLoginsUniqueYTD')) as 'EducatorAverageTimeOnline'\n\t,(avg(q.'EducatorAverageSessionLengthYTD_ly')/60) * (sum(q.'EducatorLoginsYTD_ly') / sum(q.'EducatorLoginsUniqueYTD_ly')) as 'EducatorAverageTimeOnline_ly'\n\t,((avg(q.'EducatorAverageSessionLengthYTD')/60) * (sum(q.'EducatorLoginsYTD') / sum(q.'EducatorLoginsUniqueYTD'))) - ((avg(q.'EducatorAverageSessionLengthYTD_ly')/60) * (sum(q.'EducatorLoginsYTD_ly') / sum(q.'EducatorLoginsUniqueYTD_ly'))) as 'EducatorAverageTimeOnline_chg'\n\t\n\t;\nresult = limit result 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"qryBillingStatePicklist":{"broadcastFacet":true,"datasets":[{"name":"StatsMonthlyYOY"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"BillingState\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{}},"qryStaticThisYear_1":{"broadcastFacet":true,"columns":{"Display":{"type":"string"}},"label":"qryStaticT